// CIE 1931 2-degree standard colorimetric observer color matching functions.
//
// Tabulated at 5 nm from 380 nm to 780 nm (81 samples), CIE 15 reference
// values, evaluated with linear interpolation between table nodes.
//
// This replaces the previous multi-Gaussian analytic fit (Wyman/Sloan/Shirley
// style). The fit had up to several-percent CMF amplitude error, which shifted
// blackbody chromaticities; the table is the standard itself, so spectral to
// XYZ conversion error is now dominated by the caller's wavelength sampling.
//
// Photometric note: luminance in cd/m^2 equals 683.002 lm/W times the Y
// integral when the input spectral radiance is in SI units
// (W * m^-2 * sr^-1 * m^-1 over wavelength in meters).

#ifndef BH_CIE_CMF_METALH
#define BH_CIE_CMF_METALH

constant float BH_CIE1931_KM_LM_PER_W = 683.002;

constant float3 BH_CIE1931_CMF_5NM[81] = {
    float3(0.001368, 0.000039, 0.006450), // 380 nm
    float3(0.002236, 0.000064, 0.010550), // 385 nm
    float3(0.004243, 0.000120, 0.020050), // 390 nm
    float3(0.007650, 0.000217, 0.036210), // 395 nm
