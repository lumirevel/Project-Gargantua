
// (comp_precision_returning_radiation_factor removed: returning radiation is
// now computed first-principles on the CPU from Kerr null geodesics and enters
// the disk temperature at the trace choke point — see
// disk_returning_rad_enhancement in disk_models.metal and
// ReturningRadiation.swift. An interpreter-side RGB multiplier would now be
// double counting, and it was exactly the kind of physics-in-the-interpreter
// the physics contract forbids.)

static inline float3 comp_apply_precision_cloud_to_rgb(float3 rgb,
                                                       const CollisionInfo rec,
                                                       constant Params& P,
                                                       constant ComposeParams& C,
                                                       float cloudRaw)
{
    float coverage = clamp(P.diskCloudCoverage, 0.0, 1.0);
    float tau0 = max(P.diskCloudOpticalDepth, 0.0);
    float porosity = clamp(P.diskCloudPorosity, 0.0, 1.0);
    float shadowStrength = clamp(P.diskCloudShadowStrength, 0.0, 1.0);
    float albedo = clamp(P.diskScatteringAlbedo, 0.0, 1.0);
    if (!(coverage > 1e-6) || (!(tau0 > 1e-6) && !(porosity > 1e-6) && !(shadowStrength > 1e-6))) {
        return rgb;
    }

    float cloudNorm = comp_cloud_norm_from_raw(clamp(cloudRaw, 0.0, 1.0), C);
    float c = clamp((cloudNorm - 0.18) / 0.82, 0.0, 1.0);
    float baseClump = smoothstep(max(0.0, 1.0 - coverage), 1.0, c);

    float3 d = rec.direct_world.xyz;
    float dNorm = max(length(d), 1e-30);
    float3 rayDir = d / dNorm;
    float mu = abs(rayDir.z);

    float rEmit = max(rec.v_disk.y, P.rs * 1.0001);
    float halfH = disk_half_thickness_m(rEmit, P);
    float span = max(P.re - P.rs, 1e-6);
    float u = clamp((rEmit - P.rs) / span, 0.0, 1.0);
    float innerBoost = 1.0 + 0.36 * (1.0 - smoothstep(0.06, 0.42, u));

    // Use physical LOS distance through local disk volume (meters).
    float pathMeters = (1.6 * halfH) / max(mu, 0.085);
    pathMeters = clamp(pathMeters, 0.15 * P.rs, 3.5 * P.rs);
    float pathRs = pathMeters / max(P.rs, 1e-6);

    uint nSteps = clamp(P.diskRTSteps, 0u, 32u);
    if (nSteps == 0u) {
        float suggested = 6.0 + 1.0 * tau0 * innerBoost + 4.5 * pathRs;
        nSteps = uint(clamp(suggested, 6.0, 24.0));
    }
    nSteps = max(nSteps, 4u);

    float ds = pathMeters / float(nSteps);
    float alphaBase = (tau0 * innerBoost) / max(pathMeters, 1e-9);
    float phaseScatter = 0.5 * (1.0 + mu * mu); // Thomson-like angular term
    float3 I = rgb;
    float trans = 1.0;
    const float3 scatterTint = float3(1.08, 1.0, 0.93);
    float rInner = disk_inner_radius_m(P);
    float tRef = max(rec.T, 1.0);

    float r0 = max(rec.emit_r_norm * P.rs, P.rs * 1.0001);
    float phi0 = rec.emit_phi;
    float z0 = rec.emit_z_norm * P.rs;
    float3 emitPos = float3(r0 * cos(phi0), r0 * sin(phi0), z0);

    for (uint i = 0u; i < 32u; ++i) {
        if (i >= nSteps) break;
        float s = (float(i) + 0.5) / float(nSteps);
        float signedOffset = (s - 0.5) * pathMeters;
        float3 samplePos = emitPos + rayDir * signedOffset;
        if (!inside_disk_volume(samplePos, P)) continue;

        float sampleR = length(samplePos.xy);
        float samplePhi = atan2(samplePos.y, samplePos.x);
        float sampleZ = samplePos.z;
        float ctLocal = rec.ct + signedOffset;

        float localCloud = disk_cloud_noise(sampleR, samplePhi, sampleZ, ctLocal, P);
        if (P.diskNoiseModel == 1u) {
            float perlin = disk_perlin_texture_noise(sampleR, samplePhi, sampleZ, P);
            localCloud = 0.55 * localCloud + 0.45 * clamp(0.5 + 0.5 * perlin, 0.0, 1.0);
        }
        float phase = 2.0 * s - 1.0;
        float jitter = comp_hash13(float3(21.0 * sampleR / max(P.rs, 1e-6) + 13.0 * phase,
                                          9.0 * samplePhi - 7.0 * phase,
                                          15.0 * sampleZ / max(P.rs, 1e-6) + 3.0 * localCloud));
        localCloud = clamp(0.84 * localCloud + 0.16 * jitter, 0.0, 1.0);
        localCloud = pow(localCloud, 1.22);

        float localClump = smoothstep(max(0.0, 1.0 - coverage), 1.0, localCloud);
        float holeField = comp_hash13(float3(19.1 * sampleR / max(P.rs, 1e-6) + 11.0 * phase,
                                             23.0 * samplePhi - 7.0 * phase,
                                             17.0 * sampleZ / max(P.rs, 1e-6) + 13.0 * localCloud));
        float holeThreshold = porosity * mix(0.76, 0.48, localClump);
        float occupied = smoothstep(holeThreshold - 0.07, holeThreshold + 0.07, holeField);
        float fill = clamp(localClump * occupied, 0.0, 1.0);
        fill = mix(fill, localClump, 0.48);

        float density = mix(0.28, 1.02, fill);
        float dTau = min(alphaBase * density * ds, 3.5);
        float stepTrans = exp(-dTau);
        float absorbed = 1.0 - stepTrans;

        float tStep = disk_effective_temperature(sampleR, rInner, P);
        tStep *= disk_precision_texture_factor(sampleR, samplePhi, sampleZ, P);
        float tRatio = pow(clamp(tStep / tRef, 0.04, 12.0), 4.0);

        float3 thermalSrc = rgb * tRatio * (0.10 + 0.90 * fill);
        float scatterAmp = (0.10 + 0.90 * phaseScatter) * (0.20 + 0.80 * fill);
        float lumI = dot(I, float3(0.2126, 0.7152, 0.0722));
        float3 scatterSrc = scatterTint * lumI * scatterAmp;
        float3 source = mix(thermalSrc, scatterSrc, albedo);

        I = I * stepTrans + source * absorbed;
        trans *= stepTrans;
    }

    float attenuation = mix(1.0, trans, shadowStrength);
    float porosityLift = mix(1.0, 1.0 + 0.35 * porosity * (1.0 - baseClump), 0.65);
    float floor = 0.04 + 0.24 * porosity;
    float3 out = I * attenuation * porosityLift;
    return max(out, rgb * floor);
}

struct ThinHybridRealismConfig {
    float perturbAmp;
    float atmosphereTau;
    float coronaStrength;
    float beamingStrength;
    float innerBoost;
    float outerFadeStart;
    float outerFadeEnd;
    float legacyPeriodicThin;
    float3 atmosphereTint;
    float3 coronaTint;
};

struct ThinHybridRealismSample {
    float rNorm;
    float phi;
    float g;
    float emissivity;
    float perturb;
    float density;
    float beaming;
    float opticalDepth;
    float observedTemp;
    float radialTau;
    float innerWeight;
    float outerFade;
    float3 photosphere;
    float3 atmosphere;
    float3 corona;
    float3 finalRgb;
};

struct ThinDiskStructureSample {
    float perturb;
    float density;
    float tempShift;
    float opacity;
    float filament;
    float radialTau;
};

static inline bool comp_thin_physical_active(constant ComposeParams& C) {
    return (FC_PHYSICS_MODE == 0u && FC_VISIBLE_MODE == 0u &&
            (C.realismProfile >= 1u || C.diskNoiseModel == 4u));
}

static inline bool comp_thin_hybrid_active(constant ComposeParams& C) {
    return (FC_PHYSICS_MODE == 0u && FC_VISIBLE_MODE == 0u &&
            (C.realismProfile == 2u || C.realismProfile == 3u || C.realismProfile == 4u ||
             C.diskNoiseModel == 4u));
}

static inline bool comp_thin_realism_debug_active(constant ComposeParams& C) {
    return (C.analysisMode >= 31u && C.analysisMode <= 42u);
}

static inline bool comp_thin_hybrid_debug_active(constant ComposeParams& C) {
    return comp_thin_realism_debug_active(C) && C.realismProfile >= 2u;
}

static inline bool comp_linear_rgb_is_final_sentinel(float w) {
    return w > 1.25;
}

static inline float comp_camera_lens_f_number(constant ComposeParams& C) {
    return max(C.cameraColorParams.z, 0.7);
}

static inline float comp_camera_focus_depth(constant ComposeParams& C) {
    return max(C.cameraColorParams.w, 0.0);
}

static inline uint comp_camera_aperture_blades(constant ComposeParams& C) {
    return C.cameraFlags & 0xffu;
}

static inline float comp_camera_aperture_rotation(constant ComposeParams& C) {
    return (float((C.cameraFlags >> 8u) & 0xffu) / 255.0) * 6.28318530718;
}

static inline float comp_camera_dof_strength(constant ComposeParams& C) {
    return (float((C.cameraFlags >> 16u) & 0xffu) / 255.0) * 4.0;
}

static inline bool comp_camera_dof_enabled(constant ComposeParams& C) {
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 2u) ? 2u : 0u);
    return (C.analysisMode == 0u) &&
           (profile >= 2u) &&
           (comp_camera_dof_strength(C) > 1e-5);
}

static inline float comp_external_depth_from_w(float w, constant ComposeParams& C) {
    // External compose validation can encode source depth as alpha = 2 + depth.
    // alpha=2 remains the old "final linear radiance" sentinel and means
    // "focused/unknown depth", so existing HDR inputs are unchanged.
    return (w > 2.0001) ? (w - 2.0) : comp_camera_focus_depth(C);
}

static inline float comp_camera_coc_px(float depth, constant ComposeParams& C) {
    if (!comp_camera_dof_enabled(C)) return 0.0;
    float focus = comp_camera_focus_depth(C);
    if (!(focus > 1e-5) || !(depth > 1e-5)) return 0.0;
    float frameMin = max(min(float(C.fullInputWidth), float(C.fullInputHeight)), 1.0);
    float defocus = abs(depth - focus) / max(max(depth, focus), 1e-5);
    float aperture = 1.0 / comp_camera_lens_f_number(C);
    // Thin-lens CoC is scene-scale dependent. This calibrated pixel proxy keeps
    // the physically correct dependencies: wider aperture, farther from focus,
    // and larger image format produce a larger blur circle.
    return clamp(frameMin * 0.018 * comp_camera_dof_strength(C) * aperture * defocus, 0.0, 18.0);
}

static inline float2 comp_camera_aperture_offset(uint i, uint n, float cocPx, constant ComposeParams& C) {
    float u = (float(i) + 0.5) / max(float(n), 1.0);
    float theta = (float(i) * 2.39996323) + comp_camera_aperture_rotation(C);
    float r = sqrt(u);
    uint blades = comp_camera_aperture_blades(C);
    if (blades >= 3u) {
        float nf = float(clamp(blades, 3u, 16u));
        float sector = 6.28318530718 / nf;
        float local = fmod(theta + 0.5 * sector, sector) - 0.5 * sector;
        float edge = cos(0.5 * sector) / max(cos(local), 1e-4);
        r *= clamp(edge, 0.0, 1.0);
    }
    return cocPx * r * float2(cos(theta), sin(theta));
}

static inline float comp_camera_dof_depth_weight(float centerDepth, float sampleDepth) {
    if (!(centerDepth > 1e-5) || !(sampleDepth > 1e-5)) return 1.0;
    float rel = abs(sampleDepth - centerDepth) / max(max(centerDepth, sampleDepth), 1e-5);
    float sigma = 0.10;
    return exp(-0.5 * (rel * rel) / max(sigma * sigma, 1e-6));
}

static inline float comp_camera_aperture_starburst(float theta, constant ComposeParams& C) {
    uint blades = comp_camera_aperture_blades(C);
    float rot = comp_camera_aperture_rotation(C);
    if (blades >= 3u) {
        float n = float(clamp(blades, 3u, 16u));
        return pow(abs(cos(0.5 * n * (theta - rot))), 24.0);
    }
    return pow(abs(cos(3.0 * theta)), 26.0);
}

static inline bool comp_grmhd_visible_final_rec(const CollisionInfo rec,
                                                constant ComposeParams& C)
{
    return (FC_PHYSICS_MODE == 3u &&
            visible_mode_enabled_fc() &&
            C.analysisMode == 0u &&
            rec.noise <= -50.0);
}

static inline float comp_grmhd_visible_high_order_visibility(const CollisionInfo rec,
                                                             constant Params& P,
                                                             constant ComposeParams& C)
{
    (void)rec;
    (void)P;
    (void)C;
    // Do not force a shadow or suppress caustics in the physical radiance path.
    // Unresolved eye/camera effects belong in the observer PSF/adaptation layer,
    // not as an impact-parameter mask on GRMHD transport.
    return 1.0;
}

static inline float comp_atlas_temperature_ratio(float traceT,
                                                 float referenceT,
                                                 constant Params& P)
{
    if (P.diskAtlasMode == 0u) return 1.0;
    if (!(traceT > 1.0) || !(referenceT > 1.0) || !isfinite(traceT) || !isfinite(referenceT)) {
        return 1.0;
    }
    // The atlas temperature channel is a GRMHD-derived multiplicative photosphere
    // modulation. Keep it bounded so code-unit preprocessing cannot overwrite the
    // physical radial thin-disk temperature backbone.
    return clamp(traceT / max(referenceT, 1.0), 0.35, 2.25);
}

static inline ThinHybridRealismConfig comp_thin_hybrid_config(constant Params& P,
                                                             constant ComposeParams& C)
{
    ThinHybridRealismConfig cfg;
    float turbulence = clamp(P.diskTurbulence, 0.0, 2.0);
    bool legacyPeriodicThin = (C.diskNoiseModel == 4u);
    cfg.legacyPeriodicThin = legacyPeriodicThin ? 1.0 : 0.0;
    if (legacyPeriodicThin && C.realismProfile >= 3u) {
        cfg.perturbAmp = clamp(0.62 + 0.20 * turbulence, 0.54, 0.88);
        cfg.atmosphereTau = 0.30;
        cfg.coronaStrength = 0.055;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.84;
    } else if (legacyPeriodicThin) {
        cfg.perturbAmp = clamp(0.50 + 0.20 * turbulence, 0.38, 0.74);
        cfg.atmosphereTau = 0.17;
        cfg.coronaStrength = 0.024;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.48;
    } else if (C.realismProfile == 5u) {
        cfg.perturbAmp = clamp(0.34 + 0.18 * turbulence, 0.18, 0.58);
        cfg.atmosphereTau = 0.0;
        cfg.coronaStrength = 0.018;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.52;
    } else if (C.realismProfile == 4u) {
        cfg.perturbAmp = clamp(0.30 + 0.14 * turbulence, 0.24, 0.46);
        cfg.atmosphereTau = 0.035;
        cfg.coronaStrength = 0.002;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.30;
    } else if (C.realismProfile == 3u) {
        cfg.perturbAmp = clamp(0.62 + 0.20 * turbulence, 0.54, 0.88);
        cfg.atmosphereTau = 0.30;
        cfg.coronaStrength = 0.055;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.84;
    } else if (C.realismProfile == 2u || comp_thin_hybrid_debug_active(C)) {
        cfg.perturbAmp = clamp(0.42 + 0.16 * turbulence, 0.30, 0.62);
        cfg.atmosphereTau = 0.17;
        cfg.coronaStrength = 0.024;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.48;
    } else {
        cfg.perturbAmp = 0.0;
        cfg.atmosphereTau = 0.0;
        cfg.coronaStrength = 0.0;
        cfg.beamingStrength = 0.0;
        cfg.innerBoost = 0.0;
    }
    if (legacyPeriodicThin && C.realismProfile >= 3u) {
        cfg.outerFadeStart = 0.50;
        cfg.outerFadeEnd = 0.98;
    } else if (legacyPeriodicThin) {
        cfg.outerFadeStart = 0.66;
        cfg.outerFadeEnd = 1.00;
    } else if (C.realismProfile == 5u) {
        cfg.outerFadeStart = 0.74;
        cfg.outerFadeEnd = 1.00;
    } else if (C.realismProfile == 4u) {
        cfg.outerFadeStart = 0.70;
        cfg.outerFadeEnd = 1.00;
    } else if (C.realismProfile == 3u) {
        cfg.outerFadeStart = 0.50;
        cfg.outerFadeEnd = 0.98;
    } else if (C.realismProfile == 2u || comp_thin_hybrid_debug_active(C)) {
        cfg.outerFadeStart = 0.66;
        cfg.outerFadeEnd = 1.00;
    } else {
        cfg.outerFadeStart = 0.78;
        cfg.outerFadeEnd = 1.00;
    }
    cfg.atmosphereTint = float3(1.04, 0.99, 0.91);
    cfg.coronaTint = float3(0.72, 0.88, 1.18);
    return cfg;
}

static inline float comp_emit_radius_norm(const CollisionInfo rec, constant Params& P) {
    if (rec.emit_r_norm > 1e-5) return max(rec.emit_r_norm, 1.0 + 1e-5);
    if (rec.v_disk.y > P.rs * 0.5) return max(rec.v_disk.y / max(P.rs, 1e-6), 1.0 + 1e-5);
    return max(disk_inner_radius_m(P) / max(P.rs, 1e-6), 1.0 + 1e-5);
}

static inline float comp_emit_phi(const CollisionInfo rec) {
    if (abs(rec.emit_phi) > 1e-7) return rec.emit_phi;
    float3 d = rec.direct_world.xyz;
    return atan2(d.y, d.x);
}

static inline float comp_thin_nt_emissivity_norm(float rNorm, constant Params& P) {
    float rs = max(P.rs, 1e-6);
    float massLen = max(0.5 * rs, 1e-12);
    float r = max(rNorm * rs, rs * 1.0001);
    float rIn = max(disk_inner_radius_m(P), rs * 1.0001);
    float rM = r / massLen;
    float rInM = rIn / massLen;
    float a = (FC_METRIC == 0) ? 0.0 : clamp(P.spin, -0.999, 0.999);
    float f = disk_nt_flux_shape(rM, rInM, a);
    float rPeakM = max(rInM * 1.58, rInM + 0.35);
    float fRef = max(disk_nt_flux_shape(rPeakM, rInM, a), 1e-30);
    float e = clamp(f / fRef, 0.0, 3.0);
    return isfinite(e) ? e : 0.0;
}

static inline float comp_thin_outer_flux_taper(float rNorm, constant Params& P) {
    float rs = max(P.rs, 1e-6);
    float rInNorm = max(disk_inner_radius_m(P) / rs, 1.0001);
    float rOutNorm = max(P.re / rs, rInNorm + 1e-4);
    float u = clamp((rNorm - rInNorm) / max(rOutNorm - rInNorm, 1e-4), 0.0, 1.0);
    // The geometric disk has a finite outer radius. Treat that boundary as a
    // smooth thermal truncation so the scientific source does not create a hard
    // luminous wall at P.re.
    return 1.0 - smoothstep(0.80, 1.00, u);
}

struct ThinMRIShearingField {
    float perturb;
    float filament;
    float zonal;
    float channel;
    float densityContrast;
};

struct ThinSpectralHeatingField {
    float raw;
    float low;
    float high;
    float cloud;
    float filament;
    float activity;
};

static inline float comp_periodic01(float x) {
    return clamp(0.5 + 0.5 * x, 0.0, 1.0);
}

static inline float comp_wrap_pi(float x) {
    constexpr float pi = 3.141592653589793;
    constexpr float twoPi = 6.283185307179586;
    return x - twoPi * floor((x + pi) / twoPi);
}

static inline ThinSpectralHeatingField comp_thin_spectral_heating_field(float rNorm,
                                                                        float rInNorm,
                                                                        float phi,
                                                                        float flowTimeOffset,
                                                                        constant Params& P)
{
    ThinSpectralHeatingField f;
    float rr = max(rNorm, rInNorm + 1e-4);
    float logR = log(max(rr / max(rInNorm, 1e-4), 1.0001));
    float rOutNorm = max(P.re / max(P.rs, 1e-6), rInNorm + 1.0);
    float logRMax = log(max(rOutNorm / max(rInNorm, 1e-4), 1.05));
    float timeRs = P.diskFlowTime + flowTimeOffset;
    float orbitalBoost = max(P.diskOrbitalBoost, 0.05);
    float turbulence = clamp(P.diskTurbulence, 0.0, 2.4);
    // Keep the canonical source calibrated around the registry default
    // diskTurbulence=1.6, but let controlled validation sweeps adjust the
    // stochastic heating support without adding another public source model.
    float turbulenceTune = clamp((turbulence - 1.6) / 0.8, -1.0, 1.0);
    float rs = max(P.rs, 1e-6);
    float camRrs = max(length(P.camPos) / rs, rr + 1.0);
    float pixelAngle = 1.0 / max(P.d, 1.0);
    float hOverR = clamp((P.he / rs) / max(rr, 1.0), 0.002, 0.080);
    float projected = clamp(camRrs * pixelAngle / max(rr, 1.0), 0.0, 0.24);
    // Approximate the source footprint in disk coordinates. This filters only
    // the stochastic skin emissivity modes; the analytic photosphere is kept
    // untouched. The floor tracks a fraction of H/R so sub-photospheric structure
    // is not allowed to masquerade as resolvable radiance.
    // Photospheric smoothing scale: radiative diffusion through the tau ~ 1
    // layer thermalizes horizontal structure below roughly one scale height,
    // so the source filter floor is ~(0.6-1.0) H/r, not several H/r.
    // Radiation-MHD disk photospheres retain clear surface-brightness
    // structure down to a few H (Hirose+ 2006, Jiang+ 2013); the previous
    // 1.65-2.60 H/r sigmas erased everything finer than ~10 H. The projected
    // pixel-footprint terms are unchanged: structure the camera cannot
    // resolve still averages away honestly.
    float sigmaPhiSrc = clamp(max(1.05 * hOverR, 1.20 * projected), 0.0050, 0.120);
    float sigmaLogSrc = clamp(max(0.62 * hOverR, 0.78 * projected), 0.0040, 0.095);
    float raw = 0.0;
    float low = 0.0;
    float cloud = 0.0;
    float cloudNormW = 0.0;
    float shearArc = 0.0;
    float shearArcNormW = 0.0;
    float normRaw2 = 0.0;
    float normLow2 = 0.0;
    constexpr uint modeCount = 96u;
    constexpr float twoPi = 6.283185307179586;

    // Disk-coordinate spectral heating field. This is a deterministic,
    // band-limited approximation to MRI-like shearing emissivity structure:
    // modes live in (log r, phi), are advected by local Keplerian shear, and feed
    // emissivity/temperature only. It is not screen-space or material texture.
    //
    // Spectral content: radial wavenumbers are log-uniform from disk-scale
    // waves (kr ~ 0.85) down to the MRI driving scale of a thin disk
    // (kr ~ 170 per ln r, i.e. radial wavelength ~ 2 H for H/r ~ 0.02);
    // the photospheric/footprint Gaussian below truncates whatever a given
    // H/r or camera resolution cannot physically support. Shear stretches
    // turbulence azimuthally, so each mode's azimuthal harmonic follows
    // m ~ kr / elongation with elongation ~ 3-11 (lambda_phi/lambda_r),
    // matching the trailing, azimuthally elongated filaments seen in
    // shearing-box and global radiation-MHD simulations.
    for (uint i = 0u; i < modeCount; ++i) {
        float id = float(i) + 1.0;
        float h0 = fract(id * 0.754877666 + 0.113);
        float h1 = fract(id * 0.569840291 + 0.217);
        float h2 = fract(id * 0.438572245 + 0.431);
        float h3 = fract(id * 0.318309886 + 0.173);
        float h4 = fract(id * 0.221033321 + 0.619);
        float h5 = fract(id * 0.141421356 + 0.347);

        float kr = 0.85 * pow(200.0, h1); // log-uniform 0.85 .. 170 per ln r
        float elongation = mix(3.0, 11.0, h0);
        float m = max(2.0, floor(kr / elongation + 0.5));
        kr *= (h2 < 0.5) ? -1.0 : 1.0;
        float kMag = sqrt(kr * kr + m * m);
        // Kolmogorov energy spectrum E(k) ~ k^-5/3 with log-uniform mode
        // density (dk ~ k): per-mode energy ~ E(k)*k ~ k^-2/3, so the
        // per-mode amplitude falls as k^-1/3.
        float amp = pow(max(kMag, 1.0), -0.3333333) * mix(0.72, 1.28, h3);
        // Outer-scale (driving) cutoff. MRI turbulence in a differentially
        // rotating disk has no inverse cascade: there is essentially no
        // surface-brightness power at radial scales larger than the largest
        // eddies (~ a few H). Without this, the pure k^-1/3 weighting piles the
        // most amplitude onto the disk-scale kr~1, m=2 mode, which renders as an
        // unphysical grand-design two-arm spiral. Suppress modes whose radial
        // wavelength exceeds ~6 H (kr_drive = 2 pi / (6 H/r) per ln r), leaving
        // the tightly-wound driving-scale-and-smaller filaments that radiation-
        // MHD photospheres actually show.
        float krDrive = 6.2831853 / max(6.0 * hOverR, 0.02);
        float xDrive = abs(kr) / max(krDrive, 1e-6);
        float outerCut = (xDrive * xDrive) / (1.0 + xDrive * xDrive);
        amp *= outerCut;
        float footprintFilter = exp(-0.5 * (
            kr * kr * sigmaLogSrc * sigmaLogSrc +
            m * m * sigmaPhiSrc * sigmaPhiSrc
        ));
        amp *= footprintFilter;

        float omega = orbitalBoost * pow(max(rr, 1.0), -1.5);
        float advectedPhi = phi - omega * timeRs * mix(0.78, 1.22, h4);
        float slowPhase = 0.035 * timeRs * (h5 - 0.5);
        float phase = twoPi * h3 + kr * logR + m * advectedPhi + slowPhase;
        float v = cos(phase);

        raw += amp * v;
        normRaw2 += amp * amp;

        float lowGate = smoothstep(0.0, 1.0, 1.0 - clamp((abs(kr) + 0.60 * m - 3.5) / 7.0, 0.0, 1.0));
        low += amp * lowGate * v;
        normLow2 += amp * amp * lowGate * lowGate;
    }

    // Positive "cloud packet" heating field in disk coordinates. These are not
    // material/albedo blobs: they represent unresolved MRI/reconnection heating
    // cells in the emitting skin, advected by Keplerian shear. The packets are
    // log-radial, azimuth-periodic, band-limited, and only add emissivity.
    constexpr uint packetCount = 56u;
    for (uint i = 0u; i < packetCount; ++i) {
        float id = float(i) + 1.0;
        float h0 = fract(id * 0.618033989 + 0.071);
        float h1 = fract(id * 0.414213562 + 0.193);
        float h2 = fract(id * 0.732050808 + 0.317);
        float h3 = fract(id * 0.577350269 + 0.529);
        float h4 = fract(id * 0.301029996 + 0.683);
        float h5 = fract(id * 0.839286755 + 0.241);

        float logCenter = mix(0.08, max(logRMax * 0.92, 0.10), h0);
        float rCenter = rInNorm * exp(logCenter);
        float omegaCenter = orbitalBoost * pow(max(rCenter, 1.0), -1.5);
        float phiCenter = twoPi * h1 + omegaCenter * timeRs * mix(0.84, 1.18, h2);
        float dLog = logR - logCenter;
        float trailingPitch = mix(2.2, 7.2, h3) * ((h4 < 0.5) ? -1.0 : 1.0);
        float dPhi = comp_wrap_pi(phi - phiCenter - trailingPitch * dLog);

        float sigmaLog = mix(0.026, 0.094, h4);
        float sigmaPhi = mix(0.048, 0.196, h5);
        // Source-footprint filtering prevents sub-resolution packets from
        // becoming caustic-aligned scratches in high-order lensed images.
        sigmaLog = max(sigmaLog, 0.78 * sigmaLogSrc);
        sigmaPhi = max(sigmaPhi, 0.92 * sigmaPhiSrc);

        float q = (dLog * dLog) / max(sigmaLog * sigmaLog, 1e-6)
                + (dPhi * dPhi) / max(sigmaPhi * sigmaPhi, 1e-6);
        float packet = exp(-0.5 * q);
        float radialWeight = pow(max(rCenter / max(rInNorm, 1e-4), 1.0), -0.28)
                           * (1.0 - smoothstep(0.86, 1.00, logCenter / max(logRMax, 1e-4)));
        float amp = mix(0.65, 1.35, fract(id * 0.127323954 + 0.411)) * radialWeight;
        cloud += amp * packet;
        cloudNormW += amp;
    }

    // Positive sheared hot-skin arcs. MRI turbulence in a differentially
    // rotating disk is stretched into azimuthally elongated structures. These
    // packets live only in disk coordinates, advect with local Keplerian shear,
    // and feed the hot-skin emissivity budget. They are not albedo, normal, or
    // screen-space texture, and they never subtract from the photosphere.
    constexpr uint arcCount = 40u;
    for (uint i = 0u; i < arcCount; ++i) {
        float id = float(i) + 1.0;
        float h0 = fract(id * 0.754877666 + 0.291);
        float h1 = fract(id * 0.569840291 + 0.743);
        float h2 = fract(id * 0.438572245 + 0.157);
        float h3 = fract(id * 0.318309886 + 0.887);
        float h4 = fract(id * 0.221033321 + 0.463);
        float h5 = fract(id * 0.141421356 + 0.619);

        float logCenter = mix(0.05, max(logRMax * 0.88, 0.09), h0);
        float rCenter = rInNorm * exp(logCenter);
        float omegaCenter = orbitalBoost * pow(max(rCenter, 1.0), -1.5);
        float phiCenter = twoPi * h1 + omegaCenter * timeRs * mix(0.90, 1.12, h2);
        float dLog = logR - logCenter;
        float trailingPitch = mix(5.5, 13.5, h3) * ((h4 < 0.5) ? -1.0 : 1.0);
        float dPhi = comp_wrap_pi(phi - phiCenter - trailingPitch * dLog);

        float sigmaLog = max(mix(0.010, 0.038, h4), 0.64 * sigmaLogSrc);
        float sigmaPhi = max(mix(0.115, 0.330, h5), 0.95 * sigmaPhiSrc);
        float q = (dLog * dLog) / max(sigmaLog * sigmaLog, 1e-6)
                + (dPhi * dPhi) / max(sigmaPhi * sigmaPhi, 1e-6);
        float arc = exp(-0.5 * q);
        // Give arcs a mild inner-disk preference without creating a global
        // inner glow. The outer taper prevents standing stripes at the disk rim.
        float radialWeight = pow(max(rCenter / max(rInNorm, 1e-4), 1.0), -0.34)
                           * (1.0 - smoothstep(0.78, 1.00, logCenter / max(logRMax, 1e-4)));
        float amp = mix(0.52, 1.22, fract(id * 0.173205081 + 0.337)) * radialWeight;
        shearArc += amp * arc;
        shearArcNormW += amp;
    }

    float rawNorm = raw / max(sqrt(normRaw2), 1e-6);
    float lowNorm = low / max(sqrt(normLow2), 1e-6);
    float highNorm = rawNorm - 0.62 * lowNorm;
    float cloudNorm = cloud / max(0.145 * cloudNormW, 1e-6);
    float cloudActivity = smoothstep(0.18 - 0.035 * turbulenceTune,
                                     0.82 - 0.060 * turbulenceTune,
                                     cloudNorm);
    // Turbulent dissipation intermittency. Summing many independent positive
    // ridge modes statistically flattens (~1/sqrt(N)), which is why the old
    // mean-combined filament channel saturated its activity gate into a
    // structureless constant. Cascade dissipation is a multiplicative process:
    // model it as a mean-one log-normal of the unit-variance sheared spectral
    // field (random-phase variance of sum(a_i cos) is sum(a_i^2)/2), and let
    // the filament channel select its strong tail. This is the standard
    // log-normal intermittency closure for turbulent dissipation, and the
    // surviving structure inherits the sheared, azimuthally elongated, fine
    // -scale anisotropy of the spectral basis above.
    float rawGauss = raw / max(sqrt(0.5 * normRaw2), 1e-6);
    float sigmaQ = 0.70 + 0.25 * turbulenceTune;
    float dissip = exp(clamp(sigmaQ * rawGauss - 0.5 * sigmaQ * sigmaQ, -4.0, 3.0));
    float filamentActivity = smoothstep(0.92, 1.95, dissip);
    float shearArcNorm = shearArc / max(0.062 * shearArcNormW, 1e-6);
    float shearArcActivity = smoothstep(0.13 - 0.035 * turbulenceTune,
                                        0.66 - 0.065 * turbulenceTune,
                                        shearArcNorm);

    f.raw = clamp(0.5 + 0.22 * rawNorm, 0.0, 1.0);
    f.low = clamp(max(lowNorm, 0.0), 0.0, 1.0);
    f.high = clamp(max(highNorm, 0.0) * (1.0 + 0.10 * turbulenceTune), 0.0, 2.0);
    f.cloud = clamp(cloudActivity, 0.0, 1.0);
    f.filament = clamp(max(filamentActivity, 0.72 * shearArcActivity + 0.28 * filamentActivity), 0.0, 1.0);
    // Window calibrated to the residual high-pass field's actual deviation
    // (sigma ~ 0.22-0.31 across radii); the old (0.38, 1.12) window sat above
    // nearly the whole distribution and pinned this channel at ~0.
    float highActivity = smoothstep(0.08 - 0.010 * turbulenceTune,
                                    0.50 - 0.040 * turbulenceTune,
                                    f.high);
    // The canonical skin should be positive emissive dissipation, not a broad
    // surface texture. Bias activity toward high/filament components while
    // retaining cloud packets as secondary support.
    f.activity = clamp(0.34 * highActivity
                     + 0.20 * pow(f.cloud, 1.18)
                     + 0.46 * pow(f.filament, 1.10),
                     0.0, 1.0);
    return f;
}

static inline float comp_thin_periodic_streak(float shear,
                                              float logR,
                                              float rr,
                                              float omega,
                                              float timeRs,
                                              float radialCoherence)
{
    // Periodic in azimuth by construction. The m={4,7,11} modes are advected
    // by local orbital phase and sheared by log(r), giving stretched disk-space
    // structure without hash/fbm randomness or phi seams.
    float m4 = sin(4.0 * shear + 0.70 * radialCoherence * logR + 0.18 * sin(0.41 * rr));
    float m7 = sin(7.0 * (shear - 0.22 * omega * timeRs) + 1.35 * radialCoherence * logR + 0.55 * m4);
    float m11 = sin(11.0 * (shear - 0.37 * omega * timeRs) + 2.05 * radialCoherence * logR + 0.09 * rr);
    return comp_periodic01(0.46 * m4 + 0.32 * m7 + 0.22 * m11);
}

static inline float comp_thin_periodic_eddy(float phi,
                                            float logR,
                                            float rr,
                                            float omega,
                                            float timeRs,
                                            float radialCoherence)
{
    float e5 = cos(5.0 * (phi - 1.85 * omega * timeRs) + 0.92 * radialCoherence * logR);
    float e9 = sin(9.0 * (phi - 2.45 * omega * timeRs) + 1.70 * radialCoherence * logR + 0.21 * rr);
    float e14 = cos(14.0 * (phi - 3.10 * omega * timeRs) + 2.65 * radialCoherence * logR + 0.35 * e5);
    return comp_periodic01(0.40 * e5 + 0.34 * e9 + 0.26 * e14);
}

static inline ThinMRIShearingField comp_thin_mri_shearing_field(float rNorm,
                                                               float rInNorm,
                                                               float phi,
                                                               float cloudNorm,
                                                               constant Params& P,
                                                               ThinHybridRealismConfig cfg)
{
    ThinMRIShearingField f;
    float rr = max(rNorm, rInNorm + 1e-4);
    float dr = max(rr - rInNorm, 0.0);
    float rs = max(P.rs, 1e-6);
    // Match the rest of the flow model: diskFlowTime is a dimensionless
    // animation/orbital phase control, not wall-clock seconds.
    float timeRs = P.diskFlowTime;
    float omega = max(P.diskOrbitalBoost, 0.05) * pow(rr, -1.5);
    float shear = phi - omega * timeRs;
    float logR = log(max(rr / max(rInNorm, 1e-4), 1.0001));

    // Shearing-box-inspired coordinates: azimuthal structures are stretched by
    // differential rotation, while radial coherence scales with H/r. This is a
    // constrained turbulence model, not a solved MHD simulation.
    float hOverR = clamp(P.he / max(rr * rs, 1e-6), 0.003, 0.12);
    bool legacyPeriodicThin = (cfg.legacyPeriodicThin > 0.5);
    float radialCoherence = legacyPeriodicThin
        ? clamp(0.20 / hOverR, 2.5, 32.0)
        : clamp(0.045 / hOverR, 1.2, 6.0);
    float innerActivity = smoothstep(0.15, 2.2, dr) * (1.0 - smoothstep(46.0, 96.0, rr));
    float innerGain = 0.76 + 0.42 * (1.0 - smoothstep(4.0, 15.0, dr));

    // Low azimuthal-order channels. Their radial winding is set by the local
    // shear coherence (radialCoherence ~ 1/(H/r)), not fixed constants: a
    // trailing MRI spiral has a small pitch angle, so a given m-arm wraps many
    // times per e-fold in a thin disk. The previous fixed 5.2/8.8/14.0 log-r
    // coefficients gave the m=2 channel a winding of only ~2.6 per e-fold - an
    // unphysically open grand-design two-arm spiral. Scaling the winding with
    // radialCoherence (and lifting the higher-m arms) turns those open arms into
    // the tightly-wound, azimuthally-sheared filaments a thin-disk photosphere
    // actually shows, matching the physical spectral path.
    float wind = 3.6 * radialCoherence;
    float channel2 = sin(2.0 * shear + 1.55 * wind * logR + 0.24 * sin(0.37 * rr));
    float channel3 = sin(3.0 * (phi - 1.55 * omega * timeRs) + 2.45 * wind * logR + 0.35 * channel2);
    float channel5 = sin(5.0 * (phi - 2.15 * omega * timeRs) + 3.6 * wind * logR + 0.13 * rr);
    f.channel = 0.30 * channel2 + 0.32 * channel3 + 0.38 * channel5;

    float zonalPhase = legacyPeriodicThin
        ? (radialCoherence * logR + 0.035 * timeRs + 0.18 * sin(2.0 * shear))
        : (0.45 * radialCoherence * logR
            + 0.035 * timeRs
            + 0.55 * sin(2.0 * shear)
            + 0.24 * sin(5.0 * (phi - 1.15 * omega * timeRs)));
    f.zonal = legacyPeriodicThin ? sin(zonalPhase) : 0.55 * sin(zonalPhase);

    float streak = comp_thin_periodic_streak(shear, logR, rr, omega, timeRs, radialCoherence);
    float eddy = comp_thin_periodic_eddy(phi, logR, rr, omega, timeRs, radialCoherence);
    float ridge = 1.0 - abs(2.0 * streak - 1.0);
    f.filament = smoothstep(0.40, 0.86, 0.72 * ridge + 0.28 * eddy);

    // Weight the fine, tightly-wound filament/eddy content above the low-m
    // channels for the physical (non-legacy) profile, so the surface reads as
    // sheared turbulent striations rather than a couple of dominant arms. Legacy
    // periodic-thin keeps its historic channel-dominated balance for exact
    // reproduction.
    float cloudCentered = cloudNorm - 0.5;
    float raw = (legacyPeriodicThin ? 0.54 : 0.34) * f.channel
              + (legacyPeriodicThin ? 0.16 : 0.06) * f.zonal
              + (legacyPeriodicThin ? 0.34 : 0.52) * (f.filament - 0.5)
              + (legacyPeriodicThin ? 0.16 : 0.26) * (eddy - 0.5)
              + 0.10 * cloudCentered;
    f.densityContrast = clamp(raw * innerGain * innerActivity, -1.0, 1.0);

    float amp = clamp(cfg.perturbAmp, 0.0, 1.0);
    f.perturb = clamp(0.5 + 0.5 * amp * f.densityContrast, 0.0, 1.0);
    return f;
}

static inline float comp_thin_shear_perturb(float rNorm,
                                            float phi,
                                            constant Params& P,
                                            ThinHybridRealismConfig cfg)
{
    float rInNorm = max(disk_inner_radius_m(P) / max(P.rs, 1e-6), 1.0001);
    ThinMRIShearingField f = comp_thin_mri_shearing_field(rNorm, rInNorm, phi, 0.5, P, cfg);
    return f.perturb;
}

static inline float comp_thin_optical_depth_density(float rNorm,
                                                    float rInNorm,
                                                    float perturb,
                                                    float cloudNorm,
                                                    ThinHybridRealismConfig cfg)
{
    float rr = max(rNorm, 1.0001);
    float dr = max(rr - rInNorm, 0.0);
    float contrast = 0.82 * (2.0 * perturb - 1.0)
                   + 0.24 * (cloudNorm - 0.5);

    float sigma = 0.30 + 0.62 * cfg.perturbAmp;
    float tau = exp(clamp(sigma * contrast - 0.5 * sigma * sigma, -0.80, 0.82));
    float innerDamping = 0.78 + 0.22 * smoothstep(0.35, 2.2, dr);
    return clamp(mix(1.0, tau * innerDamping, clamp(cfg.perturbAmp * 1.15, 0.0, 1.0)), 0.38, 1.95);
}

static inline float comp_thin_alpha_opacity_proxy(float rNorm,
                                                  float rInNorm,
                                                  constant Params& P)
{
    float rr = max(rNorm, rInNorm + 1e-4);
    float dr = max(rr - rInNorm, 0.0);
    float x = max(rr / max(rInNorm, 1e-4), 1.0);

    // Dimensionless Shakura-Sunyaev-inspired proxy, not a solved vertical
    // structure model. It anchors visual opacity to mdot, efficiency, and
    // zero-torque inner-boundary behavior before turbulence is applied.
    const float alphaRef = 0.10;
    float eta = clamp(P.diskRadiativeEfficiency, 0.01, 0.42);
    float mdot = max(P.diskMdotEdd, 1e-5);
    float boundary = max(1.0 - sqrt(rInNorm / rr), 0.0);
    float innerGate = smoothstep(0.04, 0.90, dr);
    float mdotScale = pow(clamp(mdot / 0.10, 0.05, 30.0), 0.55);
    float etaScale = pow(clamp(0.10 / eta, 0.25, 10.0), 0.35);
    float alphaScale = pow(0.10 / alphaRef, 0.80);
    float radial = pow(x, -0.68) * (0.35 + 0.65 * sqrt(clamp(boundary, 0.0, 1.0)));
    float tau = innerGate * mdotScale * etaScale * alphaScale * radial;
    return clamp(tau, 0.18, 2.40);
}

// Observational/cinematic thin-disk structure. This is a phenomenological
// layer: the radial opacity baseline is thin-disk inspired, while azimuthal
// structure is constrained to disk coordinates and Keplerian shear. It is not
// used by the strict physical/scientific presentation path.
static inline ThinDiskStructureSample comp_thin_disk_structure(float rNorm,
                                                              float rInNorm,
                                                              float phi,
                                                              float cloudNorm,
                                                              constant Params& P,
                                                              ThinHybridRealismConfig cfg)
{
    ThinDiskStructureSample m;
    float rr = max(rNorm, 1.0001);
    float dr = max(rr - rInNorm, 0.0);
    ThinMRIShearingField mri = comp_thin_mri_shearing_field(rr, rInNorm, phi, cloudNorm, P, cfg);
    bool legacyPeriodicThin = (cfg.legacyPeriodicThin > 0.5);
    if (legacyPeriodicThin) {
        m.filament = mri.filament;
        m.perturb = mri.perturb;

        float radialTau = comp_thin_alpha_opacity_proxy(rr, rInNorm, P);
        m.radialTau = radialTau;
        float densityBase = comp_thin_optical_depth_density(rr, rInNorm, m.perturb, cloudNorm, cfg);
        float cloudCentered = cloudNorm - 0.5;
        float innerTaper = 1.0 - smoothstep(2.2, 14.0, dr);
        float contrast = 0.62 * mri.densityContrast
                       + 0.22 * cloudCentered
                       + 0.30 * (m.filament - 0.5)
                       + 0.06 * mri.zonal
                       + 0.10 * innerTaper * mri.channel;
        float sigma = 0.18 + 0.42 * cfg.perturbAmp;
        float logDensity = clamp(sigma * contrast - 0.5 * sigma * sigma, -0.58, 0.72);
        float turbulentDensity = densityBase * exp(logDensity);
        float densityMix = clamp(0.45 + 0.45 * cfg.perturbAmp, 0.0, 0.92);
        m.density = clamp(radialTau * mix(1.0, turbulentDensity, densityMix), 0.22, 2.55);

        float tempContrast = cfg.perturbAmp * (0.30 * (m.perturb - 0.5)
                             + 0.16 * (m.filament - 0.5)
                             + 0.08 * cloudCentered
                             + 0.06 * (m.density - 1.0)
                             + 0.08 * innerTaper * mri.channel);
        m.tempShift = clamp(exp(tempContrast), 0.78, 1.30);
        m.opacity = clamp(radialTau * m.density
                        * (0.82 + 0.30 * m.filament)
                        * (0.90 + 0.16 * innerTaper), 0.18, 2.90);
        return m;
    }
    float atlasBlend = (P.diskAtlasMode != 0u) ? clamp(P.diskAtlasDensityBlend, 0.0, 1.0) : 0.0;
    float atlasCentered = cloudNorm - 0.5;
    // When an HDF5/GRMHD atlas is present, rec.noise is no longer procedural
    // decoration. It is the preprocessed disk-space column/stress structure, so
    // let it dominate unresolved photospheric contrast instead of re-smoothing it
    // through the synthetic MRI field.
    m.filament = mix(mri.filament, cloudNorm, 0.75 * atlasBlend);
    m.perturb = mix(mri.perturb, cloudNorm, 0.90 * atlasBlend);

    float radialTau = comp_thin_alpha_opacity_proxy(rr, rInNorm, P);
    m.radialTau = radialTau;
    float densityBase = comp_thin_optical_depth_density(rr, rInNorm, m.perturb, cloudNorm, cfg);
    float innerTaper = 1.0 - smoothstep(2.2, 14.0, dr);
    float contrast = 0.62 * mri.densityContrast
                   + mix(0.22, 1.10, atlasBlend) * atlasCentered
                   + 0.30 * (m.filament - 0.5)
                   + 0.06 * mri.zonal
                   + 0.10 * innerTaper * mri.channel;
    float sigma = 0.18 + 0.42 * cfg.perturbAmp;
    float logDensity = clamp(sigma * contrast - 0.5 * sigma * sigma, -0.85, 1.05);
    float turbulentDensity = densityBase * exp(logDensity);
    float densityMix = clamp(0.45 + 0.45 * cfg.perturbAmp, 0.0, 0.92);
    m.density = clamp(radialTau * mix(1.0, turbulentDensity, densityMix), 0.18, 3.20);

    // Small temperature variations follow disk-space structures; this preserves the
    // NT radial backbone while breaking the overly uniform ribbon look.
    float tempContrast = cfg.perturbAmp * (0.30 * (m.perturb - 0.5)
                         + 0.16 * (m.filament - 0.5)
                         + mix(0.08, 0.42, atlasBlend) * atlasCentered
                         + 0.06 * (m.density - 1.0)
                         + 0.08 * innerTaper * mri.channel);
    m.tempShift = clamp(exp(tempContrast), 0.70, 1.48);
    m.opacity = clamp(radialTau * m.density
                    * (0.82 + 0.30 * m.filament)
                    * (0.90 + 0.16 * innerTaper), 0.18, 2.90);
    return m;
}

struct ThinSpectralEmission {
    float3 rgb;
    float3 bodyRgb;
    float3 skinRgb;
    float3 coronaRgb;
    float g;
    float tEmit;
    float tObserved;
    float colorDilution;
    float bodyRatio;
    float skinRatio;
    float coronaRatio;
    float atlasActivity;
    float densityProxy;
    float temperatureProxy;
    float emissivityProxy;
    float opacityProxy;
    float tauProxy;
    float transferSaturation;
    float spiralProxy;
    float clumpProxy;
    float hotCrescentProxy;
};

static inline float3 comp_visible_blackbody_rgb_from_observed_temp(float tObserved,
                                                                   float colorDilution,
                                                                   constant ComposeParams& C)
{
    float X = 0.0;
    float Y = 0.0;
    float Z = 0.0;
    float cX = 0.0;
    float cY = 0.0;
    float cZ = 0.0;
    bool kahan = (C.precisionMode != 0u);
    float step = max(C.spectralStep, 0.25);
    // dLambda in meters: with it, Y is SI spectral radiance integrated over
    // wavelength (W m^-2 sr^-1) and 683.002 * Y is luminance in cd/m^2,
    // matching comp_visible_xyz_from_spectrum. Without it this path was a
    // factor 1/dLambda (~2e8 at the 5 nm default) above SI, which broke the
    // absolute photometric camera/eye calibration for the canonical source.
    float dLamM = step * 1e-9;
    for (float lam = 380.0; lam <= 750.001; lam += step) {
        float lamM = lam * 1e-9;
        float xBar, yBar, zBar;
        comp_cie_xyz_bar(lam, xBar, yBar, zBar);
        float b = comp_planck_lambda(lamM, tObserved) * colorDilution * dLamM;
        if (kahan) {
            float yx = b * xBar - cX;
            float tx = X + yx;
            cX = (tx - X) - yx;
            X = tx;

            float yy = b * yBar - cY;
            float ty = Y + yy;
            cY = (ty - Y) - yy;
            Y = ty;

            float yz = b * zBar - cZ;
            float tz = Z + yz;
            cZ = (tz - Z) - yz;
            Z = tz;
        } else {
            X += b * xBar;
            Y += b * yBar;
            Z += b * zBar;
        }
    }
    return comp_xyz_to_rgb(float3(X, Y, Z));
}

static inline float comp_frequency_shift_from_record(const CollisionInfo rec,
                                                     constant Params& P,
                                                     constant ComposeParams& C)
{
    if (C.spectralEncoding == 1u) {
        return clamp(rec.v_disk.x, 1e-4, 1e4);
    }

    float3 v = rec.v_disk.xyz;
    float3 d = rec.direct_world.xyz;
    float vNorm = length(v);
    float dNorm = length(d);
    float beta = clamp(vNorm / max(P.c, 1e-12), 0.0, 0.999999);
    float cosTheta = clamp(dot(v, d) / max(vNorm * dNorm, 1e-30), -1.0, 1.0);
    float gamma = 1.0 / sqrt(max(1.0 - beta * beta, 1e-12));
    float delta = 1.0 / max(gamma * (1.0 - beta * cosTheta), 1e-9);
    float rEmitLegacy = (P.G * P.M) / max(vNorm * vNorm, 1e-30);
    rEmitLegacy = max(rEmitLegacy, P.rs * 1.0001);
    float rObs = max(length(P.camPos), 1.0001 * P.rs);
    float gravNum = clamp(1.0 - P.rs / rEmitLegacy, 1e-8, 1.0);
    float gravDen = clamp(1.0 - P.rs / rObs, 1e-8, 1.0);
    float gGr = sqrt(clamp(gravNum / gravDen, 1e-8, 4.0));
    return clamp(delta * gGr, 1e-4, 1e4);
}

static inline ThinSpectralEmission comp_thin_spectral_emission(const CollisionInfo rec,
                                                               constant Params& P,
                                                               constant ComposeParams& C)
{
    ThinSpectralEmission e;
    e.g = comp_frequency_shift_from_record(rec, P, C);
    e.tEmit = max(rec.T, 1.0);
    e.bodyRgb = float3(0.0);
    e.skinRgb = float3(0.0);
    e.coronaRgb = float3(0.0);
    e.bodyRatio = 1.0;
    e.skinRatio = 0.0;
    e.coronaRatio = 0.0;
    e.atlasActivity = 0.0;
    e.densityProxy = 0.0;
    e.temperatureProxy = 0.0;
    e.emissivityProxy = 0.0;
    e.opacityProxy = 0.0;
    e.tauProxy = 0.0;
    e.transferSaturation = 0.0;
    e.spiralProxy = 0.0;
    e.clumpProxy = 0.0;
    e.hotCrescentProxy = 0.0;
    float fColUsed = 1.0;
    float atlasTempRatio = 1.0;
    bool thinVisibleReference = false;
    if ((comp_thin_physical_active(C) || comp_thin_hybrid_debug_active(C)) && FC_PHYSICS_MODE == 0u) {
        float rNorm = comp_emit_radius_norm(rec, P);
        float fCol = (C.realismProfile >= 2u || comp_thin_hybrid_debug_active(C)) ? max(P.diskColorFactor, 1.24) : max(P.diskColorFactor, 1.0);
        float fluxTaper = comp_thin_outer_flux_taper(rNorm, P);
        float teff = thin_teff(rNorm, P);
        if ((P.visibleTeffModel == 3u || P.visibleTeffModel == 4u)) {
            thinVisibleReference = true;
            // Thin visible reference mode: use the NT-like flux shape normalized
            // by user-facing T0/r0 instead of mdot/geometry units. Ray-disk
            // intersection, Kerr g-factor, and blackbody transport remain shared
            // with the strict thin path; only the local photosphere temperature
            // calibration is switched to an explicit visible reference model.
            teff = disk_visible_teff(rNorm * max(P.rs, 1e-6), P);
        }
        float ntT = teff * pow(max(fluxTaper, 0.0), 0.25) * fCol;
        if (ntT > 1.0 && isfinite(ntT)) {
            atlasTempRatio = comp_atlas_temperature_ratio(rec.T, ntT / max(fCol, 1.0), P);
            // In thin-visible-reference + GRMHD atlas mode, the analytic
            // photosphere remains the body. The atlas is allowed to add a
            // positive hot-skin source below, but it must not lower/carve the
            // photospheric temperature and recreate contour-like dark grooves.
            e.tEmit = (thinVisibleReference && P.diskAtlasMode != 0u) ? ntT : (ntT * atlasTempRatio);
            fColUsed = fCol;
        }
    }
    // For thermal emission, evaluating the observed band at T_obs = g*T_emit is
    // equivalent to applying Liouville invariance: I_nu/nu^3 is conserved
    // (and I_lambda/lambda^5 in wavelength form). Do not add another Doppler
    // brightness multiplier after this path.
    e.tObserved = max(e.tEmit * e.g, 1.0);
    e.colorDilution = (fColUsed > 1.0) ? (1.0 / pow(fColUsed, 4.0)) : 1.0;
    if (FC_PHYSICS_MODE == 2u) {
        float fCol = max(P.diskColorFactor, 1.0);
        e.colorDilution = 1.0 / pow(fCol, 4.0);
    }

    e.rgb = comp_visible_blackbody_rgb_from_observed_temp(e.tObserved, e.colorDilution, C);
    float3 dWorld = rec.direct_world.xyz;
    float mu = abs(dWorld.z) / max(length(dWorld), 1e-30);
    e.rgb *= comp_limb_factor(mu, P);
    e.bodyRgb = e.rgb;
    if (thinVisibleReference && (C.realismProfile == 5u || C.realismProfile == 6u)) {
        float rNorm = comp_emit_radius_norm(rec, P);
        float rs = max(P.rs, 1e-6);
        float rInNorm = max(disk_inner_radius_m(P) / rs, 1.0001);
        float rOutNorm = max(P.re / rs, rInNorm + 1e-4);
        float uOuter = clamp((rNorm - rInNorm) / max(rOutNorm - rInNorm, 1e-4), 0.0, 1.0);
        float phi = comp_emit_phi(rec);
        float bodyLum0 = dot(max(e.bodyRgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        bool validDiskSource = rNorm > rInNorm && rNorm < rOutNorm && bodyLum0 > 1e-30;

        // Plausible-disk-v1 in the thin reference path:
        // keep the analytic photosphere as the luminous energy backbone, then
        // add positive disk-coordinate heating packets as a hot skin. This is
        // source emissivity, not albedo/normal/screen-space texture.
        if (validDiskSource) {
            float turbulence = clamp(P.diskTurbulence, 0.0, 2.4);
            float turbulenceTune = clamp((turbulence - 1.6) / 0.8, -1.0, 1.0);
            float radialGate = smoothstep(rInNorm + 0.18, rInNorm + 1.20, rNorm)
                             * (1.0 - smoothstep(0.68, 0.98, uOuter));
            bool pcdMode = (C.realismProfile == 6u);
            float pcdDensityExp = clamp(P.pcdSourceA.x, 0.3, 3.0);
            float pcdEmissivityScale = clamp(P.pcdSourceA.y, 0.1, 5.0);
            float pcdOpacityScale = clamp(P.pcdSourceA.z, 0.0, 6.0);
            float pcdStructureScale = clamp(P.pcdSourceB.x, 0.2, 3.0);
            float pcdSpiralAmp = clamp(P.pcdSourceB.y, 0.0, 1.0);
            float pcdSpiralPitch = clamp(P.pcdSourceB.z, 0.5, 14.0);
            float pcdClumpContrast = clamp(P.pcdSourceB.w, 0.0, 1.0);
            float pcdHotCrescent = clamp(P.pcdSourceC.x, 0.0, 1.0);
            float rRatio = max(rNorm / max(rInNorm, 1e-4), 1.0);
            float pcdDensity = clamp(radialGate * exp(-pcdDensityExp * log(rRatio)) * max(comp_thin_outer_flux_taper(rNorm, P), 0.0) * 1.32,
                                     0.0,
                                     1.0);
            float pcdLogR = log(max(rRatio, 1.0001));
            float pcdOmega = max(P.diskOrbitalBoost, 0.05) * pow(max(rNorm, 1.0), -1.5);
            float pcdPhase = 6.28318530718 * fract(P.pcdSourceA.w * 0.013579 + 0.173);
            float pathRsLocal = abs(rec.ct) / max(P.rs, 1e-6);
            // Higher-order lensed images should preserve the analytic body but
            // average unresolved skin heating. Otherwise the same source
            // fluctuation is stretched into contour-like caustic strokes.
            float unresolvedAverage = mix(1.0, 0.36, smoothstep(42.0, 118.0, pathRsLocal));
            float gBoost = smoothstep(0.85, 1.65, e.g);
            float innerWeight = exp(-pow(max((rNorm - rInNorm) / 3.2, 0.0), 0.82));
            // Energy-budgeted canonical source: redistribute the same local disk
            // flux into a photospheric body, positive hot skin, and weak corona.
            // This avoids reintroducing a global smooth floor while preventing the
            // skin branch from merely adding texture on top of a saturated body.
            float3 bodyShape = e.bodyRgb / max(bodyLum0, 1e-30);

            // Shutter-time temporal integration. Geodesics, the stationary flow
            // field, the g-factor, and the analytic photosphere are
            // time-independent; only the advected heating pattern moves during
            // the exposure, so the shutter average is taken over the resulting
            // radiance branches (not over the heating field, which would skip
            // the nonlinear field-to-radiance response).
            uint mbSamples = 1u;
            float mbSpan = max(P.motionBlurParams.y, 0.0);
            if (P.motionBlurParams.x > 1.5 && mbSpan > 1e-9) {
                mbSamples = uint(clamp(P.motionBlurParams.x, 1.0, 64.0));
            }
            float invSamples = 1.0 / float(mbSamples);

            float3 bodyAcc = float3(0.0);
            float3 skinAcc = float3(0.0);
            float3 coronaAcc = float3(0.0);
            float activityAcc = 0.0;
            float emissivityProxyAcc = 0.0;
            float opacityProxyAcc = 0.0;
            float tauProxyAcc = 0.0;
            float transferSaturationAcc = 0.0;
            float spiralProxyAcc = 0.0;
            float clumpProxyAcc = 0.0;
            float hotCrescentProxyAcc = 0.0;

            // Slow light: the photons arriving now left the disk one
            // light-travel time ago, and that time differs across the image
            // (rs/c is ~0.5 s for the geometry-default hole, path-length
            // spreads are tens of rs, the ISCO period is ~23 s - the same
            // order). Offsetting the emission time by the per-hit path time
            // |ct|/c (one flow-time unit = sqrt(2) rs / c) replaces the
            // fast-light approximation for the time-dependent source: the
            // higher-order lensed images now show the turbulent pattern as it
            // was when their longer paths left the disk - the photon-ring
            // time echo. The constant camera-distance part is a harmless
            // common-mode phase.
            float lightTravelOffset = -abs(rec.ct) / (1.4142135624 * max(P.rs, 1e-6));

            for (uint mb = 0u; mb < mbSamples; ++mb) {
                float flowOffset = lightTravelOffset
                    + ((mbSamples > 1u)
                        ? mbSpan * ((float(mb) + 0.5) * invSamples - 0.5)
                        : 0.0);
                ThinSpectralHeatingField heat = comp_thin_spectral_heating_field(rNorm, rInNorm, phi, flowOffset, P);
                float pcdSpiral = clamp(pcdSpiralAmp
                                      * comp_periodic01(cos(phi - pcdOmega * (P.diskFlowTime + flowOffset) - pcdSpiralPitch * pcdLogR + pcdPhase))
                                      * radialGate, 0.0, 1.0);
                float pcdClump = clamp(pcdClumpContrast * max(heat.cloud, heat.filament) * radialGate, 0.0, 1.0);
                float pcdHot = 0.0;

                float activityBase = clamp(0.60 * heat.activity + 0.14 * heat.cloud + 0.26 * heat.filament,
                                           0.0, 1.0);
                // Make skin support more intermittent without changing it into a
                // subtractive texture. The skin still receives positive emissivity
                // only; this remaps broad heating into localized dissipation patches
                // while preserving the clean thermal body.
                float activityIntermittent = pow(max(activityBase, 0.0), 1.58);
                float filamentSupport = smoothstep(0.22, 0.86, max(heat.cloud, heat.filament));
                float activity = clamp(activityIntermittent
                                     * (0.72 + 0.28 * filamentSupport)
                                     * radialGate
                                     * unresolvedAverage, 0.0, 1.0);
                if (pcdMode) {
                    activity = clamp(pcdStructureScale
                                   * (0.42 * activity
                                    + 0.24 * pcdSpiral
                                    + 0.24 * pcdClump
                                    + 0.10 * heat.filament)
                                   * radialGate, 0.0, 1.0);
                }
                float pcdPositiveHeatingLift = 1.0;
                if (pcdMode) {
                    // Profile 6 is a physics-constrained surrogate, not a material
                    // texture. Dense spiral/clump/hot-crescent support represents
                    // extra local dissipation in the emitting layer, so it may add
                    // radiance but must not subtract from or carve the photosphere.
                    pcdPositiveHeatingLift += clamp(radialGate
                                                  * (0.96 * activity
                                                   + 0.26 * pcdSpiral
                                                   + 0.36 * pcdClump
                                                   + 0.52 * pcdHot),
                                                  0.0,
                                                  1.65);
                }

                float bodyHeat = 1.0 + clamp((0.010 + 0.018 * turbulence) * heat.low, 0.0, 0.055);

                pcdHot = clamp(pcdHotCrescent * innerWeight * radialGate * smoothstep(1.0, 1.55, e.g), 0.0, 1.0);
                float fCorona = radialGate
                               * innerWeight
                               * (0.024 + 0.045 * heat.cloud + 0.024 * heat.filament)
                               * (0.55 + 0.45 * activity)
                               * (1.0 + 0.35 * turbulenceTune);
                if (pcdMode) {
                    fCorona += 0.020 * pcdHot;
                }
                fCorona = clamp(fCorona, 0.0, 0.045);

                float fSkin = radialGate
                            * unresolvedAverage
                            * (0.004
                             + 0.520 * activity
                             + 0.060 * heat.cloud * activity
                             + 0.320 * heat.filament * smoothstep(0.06, 0.46, activity))
                            * (1.0 + 0.18 * turbulenceTune)
                            * (0.82 + 0.18 * gBoost);
                if (pcdMode) {
                    fSkin *= 1.0 + 0.85 * activity + 0.35 * pcdSpiral + 0.25 * pcdClump + 0.20 * pcdHot;
                    fSkin += radialGate * unresolvedAverage
                           * (0.040 * activity
                            + 0.020 * pcdSpiral
                            + 0.032 * pcdClump
                            + 0.028 * pcdHot);
                }
                fSkin = clamp(fSkin, 0.0, pcdMode ? 0.480 : 0.180);
                float fBody = clamp(1.0 - fSkin - fCorona, pcdMode ? 0.52 : 0.75, 1.0);
                float fNorm = max(fBody + fSkin + fCorona, 1e-6);
                fBody /= fNorm;
                fSkin /= fNorm;
                fCorona /= fNorm;

                float sourceScale = pcdMode ? (pcdEmissivityScale * max(pcdDensity, 0.05 * radialGate) * pcdPositiveHeatingLift) : 1.0;
                bodyAcc += bodyShape * bodyLum0 * bodyHeat * sourceScale * fBody;

                float skinObservedTemp = e.tObserved * (1.58
                                                     + (1.94 + 0.12 * turbulenceTune) * activity
                                                     + 0.34 * heat.filament
                                                     + 0.10 * gBoost);
                float3 skinShape = comp_visible_blackbody_rgb_from_observed_temp(skinObservedTemp, e.colorDilution, C)
                                 * comp_limb_factor(mu, P);
                float skinLum = dot(max(skinShape, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
                skinShape /= max(skinLum, 1e-30);
                // The branch split is an energy-budget proxy, but the sensor sees a
                // visible band. A hotter skin should therefore change not only hue
                // but also visible-band radiance efficiency. Keep this bounded so a
                // high-temperature filament cannot become a new white membrane.
                float skinVisibleGain = clamp(pow(max(skinLum / max(bodyLum0, 1e-30), 1e-6), 0.16),
                                              0.86,
                                              1.18);
                // Local magnetic/reconnection heating can raise the visible skin
                // above a pure photospheric flux split. Keep it bounded and driven
                // by positive disk-coordinate activity so it reads as self-emissive
                // hot plasma, not subtractive surface texture.
                float skinDissipationLift = 1.0 + clamp(radialGate
                                                      * unresolvedAverage
                                                      * (0.56 * activity
                                                       + 0.04 * heat.cloud
                                                       + 0.56 * heat.filament),
                                                      0.0,
                                                      pcdMode ? 1.85 : 0.92);
                if (pcdMode) {
                    skinDissipationLift *= 1.0 + clamp(radialGate
                                                     * (0.55 * activity
                                                      + 0.18 * pcdSpiral
                                                      + 0.30 * pcdClump
                                                      + 0.42 * pcdHot),
                                                     0.0,
                                                     1.20);
                }
                skinAcc += skinShape * bodyLum0 * bodyHeat * sourceScale * fSkin * skinDissipationLift * skinVisibleGain;
                float3 coronaShape = normalize(float3(0.74, 0.90, 1.16));
                float coronaShapeLum = dot(coronaShape, float3(0.2126, 0.7152, 0.0722));
                coronaShape /= max(coronaShapeLum, 1.0e-6);
                coronaAcc += coronaShape * bodyLum0 * bodyHeat * sourceScale * fCorona * (0.85 + 0.15 * innerWeight);

                activityAcc += activity;
                if (pcdMode) {
                    float pcdOpacity = pcdOpacityScale * pcdDensity * (0.55 + 0.30 * pcdSpiral + 0.15 * pcdClump);
                    float pcdTau = clamp(pcdOpacity / max(mu, 0.22), 0.0, 4.0);
                    emissivityProxyAcc += clamp(pcdEmissivityScale * pcdDensity * (1.0 + 0.55 * activity), 0.0, 2.2);
                    opacityProxyAcc += clamp(pcdOpacity, 0.0, 4.0);
                    tauProxyAcc += pcdTau;
                    // The visible thin-disk surrogate is intentionally mostly thin;
                    // use lower tau thresholds for the saturation diagnostic so
                    // high/low opacity controls are visible before the source is
                    // numerically blacked out by a thick-screen approximation.
                    float opacityScaleSupport = smoothstep(0.45, 1.80, pcdOpacityScale);
                    transferSaturationAcc += radialGate * opacityScaleSupport * smoothstep(0.15, 0.30, pcdTau);
                    spiralProxyAcc += pcdSpiral;
                    clumpProxyAcc += pcdClump;
                    hotCrescentProxyAcc += pcdHot;
                }
            }

            e.bodyRgb = bodyAcc * invSamples;
            e.skinRgb += skinAcc * invSamples;
            e.coronaRgb += coronaAcc * invSamples;
            e.rgb = e.bodyRgb + e.skinRgb + e.coronaRgb;
            float lumBody = dot(max(e.bodyRgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
            float lumSkin = dot(max(e.skinRgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
            float lumCorona = dot(max(e.coronaRgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
            float lumTotal = max(lumBody + lumSkin + lumCorona, 1e-30);
            e.bodyRatio = lumBody / lumTotal;
            e.skinRatio = lumSkin / lumTotal;
            e.coronaRatio = lumCorona / lumTotal;
            e.atlasActivity = max(e.atlasActivity, activityAcc * invSamples);
            if (pcdMode) {
                e.densityProxy = pcdDensity;
                e.temperatureProxy = clamp((log(max(e.tObserved, 1.0)) * 0.4342944819032518 - 3.0) / max(7.2 - 3.0, 1e-6), 0.0, 1.0);
                e.emissivityProxy = emissivityProxyAcc * invSamples;
                e.opacityProxy = opacityProxyAcc * invSamples;
                e.tauProxy = tauProxyAcc * invSamples;
                e.transferSaturation = transferSaturationAcc * invSamples;
                e.spiralProxy = spiralProxyAcc * invSamples;
                e.clumpProxy = clumpProxyAcc * invSamples;
                e.hotCrescentProxy = hotCrescentProxyAcc * invSamples;
            }
        }
    }
    if (thinVisibleReference && P.diskAtlasMode != 0u && P.diskAtlasDensityBlend > 1e-5) {
        float rNorm = comp_emit_radius_norm(rec, P);
        float rs = max(P.rs, 1e-6);
        float rInNorm = max(disk_inner_radius_m(P) / rs, 1.0001);
        float rOutNorm = max(P.re / rs, rInNorm + 1e-4);
        float uOuter = clamp((rNorm - rInNorm) / max(rOutNorm - rInNorm, 1e-4), 0.0, 1.0);
        float radialGate = smoothstep(rInNorm + 0.18, rInNorm + 1.35, rNorm)
                         * (1.0 - smoothstep(0.72, 0.98, uOuter));
        // In thin-visible-reference mode rec.noise stores a source-space
        // positive heating excess from the atlas sampler, not raw column density.
        // Use it as additive emissivity only; do not reinterpret it as albedo or
        // let it subtract from the analytic photosphere.
        float atlasActivity = clamp(rec.noise, 0.0, 1.0);
        float tempActivity = smoothstep(1.03, 1.22, atlasTempRatio)
                           * smoothstep(0.05, 0.55, atlasActivity);
        float activity = clamp(0.86 * atlasActivity + 0.14 * tempActivity, 0.0, 1.0);
        float gBoost = smoothstep(0.85, 1.65, e.g);
        float pathRsLocal = abs(rec.ct) / max(P.rs, 1e-6);
        float unresolvedHighOrder = smoothstep(54.0, 132.0, pathRsLocal);
        // Higher-order images near the critical curve retain the smooth
        // photospheric body, but sub-pixel hot-skin fluctuations should average
        // out. Otherwise a physically small heating field turns into artificial
        // contour rings.
        float skinVisibility = mix(1.0, 0.055, unresolvedHighOrder);
        float skinGain = clamp(P.diskAtlasDensityBlend, 0.0, 1.0)
                       * radialGate
                       * activity
                       * (0.065 + 0.460 * activity)
                       * (0.82 + 0.18 * gBoost)
                       * skinVisibility;
        float skinObservedTemp = e.tObserved * (1.13 + 0.82 * activity + 0.08 * gBoost);
        e.skinRgb += comp_visible_blackbody_rgb_from_observed_temp(skinObservedTemp, e.colorDilution, C)
                   * comp_limb_factor(mu, P)
                   * skinGain;
        e.rgb = e.bodyRgb + e.skinRgb + e.coronaRgb;
        float lumBody = dot(max(e.bodyRgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        float lumSkin = dot(max(e.skinRgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        float lumTotal = max(lumBody + lumSkin, 1e-30);
        e.bodyRatio = lumBody / lumTotal;
        e.skinRatio = lumSkin / lumTotal;
        e.coronaRatio = 0.0;
        e.atlasActivity = max(e.atlasActivity, activity * radialGate);
    }
    if (thinVisibleReference && P.rayBundleSSAA != 0u) {
        float coverage = clamp(rec.v_disk.w, 0.0, 1.0);
        e.bodyRgb *= coverage;
        e.skinRgb *= coverage;
        e.coronaRgb *= coverage;
        e.rgb *= coverage;
    }
    return e;
}

static inline ThinHybridRealismSample comp_thin_hybrid_sample(const CollisionInfo rec,
                                                             constant Params& P,
                                                             constant ComposeParams& C,
                                                             float cloudRaw)
{
    ThinHybridRealismConfig cfg = comp_thin_hybrid_config(P, C);
    ThinHybridRealismSample s;
    s.rNorm = comp_emit_radius_norm(rec, P);
    s.phi = comp_emit_phi(rec);
    s.g = clamp(comp_frequency_shift_from_record(rec, P, C), 0.05, 6.0);

    float rInNorm = max(disk_inner_radius_m(P) / max(P.rs, 1e-6), 1.0001);
    float rSpan = max(P.re / max(P.rs, 1e-6) - rInNorm, 1e-4);
    float uOuter = clamp((s.rNorm - rInNorm) / rSpan, 0.0, 1.0);
    s.outerFade = 1.0 - smoothstep(cfg.outerFadeStart, cfg.outerFadeEnd, uOuter);
    s.emissivity = comp_thin_nt_emissivity_norm(s.rNorm, P) * comp_thin_outer_flux_taper(s.rNorm, P);
    s.innerWeight = exp(-pow(max((s.rNorm - rInNorm) / 3.2, 0.0), 0.82));

    float cloudNorm = comp_cloud_norm_from_raw(clamp(cloudRaw, 0.0, 1.0), C);
    ThinDiskStructureSample micro = comp_thin_disk_structure(s.rNorm, rInNorm, s.phi, cloudNorm, P, cfg);
    float atlasBlend = (P.diskAtlasMode != 0u) ? clamp(P.diskAtlasDensityBlend, 0.0, 1.0) : 0.0;
    s.perturb = micro.perturb;
    s.density = micro.density;
    s.radialTau = micro.radialTau;

    float tempShift = micro.tempShift;
    float fCol = (C.realismProfile >= 2u || comp_thin_hybrid_debug_active(C)) ? max(P.diskColorFactor, 1.24) : max(P.diskColorFactor, 1.0);
    float fluxTaper = comp_thin_outer_flux_taper(s.rNorm, P);
    float baseTeff = (((P.visibleTeffModel == 3u || P.visibleTeffModel == 4u)) ? disk_visible_teff(s.rNorm * max(P.rs, 1e-6), P) : thin_teff(s.rNorm, P))
                   * pow(max(fluxTaper, 0.0), 0.25);
    float atlasTemp = comp_atlas_temperature_ratio(rec.T, baseTeff, P);
    s.observedTemp = max(baseTeff * atlasTemp * fCol * s.g * tempShift, 1.0);
    float colorDilution = 1.0 / pow(fCol, 4.0);

    float3 d = rec.direct_world.xyz;
    float mu = abs(d.z) / max(length(d), 1e-30);
    float3 rgb = comp_visible_blackbody_rgb_from_observed_temp(s.observedTemp, colorDilution, C);
    rgb *= comp_limb_factor(mu, P);

    float edge0 = rInNorm + max(0.045, 0.012 * rInNorm);
    float edge1 = rInNorm + max(0.560, 0.090 * rInNorm);
    float edgeGate = smoothstep(edge0, edge1, s.rNorm);
    // The NT radial flux is already represented by T_eff. Treat unresolved
    // density as optical depth/covering fraction, not unbounded luminosity:
    // optically thick thermal surface emission approaches B_nu(T).
    float surfaceTau = clamp(1.20 * micro.opacity * (0.72 + 0.28 * clamp(s.density / 1.6, 0.0, 1.0)), 0.0, 6.0);
    float surfaceEscape = 1.0 - exp(-surfaceTau / max(mu, 0.24));
    float surfaceCover = 0.62 + 0.38 * clamp(s.density / 1.65, 0.0, 1.0);
    // For GRMHD-derived atlases, cloudNorm is a robust log column/stress proxy,
    // not decorative noise. Use it as an unresolved photospheric covering/source
    // modulation so code-unit turbulent structure survives the hot blackbody
    // Rayleigh-Jeans compression without changing hue arbitrarily.
    float atlasSource = exp(clamp(2.15 * atlasBlend * (cloudNorm - 0.5), -1.00, 1.30));
    // Physical-flow keeps unresolved structure in the source/covering model
    // before spectral conversion. This is not an RGB overlay: it changes the
    // local thermal photosphere source carried into blackbody integration.
    float flowSource = 1.0;
    if (C.realismProfile == 4u && !(atlasBlend > 1e-5)) {
        float sourceContrast = 0.34 * (micro.filament - 0.5)
                             + 0.26 * (s.perturb - 0.5)
                             + 0.10 * (s.density - 1.0);
        flowSource = exp(clamp(sourceContrast, -0.16, 0.24));
    }
    s.beaming = clamp(pow(max(s.g, 1e-4), 3.0), 0.02, 16.0);
    s.photosphere = rgb * surfaceEscape * surfaceCover * atlasSource * flowSource * s.outerFade * edgeGate;

    float tau = cfg.atmosphereTau
              * (0.38 + 0.82 * s.innerWeight)
              * (0.42 + 0.58 * micro.opacity)
              / max(mu, 0.24);
    tau = clamp(tau, 0.0, 1.25);
    s.opticalDepth = tau;
    float trans = exp(-tau);
    float absorbed = 1.0 - trans;
    float3 warmSource = s.photosphere * cfg.atmosphereTint * (0.22 + 0.36 * s.perturb + 0.22 * micro.filament);
    s.atmosphere = warmSource * absorbed * (0.22 + 0.46 * s.outerFade);

    float coronaGeom = pow(clamp(s.innerWeight, 0.0, 1.0), 1.55) * pow(1.0 - clamp(mu, 0.0, 1.0), 0.55);
    float coronaLum = dot(s.photosphere, float3(0.2126, 0.7152, 0.0722));
    s.corona = cfg.coronaTint * coronaLum * cfg.coronaStrength * coronaGeom;

    if (C.realismProfile == 5u) {
        // Plausible-disk-v1 source model:
        // A clean optically thick thin/intermediate disk supplies the energy
        // backbone. A many-mode disk-coordinate spectral heating field splits
        // slow body heating from positive high-frequency skin activity. This is
        // source emissivity, not albedo/normal/screen texture.
        ThinSpectralHeatingField heat = comp_thin_spectral_heating_field(s.rNorm, rInNorm, s.phi, 0.0, P);
        float sigmaBody = clamp(0.020 + 0.020 * P.diskTurbulence, 0.010, 0.060);
        float bodyHeat = exp(clamp(sigmaBody * heat.low - 0.5 * sigmaBody * sigmaBody, -0.10, 0.12));
        float turbulence = clamp(P.diskTurbulence, 0.0, 2.0);
        float atlasActivity = smoothstep(0.54, 0.92, cloudNorm);
        float proceduralActivity = clamp(0.78 * heat.activity + 0.22 * heat.filament, 0.0, 1.0);
        float activity = clamp(mix(proceduralActivity, max(0.18 * proceduralActivity, atlasActivity), atlasBlend), 0.0, 1.0);
        float pathRsLocal = abs(rec.ct) / max(P.rs, 1e-6);
        float unresolvedAverage = mix(1.0, 0.22, smoothstep(72.0, 150.0, pathRsLocal));
        activity *= unresolvedAverage;
        bodyHeat *= exp(clamp(0.11 * atlasBlend * (cloudNorm - 0.5), -0.045, 0.075));
        float innerActive = smoothstep(0.20, 2.20, max(s.rNorm - rInNorm, 0.0))
                          * (1.0 - smoothstep(0.66, 0.98, uOuter));
        float skinBase = mix(0.010, 0.025, clamp(turbulence, 0.0, 1.0));
        float skinDynamic = mix(0.220, 0.360, clamp(turbulence, 0.0, 1.0));
        float cloudBoost = clamp(0.52 + 0.58 * heat.cloud + 0.42 * heat.filament, 0.52, 1.38);
        float fSkin = clamp((skinBase + skinDynamic * activity * cloudBoost) * innerActive, 0.0, 0.42);
        float fCorona = clamp(cfg.coronaStrength
                            * pow(clamp(s.innerWeight, 0.0, 1.0), 1.65)
                            * (0.30 + 0.70 * activity)
                            * (1.0 - smoothstep(0.55, 0.98, uOuter)),
                            0.0,
                            0.040);
        float fBody = clamp(1.0 - fSkin - fCorona, 0.58, 1.0);
        float norm = max(fBody + fSkin + fCorona, 1.0e-6);
        fBody /= norm;
        fSkin /= norm;
        fCorona /= norm;

        float baseLum0 = dot(max(rgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        float localDissipationLift = 1.0 + clamp((0.52 + 0.45 * turbulence) * activity * innerActive
                                               + (0.44 * heat.cloud + 0.34 * heat.filament) * innerActive, 0.0, 1.70);
        float baseLum = baseLum0 * bodyHeat * 1.08 * localDissipationLift;
        float3 bodyShape = rgb / max(baseLum0, 1.0e-30);

        float hSkin = mix(1.32, 2.95, clamp(0.24 + 0.48 * activity + 0.28 * heat.cloud, 0.0, 1.0));
        float3 skinBB = comp_visible_blackbody_rgb_from_observed_temp(s.observedTemp * hSkin, colorDilution, C)
                      * comp_limb_factor(mu, P);
        float skinLum = dot(max(skinBB, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        float3 skinShape = skinBB / max(skinLum, 1.0e-30);

        float3 coronaShape = normalize(float3(0.74, 0.90, 1.16));
        float coronaShapeLum = dot(coronaShape, float3(0.2126, 0.7152, 0.0722));
        coronaShape /= max(coronaShapeLum, 1.0e-6);

        float sourceGate = s.outerFade;
        s.photosphere = bodyShape * baseLum * fBody * sourceGate;
        s.atmosphere = skinShape * baseLum * fSkin * sourceGate;
        s.corona = coronaShape * baseLum * fCorona * sourceGate;
        s.opticalDepth = fSkin;
        s.density = fBody;
        s.radialTau = fCorona;
        s.perturb = clamp(max(activity, heat.cloud), 0.0, 1.0);
    }

    // Eye/observational presentation only: very long optical paths are usually
    // higher-order disk images near the critical curve. At single-ray sampling
    // they alias into dotted guide-line-like rings, so attenuate them as
    // unresolved sub-pixel energy. Strict scientific/debug paths and the
    // physical-flow photosphere model remain intact.
    float pathRs = abs(rec.ct) / max(P.rs, 1e-6);
    float highOrder = smoothstep(72.0, 150.0, pathRs);
    float highOrderVisibility = (C.realismProfile == 4u) ? 1.0 : mix(1.0, 0.28, highOrder);
    s.photosphere *= highOrderVisibility;
    s.atmosphere *= highOrderVisibility;
    s.corona *= highOrderVisibility;

    float selfShadow = (C.realismProfile == 5u) ? 1.0 : mix(1.0, 0.86, smoothstep(0.72, 1.25, tau) * (0.35 + 0.65 * s.innerWeight));
    float bodyTrans = (C.realismProfile == 5u) ? 1.0 : trans;
    s.finalRgb = max(s.photosphere * bodyTrans * selfShadow + s.atmosphere + s.corona, float3(0.0));
    return s;
}

static inline float3 comp_debug_ramp(float t) {
    t = clamp(t, 0.0, 1.0);
    return clamp(float3(1.65 * t - 0.20,
                        1.35 - abs(2.35 * t - 1.05),
                        1.30 * (1.0 - t) + 0.18 * t), 0.0, 1.0);
}

static inline float comp_canonical_abs_branch_debug_scale() {
    // PNG branch-isolated previews cannot carry the full HDR source range. Use
    // one fixed scale for total/body/skin/corona so these absolute branch views
    // are comparable to each other and cannot be mistaken for normalized maps.
    return 6.8e-18;
}

static inline float comp_grmhd_log_window_t(float raw, float logLo, float logHi) {
    float logLum = log(max(raw, 1e-38)) * 0.4342944819032518;
    return clamp((logLum - logLo) / max(logHi - logLo, 1e-6), 0.0, 1.0);
}

static inline float comp_grmhd_raw_log_debug_t(float lumRaw) {
    // Keep raw-log as a diagnostic range independent from the exposure
    // histogram. Calibrated GRMHD hot-flow radiance is intentionally far
    // below the older saturated 1e2...1e12 histogram range.
    return comp_grmhd_log_window_t(lumRaw, -8.0, 4.0);
}

static inline float comp_grmhd_visible_radiance_detail_t(float lumRaw) {
    // Detail view for the calibrated visible-reference photosphere. This is a
    // diagnostic-only narrower log window; it does not alter stored radiance.
    return comp_grmhd_log_window_t(lumRaw, -2.8, -1.2);
}

static inline float3 comp_thin_hybrid_debug_rgb(const ThinHybridRealismSample s,
                                                constant ComposeParams& C)
{
    if (C.analysisMode == 31u) { // raw g-factor / red-blue shift
        float t = clamp((log(max(s.g, 1e-6)) * 0.4342944819032518 + 0.70) / 1.40, 0.0, 1.0);
        return comp_debug_ramp(t);
    }
    if (C.analysisMode == 32u) return float3(clamp(s.emissivity / 2.2, 0.0, 1.0)); // NT radial emissivity
    if (C.analysisMode == 33u) { // transport beaming diagnostic, not an extra render multiplier
        float t = clamp((log(max(s.beaming, 1e-6)) * 0.4342944819032518 + 1.20) / 2.40, 0.0, 1.0);
        return comp_debug_ramp(t);
    }
    if (C.analysisMode == 34u) return s.photosphere;
    if (C.analysisMode == 35u) return s.atmosphere * 3.0;
    if (C.analysisMode == 36u) return s.corona * 8.0;
    if (C.analysisMode == 37u) return float3(s.perturb);
    if (C.analysisMode == 39u) {
        float lt = log(max(s.observedTemp, 1.0)) * 0.4342944819032518;
        return comp_debug_ramp(clamp((lt - 3.0) / max(7.2 - 3.0, 1e-6), 0.0, 1.0));
    }
    if (C.analysisMode == 40u) return comp_debug_ramp(clamp(s.opticalDepth / 1.35, 0.0, 1.0));
    if (C.analysisMode == 41u) return comp_debug_ramp(clamp((s.density - 0.22) / max(2.55 - 0.22, 1e-6), 0.0, 1.0));
    if (C.analysisMode == 42u) return comp_debug_ramp(clamp((s.radialTau - 0.18) / max(2.40 - 0.18, 1e-6), 0.0, 1.0));
    float lum = dot(s.finalRgb, float3(0.2126, 0.7152, 0.0722)); // pre-tone HDR luminance
    float t = clamp((log(max(lum, 1e-30)) * 0.4342944819032518 - C.lumLogMin) / max(C.lumLogMax - C.lumLogMin, 1e-6), 0.0, 1.0);
    return comp_debug_ramp(t);
}

static inline float3 comp_thin_physical_debug_rgb(const CollisionInfo rec,
                                                  ThinSpectralEmission thin,
                                                  constant Params& P,
                                                  constant ComposeParams& C)
{
    float rNorm = comp_emit_radius_norm(rec, P);
    if (C.analysisMode == 31u) { // strict physical g-factor / red-blue shift
        float t = clamp((log(max(thin.g, 1e-6)) * 0.4342944819032518 + 0.70) / 1.40, 0.0, 1.0);
        return comp_debug_ramp(t);
    }
    if (C.analysisMode == 32u) {
        if (C.realismProfile == 6u) return comp_debug_ramp(clamp(thin.emissivityProxy / 2.2, 0.0, 1.0));
        float e = comp_thin_nt_emissivity_norm(rNorm, P) * comp_thin_outer_flux_taper(rNorm, P);
        return float3(clamp(e / 2.2, 0.0, 1.0));
    }
    if (C.analysisMode == 33u) { // transport beaming diagnostic, not an extra render multiplier
        float beaming = clamp(pow(max(thin.g, 1e-4), 3.0), 0.02, 16.0);
        float t = clamp((log(max(beaming, 1e-6)) * 0.4342944819032518 + 1.20) / 2.40, 0.0, 1.0);
        return comp_debug_ramp(t);
    }
    if (C.analysisMode == 34u) return thin.bodyRgb * comp_canonical_abs_branch_debug_scale(); // absolute body radiance preview
    if (C.analysisMode == 35u) return thin.skinRgb * comp_canonical_abs_branch_debug_scale(); // absolute positive hot-skin radiance preview
    if (C.analysisMode == 36u) {
        if (C.realismProfile == 5u || C.realismProfile == 6u) return thin.coronaRgb * comp_canonical_abs_branch_debug_scale(); // absolute weak corona radiance preview
        return comp_debug_ramp(clamp(thin.atlasActivity, 0.0, 1.0));
    }
    if (C.analysisMode == 37u) {
        if (C.realismProfile == 5u || C.realismProfile == 6u) {
            return clamp(float3(thin.bodyRatio, thin.skinRatio, thin.coronaRatio), 0.0, 1.0);
        }
        return comp_debug_ramp(clamp(thin.skinRatio / 0.25, 0.0, 1.0));
    }
    if (C.analysisMode == 38u) return thin.rgb * comp_canonical_abs_branch_debug_scale(); // absolute total radiance preview, pre-tone-map
    if (C.analysisMode == 39u) {
        if (C.realismProfile == 6u) return comp_debug_ramp(thin.temperatureProxy);
        float lt = log(max(thin.tObserved, 1.0)) * 0.4342944819032518;
        return comp_debug_ramp(clamp((lt - 3.0) / max(7.2 - 3.0, 1e-6), 0.0, 1.0));
    }
    if (C.analysisMode == 40u && C.realismProfile == 6u) {
        return comp_debug_ramp(clamp(thin.tauProxy / 4.0, 0.0, 1.0));
    }
    if (C.analysisMode == 41u && C.realismProfile == 6u) {
        return comp_debug_ramp(clamp(thin.densityProxy, 0.0, 1.0));
    }
    if (C.analysisMode == 42u && C.realismProfile == 5u) {
        return float3(clamp(thin.atlasActivity, 0.0, 1.0));
    }
    if (C.analysisMode == 42u && C.realismProfile == 6u) {
        uint field = uint(clamp(P.pcdSourceC.y, 0.0, 5.0) + 0.5);
        if (field == 1u) return comp_debug_ramp(clamp(thin.opacityProxy / 4.0, 0.0, 1.0));
        if (field == 2u) return float3(clamp(thin.transferSaturation, 0.0, 1.0));
        if (field == 3u) return comp_debug_ramp(clamp(thin.spiralProxy, 0.0, 1.0));
        if (field == 4u) return comp_debug_ramp(clamp(thin.clumpProxy, 0.0, 1.0));
        if (field == 5u) return comp_debug_ramp(clamp(thin.hotCrescentProxy, 0.0, 1.0));
        return comp_debug_ramp(clamp(thin.atlasActivity, 0.0, 1.0));
    }

    // Remaining atmosphere/corona/tau/density maps are hybrid presentation
    // diagnostics. In strict scientific mode, show black rather than silently
    // enabling phenomenological structure.
    return float3(0.0);
}

static inline float3 comp_linear_rgb_precloud(const CollisionInfo rec,
                                              constant Params& P,
                                              constant ComposeParams& C)
{
    bool precisionVolumeDebug = (FC_PHYSICS_MODE == 2u &&
                                 P.diskVolumeMode != 0u &&
                                 ((C.analysisMode >= 11u && C.analysisMode <= 16u) ||
                                  C.analysisMode == 19u ||
                                  (C.analysisMode >= 20u && C.analysisMode <= 30u) ||
                                  (C.analysisMode >= 33u && C.analysisMode <= 72u) ||
                                  C.analysisMode == 65u));
    if (FC_PHYSICS_MODE == 3u || precisionVolumeDebug) {
        if (C.analysisMode == 65u) { // physical hit mask
            return float3(1.0);
        }
        if (C.analysisMode >= 11u && C.analysisMode <= 14u) {
            float raw = 0.0;
            float lo = -30.0;
            float hi = 2.0;
            if (C.analysisMode == 11u) {
                raw = max(rec.emit_r_norm, 0.0); // max_rho
                lo = -16.0;
                hi = 2.0;
            } else if (C.analysisMode == 12u) {
                raw = max(rec.emit_phi, 0.0); // max_b2
                lo = -20.0;
                hi = 4.0;
            } else if (C.analysisMode == 13u) {
                raw = max(rec.emit_z_norm, 0.0); // max_jnu
                lo = (FC_PHYSICS_MODE == 3u) ? -4.0 : -40.0;
                hi = (FC_PHYSICS_MODE == 3u) ? 12.0 : -20.0;
            } else if (C.analysisMode == 14u) {
                raw = max(rec.noise, 0.0); // max_inu
                lo = (FC_PHYSICS_MODE == 3u) ? 2.0 : -40.0;
                hi = (FC_PHYSICS_MODE == 3u) ? 12.0 : -20.0;
            }
            float lv = log(max(raw, 1e-38)) * 0.4342944819032518;
            float t = clamp((lv - lo) / max(hi - lo, 1e-6), 0.0, 1.0);
            return float3(t);
        }
        if (C.analysisMode == 15u) { // Teff map
            float raw = max(rec.T, 1.0);
            float lv = log(max(raw, 1e-38)) * 0.4342944819032518;
            float t = clamp((lv - 2.0) / max(7.0 - 2.0, 1e-6), 0.0, 1.0);
            return float3(t);
        }
        if (C.analysisMode == 16u) { // g-factor map
            float raw = clamp(rec.v_disk.x, 1e-6, 1e6);
            float lv = log(max(raw, 1e-38)) * 0.4342944819032518;
            float lo = (FC_PHYSICS_MODE == 3u) ? -0.38 : -2.0;
            float hi = (FC_PHYSICS_MODE == 3u) ? 0.28 : 2.0;
            float t = clamp((lv - lo) / max(hi - lo, 1e-6), 0.0, 1.0);
            return float3(t);
        }
        if (C.analysisMode == 19u) { // linear polarization fraction map
            float p = clamp(rec.noise, 0.0, 1.0);
            return float3(p);
        }
        if ((C.analysisMode >= 20u && C.analysisMode <= 30u) ||
            (C.analysisMode >= 33u && C.analysisMode <= 64u) ||
            (C.analysisMode >= 66u && C.analysisMode <= 72u)) {
            float raw = max(rec.emit_r_norm, 0.0);
            if (C.analysisMode == 30u) { // raw post-transfer radiance/luminance
                return float3(raw);
            }
            if (C.analysisMode == 23u) { // fluid speed proxy |v|/c
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            }
            if (C.analysisMode == 28u) { // invalid-value sample count
                return (raw > 0.0) ? float3(1.0, 0.0, 0.0) : float3(0.0);
            }
            float lo = -4.0;
            float hi = 3.0;
            if (C.analysisMode == 20u) { // electron temperature theta_e = kT_e / m_e c^2
                lo = -4.0;
                hi = 3.0;
            } else if (C.analysisMode == 21u) { // code-unit magnetization proxy B^2/rho
                lo = -8.0;
                hi = 8.0;
            } else if (C.analysisMode == 22u) { // code-unit inverse plasma-beta proxy B^2/(rho theta_e)
                lo = -8.0;
                hi = 8.0;
            } else if (C.analysisMode == 24u) { // Lorentz factor from sampled velocity proxy
                lo = 0.0;
                hi = 2.0;
            } else if (C.analysisMode == 25u) { // integrated optical-depth proxy
                lo = -3.0;
                hi = 2.0;
            } else if (C.analysisMode == 26u) { // absorption alpha_nu / opacity proxy
                // GRMHD visible-thermal runs can accumulate very large code-unit
                // alpha maxima before tau is clamped. Center the default alpha map
                // on the active high-column range instead of saturating it white.
                lo = 6.0;
                hi = 10.0;
            } else if (C.analysisMode == 27u) { // active contributing sample count
                lo = 0.0;
                hi = 3.0;
            } else if (C.analysisMode == 29u) { // beaming proxy g^3
                lo = -0.90;
                hi = 0.80;
            } else if (C.analysisMode == 33u) { // thermal source function S_nu = j_nu / alpha_nu
                // Source-function diagnostics are code-unit transfer quantities,
                // not final luminance. The temperature-flow volume path currently
                // sits around log10(S_nu) ~= -13.5 with bright caustic/photosphere
                // samples approaching -10, so use a narrow diagnostic range that
                // reveals structure without changing the physical render.
                lo = -15.5;
                hi = -9.5;
            } else if (C.analysisMode == 34u) { // first tau=1 radius in r/rs
                if (!(raw > 0.0)) return float3(0.0);
                float rMin = max(P.diskVolumeRNormMin, 0.0);
                float rMax = max(P.diskVolumeRNormMax, rMin + 1e-6);
                return comp_debug_ramp(clamp((raw - rMin) / max(rMax - rMin, 1e-6), 0.0, 1.0));
            } else if (C.analysisMode == 35u) { // path length inside GRMHD medium to tau=1, in rs
                if (!(raw > 0.0)) return float3(0.0);
                return comp_debug_ramp(clamp(raw / 12.0, 0.0, 1.0));
            } else if (C.analysisMode == 36u) { // integrated optical-depth proxy, wide diagnostic range
                lo = -8.0;
                hi = 6.0;
            } else if (C.analysisMode == 37u) { // absorption alpha_nu / opacity proxy, wide diagnostic range
                lo = -2.0;
                hi = 10.5;
            } else if (C.analysisMode == 38u) { // emission-weighted radius in r/rs
                if (!(raw > 0.0)) return float3(0.0);
                float rMin = max(P.diskVolumeRNormMin, 0.0);
                float rMax = max(P.diskVolumeRNormMax, rMin + 1e-6);
                return comp_debug_ramp(clamp((raw - rMin) / max(rMax - rMin, 1e-6), 0.0, 1.0));
            } else if (C.analysisMode == 39u) { // |B| code-unit magnetic-field magnitude
                lo = -12.0;
                hi = 2.0;
            } else if (C.analysisMode == 40u) { // eps_abs = kappa_ff / (kappa_es + kappa_ff)
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 41u) { // base thermal opacity a_base
                lo = -24.0;
                hi = 8.0;
            } else if (C.analysisMode == 42u) { // cool absorber opacity a_cool
                lo = -24.0;
                hi = 8.0;
            } else if (C.analysisMode == 43u) { // thermal emissivity j_thermal
                lo = -6.0;
                hi = 14.0;
            } else if (C.analysisMode == 44u) { // optically thin synchrotron/proxy emissivity j_thin
                // The GRMHD commit stage stores line-integrated emissivity for
                // this view, not a local coefficient. Wide primitive dumps can
                // sit around log10(int j_thin ds)=6..13 after inner radial crop.
                lo = 5.0;
                hi = 12.5;
            } else if (C.analysisMode == 45u) { // thermal source S_thermal = eps_abs B_nu(T)
                lo = -5.8;
                hi = 3.0;
            } else if (C.analysisMode == 46u) { // thin-branch source diagnostic
                lo = -6.0;
                hi = 18.0;
            } else if (C.analysisMode == 47u) { // thin branch fraction after RT attenuation
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 48u) { // thin thermal photosphere weight
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 49u) { // thermal emissivity after thin weighting
                lo = -6.0;
                hi = 14.0;
            } else if (C.analysisMode == 50u) { // thermal alpha/tau before thin weighting
                // Line-integrated code-unit opacity in public GRMHD dumps is
                // extremely broad; center this diagnostic on high-column
                // structure rather than absolute SI opacity.
                lo = 15.0;
                hi = 18.5;
            } else if (C.analysisMode == 51u) { // thermal alpha/tau after thin weighting
                lo = 15.0;
                hi = 18.5;
            } else if (C.analysisMode == 52u) { // broad corona layer weight
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 53u) { // thermal cloud emissivity line integral
                lo = -6.0;
                hi = 14.0;
            } else if (C.analysisMode == 54u) { // thermal cloud contribution fraction after RT
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 55u) { // accumulated ray path length in rs
                raw = abs(rec.ct) / max(P.rs, 1e-6);
                lo = 0.6;
                hi = 2.35;
            } else if (C.analysisMode == 56u) { // camera-ray impact parameter in rs
                raw = max(rec.direct_world.w, 0.0);
                if (!(raw > 0.0)) return float3(0.0);
                return comp_debug_ramp(clamp(raw / 6.0, 0.0, 1.0));
            } else if (C.analysisMode == 58u) { // post-transfer thermal radiance contribution
                lo = -8.0;
                hi = 4.0;
            } else if (C.analysisMode == 59u) { // post-transfer cloud/skin radiance contribution
                lo = -8.0;
                hi = 4.0;
            } else if (C.analysisMode == 60u) { // post-transfer body/photosphere radiance contribution
                lo = -8.0;
                hi = 4.0;
            } else if (C.analysisMode == 61u) { // emission-weighted vertical layer |z|/r
                return comp_debug_ramp(clamp(raw / 0.18, 0.0, 1.0));
            } else if (C.analysisMode == 62u) { // emission-weighted body layer gate
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 63u) { // post-transfer corona radiance contribution
                lo = -8.0;
                hi = 4.0;
            } else if (C.analysisMode == 64u) { // local body/photosphere source proxy
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 66u) { // transfer saturation 1-exp(-tau)
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 67u) { // photospheric body fraction after transfer
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 68u) { // skin/corona balance after transfer
                return comp_debug_ramp(clamp(raw, 0.0, 1.0));
            } else if (C.analysisMode == 69u) { // visible raw radiance detail, narrow log window
                return comp_debug_ramp(comp_grmhd_visible_radiance_detail_t(raw));
            } else if (C.analysisMode == 70u) { // source-function detail, narrow log window
                return comp_debug_ramp(comp_grmhd_log_window_t(raw, -14.9, -14.3));
            } else if (C.analysisMode == 71u) { // pre-transfer emissivity detail, narrow log window
                return comp_debug_ramp(comp_grmhd_log_window_t(raw, -2.0, 2.0));
            } else if (C.analysisMode == 72u) { // post-transfer radiance detail, narrow log window
                return comp_debug_ramp(comp_grmhd_visible_radiance_detail_t(raw));
            } else if (C.analysisMode == 57u) { // max local GRMHD phi/field residual sampled by the ray
                return comp_debug_ramp(clamp(raw / 1.25, 0.0, 1.0));
            }
            float lv = log(max(raw, 1e-38)) * 0.4342944819032518;
            float t = clamp((lv - lo) / max(hi - lo, 1e-6), 0.0, 1.0);
            return comp_debug_ramp(t);
        }

        if (visible_mode_enabled_fc()) {
            if (rec.noise <= -50.0) {
                // Packed by GRMHD visible volume RT: emit_{r,phi,z} = linear XYZ.
                float3 xyzPacked = max(float3(rec.emit_r_norm, rec.emit_phi, rec.emit_z_norm), float3(0.0));
                float Y = xyzPacked.y;
                if (C.analysisMode == 17u) { // Y luminance map
                    float lv = log(max(Y, 1e-38)) * 0.4342944819032518;
                    float t = clamp((lv - C.lumLogMin) / max(C.lumLogMax - C.lumLogMin, 1e-6), 0.0, 1.0);
                    return float3(t);
                }
                if (C.analysisMode == 18u) { // approximate dominant wavelength map
                    float3 rgbPacked = max(comp_xyz_to_rgb(xyzPacked), float3(0.0));
                    float peakLamApprox = 520.0;
                    if (rgbPacked.x >= rgbPacked.y && rgbPacked.x >= rgbPacked.z) {
                        peakLamApprox = 650.0;
                    } else if (rgbPacked.z >= rgbPacked.x && rgbPacked.z >= rgbPacked.y) {
                        peakLamApprox = 425.0;
                    }
                    float w = clamp((peakLamApprox - 380.0) / 400.0, 0.0, 1.0);
                    float3 ramp = float3(
                        clamp(1.5 - abs(4.0 * w - 3.0), 0.0, 1.0),
                        clamp(1.5 - abs(4.0 * w - 2.0), 0.0, 1.0),
                        clamp(1.5 - abs(4.0 * w - 1.0), 0.0, 1.0)
                    );
                    return ramp;
                }
                xyzPacked *= comp_grmhd_visible_high_order_visibility(rec, P, C);
                return comp_xyz_to_rgb(xyzPacked);
            }

            float g_total = clamp(rec.v_disk.x, 1e-4, 1e4);
            float tEmit = max(rec.T, 1.0);
            float colorDilution = 1.0;
            if (P.visibleTeffModel == 2u) {
                float fCol = max(P.diskColorFactor, 1.0);
                tEmit *= fCol;
                colorDilution = 1.0 / pow(fCol, 4.0);
            }
            float X = 0.0;
            float Y = 0.0;
            float Z = 0.0;
            float yLum = 0.0;
            float peakLam = 380.0;
            bool useInuAnchor = (P.visiblePhotosphereRhoThreshold <= 0.0);
            float scalarI = max(rec.v_disk.w, 0.0);
            bool usedSpectralAnchors = false;
            if (useInuAnchor) {
                // Packed by trace pass in visible volumetric mode:
                // emit_{r,phi,z} = I_nu at CIE-fit anchors {650,520,425}nm (observer frame).
                float3 iNuVis = max(float3(rec.emit_r_norm, rec.emit_phi, rec.emit_z_norm), float3(0.0));
                if (dot(iNuVis, float3(1.0)) > 1e-30) {
                    comp_visible_xyz_from_three_band_inu(iNuVis, colorDilution, P, X, Y, Z, yLum, peakLam);
                    usedSpectralAnchors = true;
                }
            }

            if (!usedSpectralAnchors) {
                comp_visible_xyz_from_spectrum(tEmit, g_total, P, X, Y, Z, yLum, peakLam);
                X *= colorDilution;
                Y *= colorDilution;
                Z *= colorDilution;

                // Fallback amplitude anchor from scalar I_nu when spectral anchors are absent.
                if (useInuAnchor && scalarI > 1e-18) {
                    float nuObsRef = max(P.diskNuObsHz, 1e6);
                    float nuEmRef = nuObsRef / max(g_total, 1e-8);
                    float iNuPred = pow(g_total, 3.0) * comp_visible_iNu_emit(nuEmRef, tEmit, P) * colorDilution;
                    float amp = scalarI / max(iNuPred, 1e-38);
                    amp = clamp(amp, 0.0, 1e12);
                    X *= amp;
                    Y *= amp;
                    Z *= amp;
                }
            }

            if (C.analysisMode == 17u) { // Y luminance map
                float lv = log(max(Y, 1e-38)) * 0.4342944819032518;
                float t = clamp((lv - C.lumLogMin) / max(C.lumLogMax - C.lumLogMin, 1e-6), 0.0, 1.0);
                return float3(t);
            }
            if (C.analysisMode == 18u) { // spectrum peak wavelength map
                float w = clamp((peakLam - 380.0) / 400.0, 0.0, 1.0);
                float3 ramp = float3(
                    clamp(1.5 - abs(4.0 * w - 3.0), 0.0, 1.0),
                    clamp(1.5 - abs(4.0 * w - 2.0), 0.0, 1.0),
                    clamp(1.5 - abs(4.0 * w - 1.0), 0.0, 1.0)
                );
                return ramp;
            }
            float3 rgb = comp_xyz_to_rgb(float3(X, Y, Z));
            float3 d_world = rec.direct_world.xyz;
            float mu = abs(d_world.z) / max(length(d_world), 1e-30);
            float limb = comp_limb_factor(mu, P);
            return rgb * limb * comp_grmhd_visible_high_order_visibility(rec, P, C);
        }

        float iNu = max(rec.v_disk.w, 0.0);
        return float3(iNu);
    }

    if (FC_PHYSICS_MODE == 2u && P.diskVolumeMode != 0u && rec.noise <= -50.0) {
        float3 xyzPacked = max(float3(rec.emit_r_norm, rec.emit_phi, rec.emit_z_norm), float3(0.0));
        if (C.analysisMode == 17u) {
            float lv = log(max(xyzPacked.y, 1e-38)) * 0.4342944819032518;
            float t = clamp((lv - C.lumLogMin) / max(C.lumLogMax - C.lumLogMin, 1e-6), 0.0, 1.0);
            return float3(t);
        }
        return comp_xyz_to_rgb(xyzPacked);
    }

    ThinSpectralEmission thin = comp_thin_spectral_emission(rec, P, C);
    float3 rgb = thin.rgb;
    if (P.diskVolumeMode != 0u && FC_PHYSICS_MODE == 2u) {
        float volAmp = clamp(rec.v_disk.w, 0.0, 1.0);
        rgb *= (0.65 + 2.80 * volAmp);
    }

    if (C.spectralEncoding == 1u && FC_PHYSICS_MODE == 1u) {
        float rEmit = max(rec.v_disk.y, P.rs * 1.0001);
        float rIn = disk_inner_radius_m(P);
        float rH = disk_horizon_radius_m(P) * (1.0 + 2.0 * P.eps);
        float x = clamp((rEmit - rH) / max(rIn - rH, 1e-6), 0.0, 1.0);
        float xSoft = smoothstep(0.0, 1.0, x);
        float floor = 0.35 * clamp(P.diskPlungeFloor, 0.0, 1.0);
        float gate = floor + (1.0 - floor) * pow(max(xSoft, 1e-4), 2.2);
        rgb *= clamp(gate, 0.0, 1.0);
    }
    return rgb;
}

static inline float comp_cloud_raw_fast(float noise,
                                        float3 vDisk,
                                        constant Params& P,
                                        constant ComposeParams& C)
{
    float n = noise;
    if (abs(n) < 1e-6 && C.spectralEncoding == 0u) {
        n = comp_synthetic_noise(vDisk, P);
    }
    n = clamp(n, -1.0, 1.0);
    float raw = (n < -1e-6) ? clamp(0.5 + 0.5 * n, 0.0, 1.0) : clamp(n, 0.0, 1.0);
    if (P.diskNoiseModel == 1u) {
        raw = 0.5 + (raw - 0.5) * 0.46;
        raw = smoothstep(0.10, 0.90, raw);
        raw = 0.5 + (raw - 0.5) * 0.55;
    }
    return raw;
}

static inline float3 comp_linear_rgb_precloud_legacy_fast(float T_emit,
                                                          float3 vDisk,
                                                          float3 directWorld,
                                                          constant Params& P,
                                                          constant ComposeParams& C)
{
    float g_total = 1.0;
    if (C.spectralEncoding == 1u) {
        g_total = clamp(vDisk.x, 1e-4, 1e4);
    } else {
        float3 d = directWorld;
        float v_norm = length(vDisk);
        float d_norm = length(d);
        float dot_vd = dot(vDisk, d);
        float beta = clamp(v_norm / max(P.c, 1e-12), 0.0, 0.999999);
        float cos_theta = clamp(dot_vd / max(v_norm * d_norm, 1e-30), -1.0, 1.0);
        float gamma = 1.0 / sqrt(max(1.0 - beta * beta, 1e-12));
        float delta = 1.0 / max(gamma * (1.0 - beta * cos_theta), 1e-9);
        float r_emit_legacy = (P.G * P.M) / max(v_norm * v_norm, 1e-30);
        r_emit_legacy = max(r_emit_legacy, P.rs * 1.0001);
        float r_obs = max(length(P.camPos), 1.0001 * P.rs);
        float grav_num = clamp(1.0 - P.rs / r_emit_legacy, 1e-8, 1.0);
        float grav_den = clamp(1.0 - P.rs / r_obs, 1e-8, 1.0);
        float g_gr = sqrt(clamp(grav_num / grav_den, 1e-8, 4.0));
        g_total = clamp(delta * g_gr, 1e-4, 1e4);
    }

    float T_obs = max(T_emit * g_total, 1.0);
    float X = 0.0;
    float Y = 0.0;
    float Z = 0.0;
    float cX = 0.0;
    float cY = 0.0;
    float cZ = 0.0;
    bool kahan = (C.precisionMode != 0u);
    float step = max(C.spectralStep, 0.25);
    // dLambda in meters keeps Y in SI integrated spectral radiance,
    // consistent with the other spectral paths and the absolute photometric
    // calibration.
    float dLamM_legacy = step * 1e-9;
    for (float lam = 380.0; lam <= 750.001; lam += step) {
        float lam_m = lam * 1e-9;
        float x_bar, y_bar, z_bar;
        comp_cie_xyz_bar(lam, x_bar, y_bar, z_bar);
        float b = comp_planck_lambda(lam_m, T_obs) * dLamM_legacy;
        if (kahan) {
            float yx = b * x_bar - cX;
            float tx = X + yx;
            cX = (tx - X) - yx;
            X = tx;

            float yy = b * y_bar - cY;
            float ty = Y + yy;
            cY = (ty - Y) - yy;
            Y = ty;

            float yz = b * z_bar - cZ;
            float tz = Z + yz;
            cZ = (tz - Z) - yz;
            Z = tz;
        } else {
            X += b * x_bar;
            Y += b * y_bar;
            Z += b * z_bar;
        }
    }

    float3 rgb = comp_xyz_to_rgb(float3(X, Y, Z));
    float mu = abs(directWorld.z) / max(length(directWorld), 1e-30);
    rgb *= comp_limb_factor(mu, P);
    return rgb;
}

static inline float3 comp_linear_rgb_legacy_fast(float T_emit,
                                                 float3 vDisk,
                                                 float3 directWorld,
                                                 float noise,
                                                 constant Params& P,
                                                 constant ComposeParams& C,
                                                 thread float& cloudRaw)
{
    cloudRaw = comp_cloud_raw_fast(noise, vDisk, P, C);
    return comp_linear_rgb_precloud_legacy_fast(T_emit, vDisk, directWorld, P, C);
}

static inline float3 comp_linear_rgb(const CollisionInfo rec,
                                     constant Params& P,
                                     constant ComposeParams& C)
{
    if (FC_PHYSICS_MODE == 0u && comp_thin_realism_debug_active(C)) {
        if (comp_thin_hybrid_active(C)) {
            float cloudRaw = comp_cloud_raw(rec, P, C);
            ThinHybridRealismSample thin = comp_thin_hybrid_sample(rec, P, C, cloudRaw);
            return comp_thin_hybrid_debug_rgb(thin, C);
        }
        ThinSpectralEmission thin = comp_thin_spectral_emission(rec, P, C);
        return comp_thin_physical_debug_rgb(rec, thin, P, C);
    }

    if (FC_PHYSICS_MODE == 0u && comp_thin_hybrid_active(C)) {
        float cloudRaw = comp_cloud_raw(rec, P, C);
        ThinHybridRealismSample thin = comp_thin_hybrid_sample(rec, P, C, cloudRaw);
        return thin.finalRgb;
    }

    float3 rgb = comp_linear_rgb_precloud(rec, P, C);
    if (FC_PHYSICS_MODE == 0u && (P.visibleTeffModel == 3u || P.visibleTeffModel == 4u) && comp_thin_physical_active(C)) {
        // Thin visible reference is a source-formation path: the photospheric
        // body and optional atlas hot-skin perturbation are already encoded in
        // comp_thin_spectral_emission. Do not run the legacy cloud/noise
        // material multiplier afterward; that turns physical emissivity into
        // albedo-like surface shading and makes atlas activity darken the body.
        return rgb;
    }
    if (FC_PHYSICS_MODE == 3u) {
        if (visible_mode_enabled_fc() && C.analysisMode == 0u) {
            // GRMHD visible volume RT packs final linear XYZ into
            // emit_{r,phi,z} and marks rec.noise with a negative sentinel.
            // Do not reinterpret that sentinel as a cloud-density value here;
            // doing so turns already-integrated hot gas into a dark slab in the
            // presentation layer.
            if (rec.noise <= -50.0) {
                return rgb;
            }
            float texStrength = clamp(P.diskPrecisionTexture, 0.0, 1.0);
            if (texStrength > 1e-5) {
                float cloudRaw = comp_cloud_raw(rec, P, C);
                float cloud = comp_cloud_norm_from_raw(clamp(cloudRaw, 0.0, 1.0), C);
                float core = precise::pow(cloud, 1.18);
                float clump = precise::pow(core, 1.55);
                float vvoid = precise::pow(1.0 - cloud, 1.35);
                float density = 1.0 + texStrength * (0.26 * core - 0.14 * vvoid);
                rgb *= max(density, 0.08);
                rgb *= (1.0 + texStrength * 0.10 * clump);
                rgb.x *= (1.0 + texStrength * 0.035 * clump);
                rgb.z *= (1.0 - texStrength * 0.028 * clump);
            }
        }
        return rgb;
    }
    float cloudRaw = comp_cloud_raw(rec, P, C);
    if (FC_PHYSICS_MODE == 2u) {
        if (P.diskVolumeMode != 0u && rec.noise <= -50.0) {
            return rgb;
        }
        // Returning radiation is physics now: it enters the disk temperature at
        // the trace choke point (disk_returning_rad_enhancement), so no
        // interpreter-side brightness factor is applied here.
    }
    if (FC_PHYSICS_MODE == 1u || FC_PHYSICS_MODE == 2u) {
        if (C.analysisMode == 1u) return rgb;
        return comp_apply_precision_cloud_to_rgb(rgb, rec, P, C, cloudRaw);
    }
    if (C.analysisMode != 0u) return rgb;
    if (P.diskNoiseModel == 5u) {
        float cloud = clamp(cloudRaw, 0.0, 1.0);
        float density = 0.72 + 0.68 * cloud;
        float clump = precise::pow(cloud, 1.8);
        rgb *= density;
        rgb *= (1.0 + 0.20 * clump);
        rgb.x *= (1.0 + 0.06 * clump);
        rgb.z *= (1.0 - 0.04 * clump);
        return rgb;
    }
    if (P.diskNoiseModel == 1u) {
        // Perlin mode targets a softer cloud look: avoid strong stripe amplification.
        float cloud = comp_cloud_norm_from_raw(cloudRaw, C);
        float core = precise::pow(cloud, 1.06);
        float clump = precise::pow(core, 1.55);
        float vvoid = precise::pow(1.0 - cloud, 1.45);
        float density = 0.82 + 0.58 * core;
        rgb *= density;
        rgb *= (1.0 + 0.12 * clump);
        rgb *= (1.0 - 0.07 * vvoid);
        rgb.x *= (1.0 + 0.045 * clump);
        rgb.z *= (1.0 - 0.035 * clump);
        return rgb;
    }
    float cloud = comp_cloud_norm_from_raw(cloudRaw, C);
    return comp_apply_cloud_to_rgb(rgb, cloud);
}

static inline float3 comp_apply_linear_cloud_from_raw(float3 rgb,
                                                      float cloudRaw,
                                                      constant ComposeParams& C)
{
    if (comp_linear_rgb_is_final_sentinel(cloudRaw)) {
        return rgb;
    }
    if (FC_PHYSICS_MODE == 0u && C.diskNoiseModel == 5u) {
        float rawCloud = clamp(cloudRaw, 0.0, 1.0);
        float density = 0.72 + 0.68 * rawCloud;
        float clump = precise::pow(rawCloud, 1.8);
        rgb *= density;
        rgb *= (1.0 + 0.20 * clump);
        rgb.x *= (1.0 + 0.06 * clump);
        rgb.z *= (1.0 - 0.04 * clump);
        return rgb;
    }
    float cloud = comp_cloud_norm_from_raw(cloudRaw, C);
    if (FC_PHYSICS_MODE == 0u && C.diskNoiseModel == 1u) {
        float core = precise::pow(cloud, 1.06);
        float clump = precise::pow(core, 1.55);
        float vvoid = precise::pow(1.0 - cloud, 1.45);
        float density = 0.82 + 0.58 * core;
        rgb *= density;
        rgb *= (1.0 + 0.12 * clump);
        rgb *= (1.0 - 0.07 * vvoid);
        rgb.x *= (1.0 + 0.045 * clump);
        rgb.z *= (1.0 - 0.035 * clump);
        return rgb;
    }
    if (FC_PHYSICS_MODE == 0u && C.diskNoiseModel == 3u) {
        // Recovered f552-era cloud presentation: lower the density floor and
        // steepen clump response so the old procedural ring/stripe texture
        // remains visible after the modern GPU exposure solve.
        float c = clamp((cloud - 0.18) / 0.82, 0.0, 1.0);
        float core = precise::pow(c, 1.28);
        float clump = precise::pow(c, 2.65);
        float vvoid = precise::pow(1.0 - c, 1.35);
        float density = 0.34 + 1.62 * core;
        rgb *= density;
        rgb *= (1.0 + 0.42 * clump);
        rgb *= (1.0 - 0.24 * vvoid);
        rgb.x *= (1.0 + 0.10 * clump);
        rgb.z *= (1.0 - 0.06 * clump);
        return rgb;
    }
    return comp_apply_cloud_to_rgb(rgb, cloud);
}

static inline float comp_log10(float x) {
    return log(max(x, 1e-30)) * 0.4342944819032518;
}

static inline float comp_bayer8(uint x, uint y) {
    uint idx = ((y & 7u) << 3u) | (x & 7u);
    return ((float(BAYER8_LUT[idx]) + 0.5) / 64.0) - 0.5;
}

static inline float comp_hash01_u32(uint x, uint y, uint salt) {
    uint h = x * 1664525u + y * 1013904223u + salt * 374761393u + 0x9E3779B9u;
    h ^= (h >> 13u);
    h *= 1274126177u;
    h ^= (h >> 16u);
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

static inline float comp_hash_signed_u32(uint x, uint y, uint salt) {
    return 2.0 * comp_hash01_u32(x, y, salt) - 1.0;
}

static inline float3 comp_mul_rows(float3 v, float4 r0, float4 r1, float4 r2) {
    return float3(dot(v, r0.xyz), dot(v, r1.xyz), dot(v, r2.xyz));
}

static inline float3 comp_background_starfield_display(float3 dir, constant ComposeParams& C) {
    if (C.backgroundMode == 0u) return float3(0.0);

    float density = clamp(C.backgroundStarDensity, 0.0, 4.0);
    float strength = max(C.backgroundStarStrength, 0.0);
    float nebula = clamp(C.backgroundNebulaStrength, 0.0, 2.0);
    if (!(strength > 1e-6) && !(nebula > 1e-6)) return float3(0.0);

    float d2 = dot(dir, dir);
    float3 n = (d2 > 1e-20) ? normalize(dir) : float3(0.0, 0.0, 1.0);
    float phi = atan2(n.y, n.x);
    float u = fract(phi * (0.5 / M_PI));
    float v = acos(clamp(n.z, -1.0, 1.0)) * (1.0 / M_PI);

    float3 sky = float3(0.0);

    // Milky-way-like diffuse band to make gravitational lens distortion visible.
    float bandWidth = mix(0.22, 0.08, clamp(0.55 * nebula, 0.0, 1.0));
    float band = exp(-pow(abs(n.z) / max(bandWidth, 1e-4), 1.45));
    float dustA = fbm(n * 14.0 + float3(1.7, -2.4, 0.8));
    float dustB = fbm(n * 31.0 + float3(-4.2, 3.5, -1.9));
    float lane = smoothstep(0.40, 0.82, 0.62 * dustA + 0.38 * dustB);
    float neb = nebula * (0.02 + 0.30 * band * lane);
    sky += neb * float3(1.0, 0.93, 0.84);

    // Star layer A: dense faint stars.
    float cellA = mix(540.0, 2200.0, clamp(density * 0.25, 0.0, 1.0));
    float2 pA = float2(u * cellA, v * cellA * 0.62);
    float2 idA = floor(pA);
    float2 fA = fract(pA);
    float hA0 = comp_hash13(float3(idA, 17.13));
    float hA1 = comp_hash13(float3(idA, 89.31));
    float hA2 = comp_hash13(float3(idA, 137.47));
    float hA3 = comp_hash13(float3(idA, 221.77));
    float hA4 = comp_hash13(float3(idA, 311.23));
    float pStarA = clamp(0.0010 + 0.0038 * density, 0.0, 0.03);
    float onA = (hA0 < pStarA) ? 1.0 : 0.0;
    float2 cA = float2(hA1, hA2);
    float2 dA = fA - cA;
    float r2A = dot(dA, dA);
    float coreA = onA * exp(-r2A * (9000.0 + 12000.0 * hA1));
    float haloA = onA * exp(-r2A * (650.0 + 900.0 * hA2));
    float brightA = onA * (0.08 + 2.7 * pow(hA3, 9.0));
    float3 colA = mix(float3(1.08, 0.86, 0.68), float3(0.70, 0.82, 1.10), hA4);
    sky += strength * (1.8 * coreA + 0.12 * haloA) * brightA * colA;

    // Star layer B: sparse bright stars with weak diffraction-like spikes.
    float cellB = mix(150.0, 540.0, clamp(density * 0.25, 0.0, 1.0));
    float2 pB = float2(u * cellB, v * cellB * 0.85);
    float2 idB = floor(pB);
    float2 fB = fract(pB);
    float hB0 = comp_hash13(float3(idB, 12.71));
    float hB1 = comp_hash13(float3(idB, 44.93));
    float hB2 = comp_hash13(float3(idB, 98.51));
    float hB3 = comp_hash13(float3(idB, 166.2));
    float hB4 = comp_hash13(float3(idB, 255.8));
    float pStarB = clamp(0.00020 + 0.00090 * density, 0.0, 0.01);
    float onB = (hB0 < pStarB) ? 1.0 : 0.0;
    float2 cB = float2(hB1, hB2);
    float2 dB = fB - cB;
    float r2B = dot(dB, dB);
    float coreB = onB * exp(-r2B * (22000.0 + 24000.0 * hB1));
    float haloB = onB * exp(-r2B * (430.0 + 520.0 * hB2));
    float spikeB = onB * (exp(-abs(dB.x) * 90.0) * exp(-abs(dB.y) * 3.5)
                        + exp(-abs(dB.y) * 90.0) * exp(-abs(dB.x) * 3.5));
    float brightB = onB * (0.4 + 5.5 * pow(hB3, 12.0));
    float3 colB = mix(float3(1.10, 0.90, 0.74), float3(0.68, 0.80, 1.12), hB4);
    sky += strength * ((2.8 * coreB + 0.09 * haloB + 0.018 * spikeB) * brightB) * colB;

    return clamp(sky, 0.0, 4.0);
}

static inline float3 comp_background_linear(float3 dir, constant ComposeParams& C) {
    if (C.backgroundMode == 0u) return float3(0.0);
    float3 displayLike = comp_background_starfield_display(dir, C);
    // Background is authored in post-exposure-like domain for stable tuning.
    float invExposure = min(1.0 / max(C.exposure, 1e-30), 5.0e18);
    return displayLike * invExposure;
}

// Photon-statistics sensor noise, applied to the linear scene value at the
// full input resolution (each photosite gets independent statistics; the
// downsample average then behaves like binning, reducing noise by sqrt(N)).
//
// With the ISO 12232 absolute calibration the exposed linear value is
// H / H_sat, so the electron count at this exposure is exact:
//   N = rel * N_sat,  N_sat = cameraPhotonParams.x (host-computed:
//   min(QE * kappa * pitch^2 * 78/ISO, fullWell)).
// Shot noise is Poisson on N (Gaussian approximation), read noise / dark /
// DSNU add in quadrature (cameraPhotonParams.y, electrons), PRNU scales
// with N (cameraPhotonParams.z). The ADC clips at saturation, so the
// exposed value is hard-limited to 1.0 before the display curve - exactly
// what a digital sensor does to highlights.
static inline float3 comp_apply_photon_noise_scene(float3 rgbLin,
                                                   uint px,
                                                   uint py,
                                                   constant ComposeParams& C)
{
    if (!(C.cameraPhotonParams.w > 0.5)) return rgbLin;
    float nSat = max(C.cameraPhotonParams.x, 1.0);
    float readE = max(C.cameraPhotonParams.y, 0.0);
    float prnu = max(C.cameraPhotonParams.z, 0.0);
    float exposure = max(C.exposure, 1e-30);

    float3 rel = clamp(rgbLin * exposure, float3(0.0), float3(4.0));
    float3 nE = rel * nSat;
    float3 prnuE = prnu * nE;
    float3 sigmaE = sqrt(nE + float3(readE * readE) + prnuE * prnuE);

    // Two uniform [-1,1] hashes per channel give a triangular profile;
    // variance of each uniform is 1/3, so scale by sqrt(3/2) for unit
    // variance.
    float3 g1 = float3(
        comp_hash_signed_u32(px, py, 211u),
        comp_hash_signed_u32(px, py, 223u),
        comp_hash_signed_u32(px, py, 227u)
    );
    float3 g2 = float3(
        comp_hash_signed_u32(px, py, 229u),
        comp_hash_signed_u32(px, py, 233u),
        comp_hash_signed_u32(px, py, 239u)
    );
    float3 gauss = (g1 + g2) * 1.2247449;

    float3 noisyRel = (nE + sigmaE * gauss) / nSat;
    noisyRel = clamp(noisyRel, float3(0.0), float3(1.0));
    return noisyRel / exposure;
}

static inline float3 comp_apply_camera_sensor(float3 color,
                                              uint globalOutX,
                                              uint globalOutY,
                                              constant ComposeParams& C)
{
    float3 out = clamp(color, 0.0, 1.0);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 3u) ? 4u : ((C.cameraModel == 2u) ? 2u : ((C.cameraModel == 1u) ? 1u : 0u)));
    if (profile == 0u && C.cameraModel == 0u) return out;

    float outW = max(float(max(C.fullInputWidth / max(C.downsample, 1u), 1u)), 1.0);
    float outH = max(float(max(C.fullInputHeight / max(C.downsample, 1u), 1u)), 1.0);
    float2 uv = (float2(float(globalOutX) + 0.5, float(globalOutY) + 0.5) / float2(outW, outH)) - 0.5;
    uv.x *= outW / max(outH, 1.0);
    float r2 = dot(uv, uv);
    float vignetteStrength = max(C.cameraNoiseParams.x, 0.0);
    if (vignetteStrength > 1e-6) {
        float vignette = 1.0 - vignetteStrength * r2 - 0.22 * vignetteStrength * r2 * r2;
        out *= clamp(vignette, 0.62, 1.0);
    }

    float lum = dot(out, float3(0.2126, 0.7152, 0.0722));
    float shot = max(C.cameraShotNoise, 0.0) * sqrt(max(lum, 1e-6));
    float read = max(C.cameraReadNoise, 0.0);
    float sigma = shot + read;
    if (sigma > 1e-8) {
        float common = 0.5 * (comp_hash_signed_u32(globalOutX, globalOutY, 11u)
                            + comp_hash_signed_u32(globalOutX, globalOutY, 37u));
        float3 chroma = float3(
            0.5 * (comp_hash_signed_u32(globalOutX, globalOutY, 17u) + comp_hash_signed_u32(globalOutX, globalOutY, 19u)),
            0.5 * (comp_hash_signed_u32(globalOutX, globalOutY, 59u) + comp_hash_signed_u32(globalOutX, globalOutY, 61u)),
            0.5 * (comp_hash_signed_u32(globalOutX, globalOutY, 101u) + comp_hash_signed_u32(globalOutX, globalOutY, 103u))
        );
        float chromaMix = clamp(C.cameraNoiseParams.y, 0.0, 1.0);
        float rowPattern = comp_hash_signed_u32(globalOutY, 0u, 149u) * max(C.cameraNoiseParams.z, 0.0);
        float3 n = mix(float3(common), chroma, chromaMix) + rowPattern;
        out = clamp(out + sigma * n, 0.0, 1.0);
    }

    return out;
}

static inline float3 comp_apply_camera_scene_response(float3 rgbExp,
                                                      constant ComposeParams& C)
{
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 3u) ? 4u : ((C.cameraModel == 2u) ? 2u : ((C.cameraModel == 1u) ? 1u : 0u)));
    if (profile == 0u) return rgbExp;

    float3 out = comp_mul_rows(max(rgbExp, 0.0), C.cameraSceneR, C.cameraSceneG, C.cameraSceneB);
    out = max(out * max(C.cameraSensorParams.x, 0.0), 0.0);
    float fullWell = max(C.cameraSensorParams.y, 0.0);
    float shoulderMix = clamp(C.cameraSensorParams.z, 0.0, 1.0);
    float blackLevel = max(C.cameraSensorParams.w, 0.0);
    if (!(fullWell > 1e-6) || !(shoulderMix > 1e-6)) {
        out = max(out - blackLevel, 0.0);
        return max(out, 0.0);
    }
    float lum = dot(out, float3(0.2126, 0.7152, 0.0722));
    float shoulder = smoothstep(1.0, fullWell, lum);
    float3 well = fullWell * (1.0 - exp(-out / max(fullWell, 1e-6)));
    out = mix(out, well, shoulderMix * shoulder);
    return max(out - blackLevel, 0.0);
}

static inline float3 comp_apply_human_vision_pipeline(float3 rgbTm)
{
    float3 coneRgb = clamp(rgbTm, 0.0, 1.0);
    float y = dot(coneRgb, float3(0.2126, 0.7152, 0.0722));

    // Human-eye presentation only. This is a display-side observer response:
    // a Naka-Rushton-like photoreceptor compression, RGB-domain mesopic
    // rod/cone blending, ocular-media/macular pigment tinting, Hunt-effect
    // saturation changes, and highlight bleaching. It does not modify
    // transported/source radiance.
    float n = 0.70;
    float sigma = 0.30;
    float yN = pow(max(y, 0.0), n);
    float sN = pow(sigma, n);
    float whiteResp = 1.0 / max(1.0 + sN, 1e-6);
    float receptorY = (yN / max(yN + sN, 1e-6)) / whiteResp;
    float adaptMix = 0.42 * smoothstep(0.004, 0.42, y) * (1.0 - 0.40 * smoothstep(0.76, 1.0, y));
    float yAdapt = mix(y, clamp(receptorY, 0.0, 1.0), adaptMix);
    float3 out = coneRgb * (yAdapt / max(y, 1e-6));
    y = dot(out, float3(0.2126, 0.7152, 0.0722));

    // Scotopic luminance is only an RGB-domain approximation here; the spectral
    // radiance has already been converted to RGB upstream. Keep the Purkinje
    // shift confined to genuinely dim display values: a bright accretion flow
    // should be cone-dominated, while only faint outer flow/stars move toward
    // blue-green low-light perception.
    float photopic = smoothstep(0.022, 0.210, y);
    float yScotopic = dot(out, float3(0.050, 0.730, 0.220));
    float3 rodRgb = yScotopic * float3(0.72, 0.98, 1.08);
    // Apply the Purkinje hue shift without accidentally making dim-adapted
    // vision darker than the ideal display. Dark adaptation increases
    // sensitivity; the rod-domain color is therefore luminance-preserving with
    // a small gain in the mesopic tail.
    float rodY = dot(rodRgb, float3(0.2126, 0.7152, 0.0722));
    rodRgb *= (y / max(rodY, 1e-6)) * (1.0 + 0.16 * (1.0 - photopic));
    out = mix(rodRgb, out, photopic);
    y = dot(out, float3(0.2126, 0.7152, 0.0722));

    float bleach = smoothstep(0.54, 0.96, y);
    float hunt = mix(0.82, 1.08, smoothstep(0.06, 0.42, y));
    float saturation = mix(0.08, 1.00, photopic) * hunt * mix(1.0, 0.42, bleach);
    out = mix(float3(y), out, saturation);

    // Lens/macular pigment attenuates short wavelengths more in bright fields;
    // dim mesopic fields keep a subtle Purkinje blue-green bias.
    float media = smoothstep(0.10, 0.95, y);
    float mesopicBlue = 1.0 - photopic;
    out *= mix(float3(1.0), float3(0.955, 1.010, 1.085), 0.12 * mesopicBlue);
    out *= mix(float3(1.0), float3(1.040, 1.000, 0.875), 0.24 * media);

    float3 bleachedWhite = float3(dot(out, float3(0.2126, 0.7152, 0.0722)));
    out = mix(out, bleachedWhite, 0.38 * bleach);
    return clamp(out, 0.0, 1.0);
}

static inline float3 comp_apply_camera_color_pipeline(float3 rgbTm,
                                                      constant ComposeParams& C)
{
    if (C.cameraModel == 3u) {
        return comp_apply_human_vision_pipeline(rgbTm);
    }
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 2u) ? 2u : ((C.cameraModel == 1u) ? 1u : 0u));
    if (profile == 0u) return rgbTm;

    float3 out = clamp(comp_mul_rows(clamp(rgbTm, 0.0, 1.0), C.cameraDisplayR, C.cameraDisplayG, C.cameraDisplayB), 0.0, 1.0);
    float y = dot(out, float3(0.2126, 0.7152, 0.0722));
    float toeStrength = clamp(C.cameraNoiseParams.w, 0.0, 1.0);
    if (toeStrength > 1e-6) {
        float toe = smoothstep(0.0, 0.18, y);
        out = mix(out * (1.0 - toeStrength), out, toe);
        y = dot(out, float3(0.2126, 0.7152, 0.0722));
    }
    float displayShoulder = clamp(C.cameraColorParams.y, 0.0, 1.0);
    if (displayShoulder > 1e-6) {
        float shoulder = smoothstep(0.72, 1.0, y);
        out = mix(out, out / (1.0 + 0.20 * out), displayShoulder * shoulder);
        y = dot(out, float3(0.2126, 0.7152, 0.0722));
    }
    float saturation = max(C.cameraColorParams.x, 0.0);
    out = mix(float3(y), out, saturation);
    return clamp(out, 0.0, 1.0);
}

static inline float3 comp_flare_bright_pass_scene(float3 sceneLin, constant ComposeParams& C) {
    float exposure = max(C.exposure, 1e-8);
    float3 expColor = sceneLin * exposure;
    float lum = dot(expColor, float3(0.2126, 0.7152, 0.0722));
    const float threshold = 0.90;
    const float knee = 0.22;
    float x = max(lum - threshold, 0.0);
    float soft = (x * x) / max(x + knee, 1e-6);
    float gain = clamp((x + soft) / max(lum, 1e-6), 0.0, 5.0);
    float3 flareExp = expColor * gain;
    // Keep flare energy bounded in exposed space to avoid screen-wide washout.
    float capExp = mix(1.2, 2.0, clamp(C.cameraFlareStrength, 0.0, 1.0));
    flareExp = min(max(flareExp, float3(0.0)), float3(capExp));
    return flareExp / exposure;
}

static inline float comp_psf_wing_strength(uint profile, constant ComposeParams& C) {
    if (profile == 0u || !(C.cameraPsfSigmaPx > 1e-6)) return 0.0;
    float flare = clamp(C.cameraFlareStrength, 0.0, 1.0);
    if (profile == 4u) {
        // Human ocular media produces a weak broad veil around bright sources.
        // Keep it much weaker than cinema flare, but stronger than the old
        // near-invisible eye wing so room-light validation shows a real
        // observer-optics difference from scientific output.
        return clamp(0.016 + 0.030 * C.cameraPsfSigmaPx, 0.0, 0.052);
    }
    float profileBoost = (profile >= 3u) ? 0.018 : ((profile >= 2u) ? 0.012 : 0.004);
    return clamp(profileBoost + 0.010 * C.cameraPsfSigmaPx + 0.050 * flare, 0.0, 0.12);
}

static inline bool comp_eye_caustic_spike_filter_enabled(constant ComposeParams& C)
{
    // Eye/pupil presentation only. Scientific and debug outputs keep the raw
    // ray-sampled radiance, including unresolved high-order caustic samples.
    return (C.cameraModel == 3u) &&
           (C.analysisMode == 0u) &&
           (C.cameraPsfSigmaPx > 1e-6);
}

static inline float3 comp_eye_caustic_spike_filter(float3 center,
                                                   float3 cL,
                                                   float3 cR,
                                                   float3 cD,
                                                   float3 cU,
                                                   float3 cLD,
                                                   float3 cLU,
                                                   float3 cRD,
                                                   float3 cRU,
                                                   constant ComposeParams& C)
{
    if (!comp_eye_caustic_spike_filter_enabled(C)) return center;

    const float3 lumaW = float3(0.2126, 0.7152, 0.0722);
    float centerY = dot(max(center, float3(0.0)), lumaW);
    float3 neighborMean = (cL + cR + cD + cU + cLD + cLU + cRD + cRU) * 0.125;
    float neighborY = dot(max(neighborMean, float3(0.0)), lumaW);

    // Single-ray high-order images can land as isolated pixel-scale impulses.
    // A real eye has a finite pupil and retinal integration area, so suppress
    // only center samples that are much brighter than their immediate field.
    // Coherent arcs/ribbons survive because their neighboring samples are also
    // bright and the ratio gate stays low.
    float exposedY = centerY * max(C.exposure, 1e-30);
    float brightGate = smoothstep(0.18, 1.35, exposedY);
    float ratioGate = smoothstep(2.2, 5.6, centerY / max(neighborY, 1e-30));
    float strength = 0.78 * brightGate * ratioGate;
    if (!(strength > 1e-5)) return center;

    float3 finitePupilAverage = 0.28 * center + 0.72 * neighborMean;
    return max(mix(center, finitePupilAverage, strength), float3(0.0));
}

static inline float3 comp_linear_full_rgb(device const float4* inLinear,
                                          uint srcX,
                                          uint srcY,
                                          constant ComposeParams& C)
{
    uint gidx = srcY * C.fullInputWidth + srcX;
    float4 rgbw = inLinear[gidx];
    if (rgbw.w <= -1.5) return max(rgbw.xyz, 0.0); // background sky sentinel
    if (rgbw.w < 0.0) return float3(0.0);
    if (comp_linear_rgb_is_final_sentinel(rgbw.w)) return max(rgbw.xyz, 0.0);
    float3 rgb = rgbw.xyz;
    if (C.analysisMode == 0u) {
        rgb = comp_apply_linear_cloud_from_raw(rgbw.xyz, clamp(rgbw.w, 0.0, 1.0), C);
    }
    return rgb;
}

static inline float comp_linear_full_depth(device const float4* inLinear,
                                           uint srcX,
                                           uint srcY,
                                           constant ComposeParams& C)
{
    uint gidx = srcY * C.fullInputWidth + srcX;
    return comp_external_depth_from_w(inLinear[gidx].w, C);
}

static inline float3 comp_sample_linear_full_bilinear(device const float4* inLinear,
                                                      float2 pos,
                                                      constant ComposeParams& C)
{
    float fx = clamp(pos.x, 0.0, float(C.fullInputWidth - 1u));
    float fy = clamp(pos.y, 0.0, float(C.fullInputHeight - 1u));
    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, C.fullInputWidth - 1u);
    uint y1 = min(y0 + 1u, C.fullInputHeight - 1u);
    float tx = fx - float(x0);
    float ty = fy - float(y0);

    float3 c00 = comp_linear_full_rgb(inLinear, x0, y0, C);
    float3 c10 = comp_linear_full_rgb(inLinear, x1, y0, C);
    float3 c01 = comp_linear_full_rgb(inLinear, x0, y1, C);
    float3 c11 = comp_linear_full_rgb(inLinear, x1, y1, C);
    return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

static inline float comp_sample_linear_full_depth_bilinear(device const float4* inLinear,
                                                           float2 pos,
                                                           constant ComposeParams& C)
{
    float fx = clamp(pos.x, 0.0, float(C.fullInputWidth - 1u));
    float fy = clamp(pos.y, 0.0, float(C.fullInputHeight - 1u));
    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, C.fullInputWidth - 1u);
    uint y1 = min(y0 + 1u, C.fullInputHeight - 1u);
    float tx = fx - float(x0);
    float ty = fy - float(y0);

    float d00 = comp_linear_full_depth(inLinear, x0, y0, C);
    float d10 = comp_linear_full_depth(inLinear, x1, y0, C);
    float d01 = comp_linear_full_depth(inLinear, x0, y1, C);
    float d11 = comp_linear_full_depth(inLinear, x1, y1, C);
    return mix(mix(d00, d10, tx), mix(d01, d11, tx), ty);
}

static inline float3 comp_sample_linear_dof_full(device const float4* inLinear,
                                                 uint srcX,
                                                 uint srcY,
                                                 float3 center,
                                                 constant ComposeParams& C)
{
    float depth = comp_linear_full_depth(inLinear, srcX, srcY, C);
    float coc = comp_camera_coc_px(depth, C);
    if (!(coc > 0.35)) return center;

    const uint n = 12u;
    float2 pos = float2(float(srcX), float(srcY));
    float3 sum = center * 0.35;
    float wSum = 0.35;
    for (uint i = 0u; i < n; ++i) {
        float2 off = comp_camera_aperture_offset(i, n, coc, C);
        float sampleDepth = comp_sample_linear_full_depth_bilinear(inLinear, pos + off, C);
        float w = comp_camera_dof_depth_weight(depth, sampleDepth);
        sum += w * comp_sample_linear_full_bilinear(inLinear, pos + off, C);
        wSum += w;
    }
    return max(sum / max(wSum, 1e-6), float3(0.0));
}

static inline float3 comp_sample_linear_tile_bilinear(device const float4* inLinear,
                                                      float2 pos,
                                                      constant ComposeParams& C);

// Fraunhofer diffraction spikes of the polygonal iris, gathered in the
// linear domain from bright-passed sources along each spike direction.
//
// Physical basis: each straight blade edge diffracts perpendicular to
// itself, so an N-blade iris produces 2N spikes (N odd) or N doubled spikes
// (N even, opposite edges parallel). The radial envelope of a straight-edge
// diffraction pattern falls as 1/d^2 beyond a core scale d0 that grows with
// the f-number (lobe spacing ~ lambda * N / pitch), and the sinc-lobe
// interference is wavelength-scaled, which produces the characteristic
// chromatic beading along real spikes. The total spike energy is a small
// fraction of the source energy (cameraDiffractionParams.x), conserved by
// normalizing the gather kernel; the approximation versus an exact
// |FT(aperture)|^2 is the parameterized envelope, not the phenomenology.
static inline float3 comp_add_aperture_diffraction(float3 base,
                                                   device const float4* inLinear,
                                                   float2 srcPos,
                                                   bool fullFrame,
                                                   constant ComposeParams& C)
{
    float strength = clamp(C.cameraDiffractionParams.x, 0.0, 0.25);
    if (!(strength > 1e-6)) return base;
    uint spikeCount = uint(clamp(C.cameraDiffractionParams.y, 2.0, 32.0));
    float rot = C.cameraDiffractionParams.z;
    float d0 = clamp(C.cameraDiffractionParams.w, 0.75, 24.0);

    float frameW = fullFrame ? float(max(C.fullInputWidth, 2u) - 1u) : float(max(C.tileWidth, 2u) - 1u);
    float frameH = fullFrame ? float(max(C.fullInputHeight, 2u) - 1u) : float(max(C.tileHeight, 2u) - 1u);
    float dMin = max(1.75, 0.6 * d0);
    float dMax = max(0.46 * min(frameW, frameH), dMin * 4.0);
    // Lobe spacing scales with lambda * f-number; tie the beading period to
    // d0 so stopping down stretches both the core and the rainbow beads.
    float beadFreq = 0.55 / d0;
    const float3 lamRatio = float3(1.0 / 1.114, 1.0, 1.0 / 0.847); // 612/549/465 nm vs green

    constexpr uint K = 9u;
    float3 acc = float3(0.0);
    float wSum = 0.0;
    float logSpan = log(dMax / dMin);
    for (uint sIdx = 0u; sIdx < spikeCount; ++sIdx) {
        float ang = rot + 6.283185307179586 * (float(sIdx) / float(spikeCount));
        float2 dir = float2(cos(ang), sin(ang));
        for (uint k = 0u; k < K; ++k) {
            float t = (float(k) + 0.5) / float(K);
            float d = dMin * exp(logSpan * t);
            // 1/d^2 envelope integrated over log-spaced bins -> weight ~ 1/d,
            // with the d0 core keeping the near field finite.
            float w = d / (d * d + d0 * d0);
            float2 p = srcPos + dir * d;
            float3 s = fullFrame
                ? comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, p, C), C)
                : comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, p, C), C);
            float3 bead = max(1.0 + 0.55 * cos(d * beadFreq * lamRatio), float3(0.0));
            acc += s * (w * bead);
            wSum += w;
        }
    }
    return base + acc * (strength / max(wSum, 1e-6));
}

static inline float3 comp_add_cinematic_flare_full(float3 base,
                                                   device const float4* inLinear,
                                                   float2 srcPos,
                                                   constant ComposeParams& C)
{
    float s = clamp(C.cameraFlareStrength, 0.0, 1.0);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 2u) ? 2u : 0u);
    if (profile < 2u || !(s > 1e-6)) return base;
    // Camera-like lens flare approximation:
    // 1) local sensor bloom, 2) global lens ghosts mirrored around image center,
    // 3) weak aperture starburst, 4) slight chromatic dispersion along ghost axis.
    float2 frame = float2(max(float(C.fullInputWidth - 1u), 1.0), max(float(C.fullInputHeight - 1u), 1.0));
    float2 center = 0.5 * frame;
    float2 v = srcPos - center;
    float vLen = length(v);
    float2 axis = (vLen > 1e-6) ? (v / vLen) : float2(1.0, 0.0);
    float2 tangent = float2(-axis.y, axis.x);
    float rNorm = length(v / max(frame, float2(1.0)));

    const float2 dirX = float2(1.0, 0.0);
    const float2 dirY = float2(0.0, 1.0);
    float rNear = 1.4 + 0.5 * s;
    float3 local = float3(0.0);
    local += comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos + dirX * rNear, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos - dirX * rNear, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos + dirY * rNear, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos - dirY * rNear, C), C);
    local *= 0.25;
    float3 bloom = float3(0.0);
    for (uint j = 0u; j < 3u; ++j) {
        float r = (j == 0u) ? 3.0 : ((j == 1u) ? 7.0 : 13.0);
        float w = (j == 0u) ? 0.50 : ((j == 1u) ? 0.31 : 0.19);
        bloom += w * (1.18 * comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos + dirY * r, C), C)
                    + 1.18 * comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos - dirY * r, C), C)
                    + 0.36 * comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos + dirX * r, C), C)
                    + 0.36 * comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, srcPos - dirX * r, C), C));
    }

    float3 ghosts = float3(0.0);
    for (uint i = 0u; i < 4u; ++i) {
        float k = (i == 0u) ? 0.42 : ((i == 1u) ? 0.68 : ((i == 2u) ? 1.05 : 1.55));
        float w = (i == 0u) ? 0.34 : ((i == 1u) ? 0.26 : ((i == 2u) ? 0.20 : 0.14));
        float3 tint = (i == 0u)
            ? float3(1.00, 0.93, 0.84)
            : ((i == 1u) ? float3(0.85, 0.95, 1.00)
                         : ((i == 2u) ? float3(1.00, 0.90, 0.95)
                                      : float3(0.80, 0.90, 1.00)));
        float dispPx = (0.45 + 0.32 * float(i)) * (0.6 + 0.8 * s);
        float2 samplePos = center - v / max(k, 1e-5);
        samplePos += tangent * ((float(i) - 1.5) * (0.35 + 0.2 * s));
        float3 cMid = comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, samplePos, C), C);
        float3 cRp = comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, samplePos + axis * dispPx, C), C);
        float3 cBm = comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, samplePos - axis * dispPx, C), C);
        float3 cDisp = float3(cRp.x, cMid.y, cBm.z);
        float2 edgeUv = abs((samplePos - center) / max(center, float2(1.0)));
        float edge = max(edgeUv.x, edgeUv.y);
        float vign = clamp(1.0 - edge, 0.0, 1.0);
        vign = vign * vign * (3.0 - 2.0 * vign);
        ghosts += cDisp * tint * (w * vign);
    }

    float2 starPos = center - 1.03 * v;
    float3 starSrc = comp_flare_bright_pass_scene(comp_sample_linear_full_bilinear(inLinear, starPos, C), C);
    float theta = atan2(axis.y, axis.x);
    float apertureSpike = comp_camera_aperture_starburst(theta, C);
    float crossLeak = pow(abs(cos(2.0 * theta + 0.35)), 18.0);
    float starFalloff = exp(-rNorm * (5.5 + 4.0 * s));
    float3 star = starSrc * (0.82 * apertureSpike + 0.18 * crossLeak) * starFalloff * float3(1.0, 0.98, 0.94);

    float3 flare = 0.34 * local + 0.20 * bloom + ghosts + 0.45 * star;
    return base + (0.006 + 0.030 * s) * flare;
}

static inline float3 comp_sample_linear_psf_full(device const float4* inLinear,
                                                 uint srcX,
                                                 uint srcY,
                                                 constant ComposeParams& C)
{
    float3 center = comp_linear_full_rgb(inLinear, srcX, srcY, C);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 3u) ? 4u : ((C.cameraModel == 2u) ? 2u : ((C.cameraModel == 1u) ? 1u : 0u)));

    float sigma = max(C.cameraPsfSigmaPx, 1e-3);
    float inv2s2 = 0.5 / max(sigma * sigma, 1e-6);
    float w0 = 1.0;
    float w1 = exp(-1.0 * inv2s2);
    float w2 = exp(-2.0 * inv2s2);

    uint xL = (srcX > 0u) ? (srcX - 1u) : 0u;
    uint xR = min(srcX + 1u, C.fullInputWidth - 1u);
    uint yD = (srcY > 0u) ? (srcY - 1u) : 0u;
    uint yU = min(srcY + 1u, C.fullInputHeight - 1u);

    float3 cL = comp_linear_full_rgb(inLinear, xL, srcY, C);
    float3 cR = comp_linear_full_rgb(inLinear, xR, srcY, C);
    float3 cD = comp_linear_full_rgb(inLinear, srcX, yD, C);
    float3 cU = comp_linear_full_rgb(inLinear, srcX, yU, C);
    float3 cLD = comp_linear_full_rgb(inLinear, xL, yD, C);
    float3 cLU = comp_linear_full_rgb(inLinear, xL, yU, C);
    float3 cRD = comp_linear_full_rgb(inLinear, xR, yD, C);
    float3 cRU = comp_linear_full_rgb(inLinear, xR, yU, C);
    center = comp_eye_caustic_spike_filter(center, cL, cR, cD, cU, cLD, cLU, cRD, cRU, C);
    center = comp_sample_linear_dof_full(inLinear, srcX, srcY, center, C);
    if (profile == 0u || !(C.cameraPsfSigmaPx > 1e-6)) return center;

    float3 sum = center * w0;
    float wSum = w0;

    sum += (cL + cR + cD + cU) * w1;
    wSum += 4.0 * w1;

    sum += (cLD + cLU + cRD + cRU) * w2;
    wSum += 4.0 * w2;

    float3 out = sum / max(wSum, 1e-8);
    float wing = comp_psf_wing_strength(profile, C);
    if (wing > 1e-6) {
        float rA = 1.8 + 2.2 * sigma;
        float rB = 4.0 + 4.8 * sigma;
        float sx = float(srcX);
        float sy = float(srcY);
        float3 hAXp = comp_sample_linear_full_bilinear(inLinear, float2(sx + rA, sy), C);
        float3 hAXm = comp_sample_linear_full_bilinear(inLinear, float2(sx - rA, sy), C);
        float3 hAYp = comp_sample_linear_full_bilinear(inLinear, float2(sx, sy + rA), C);
        float3 hAYm = comp_sample_linear_full_bilinear(inLinear, float2(sx, sy - rA), C);
        float d = 0.70710678 * rB;
        float3 hBDp = comp_sample_linear_full_bilinear(inLinear, float2(sx + d, sy + d), C);
        float3 hBDm = comp_sample_linear_full_bilinear(inLinear, float2(sx - d, sy + d), C);
        float3 hBCp = comp_sample_linear_full_bilinear(inLinear, float2(sx + d, sy - d), C);
        float3 hBCm = comp_sample_linear_full_bilinear(inLinear, float2(sx - d, sy - d), C);
        if (profile == 4u) {
            // Human-eye veil glare is dominated by bright-source scatter in the
            // ocular media. Keep the core optical blur linear, but make the broad
            // wing additive and bright-pass so dark disk structure is not smeared
            // into an artificial fog layer.
            hAXp = comp_flare_bright_pass_scene(hAXp, C);
            hAXm = comp_flare_bright_pass_scene(hAXm, C);
            hAYp = comp_flare_bright_pass_scene(hAYp, C);
            hAYm = comp_flare_bright_pass_scene(hAYm, C);
            hBDp = comp_flare_bright_pass_scene(hBDp, C);
            hBDm = comp_flare_bright_pass_scene(hBDm, C);
            hBCp = comp_flare_bright_pass_scene(hBCp, C);
            hBCm = comp_flare_bright_pass_scene(hBCm, C);
        }
        float3 haloA = (hAXp + hAXm + hAYp + hAYm) * 0.25;
        float3 haloB = (hBDp + hBDm + hBCp + hBCm) * 0.25;
        float3 halo = 0.68 * haloA + 0.32 * haloB;
        out = (profile == 4u) ? (out + wing * halo) : mix(out, halo, wing);
    }
    out = comp_add_aperture_diffraction(out, inLinear, float2(float(srcX), float(srcY)), true, C);
    return comp_add_cinematic_flare_full(out, inLinear, float2(float(srcX), float(srcY)), C);
}

static inline float3 comp_linear_tile_rgb(device const float4* inLinear,
                                          uint lx,
                                          uint ly,
                                          constant ComposeParams& C)
{
    uint lidx = ly * C.tileWidth + lx;
    float4 rgbw = inLinear[lidx];
    if (rgbw.w <= -1.5) return max(rgbw.xyz, 0.0); // background sky sentinel
    if (rgbw.w < 0.0) return float3(0.0);
    if (comp_linear_rgb_is_final_sentinel(rgbw.w)) return max(rgbw.xyz, 0.0);
    float3 rgb = rgbw.xyz;
    if (C.analysisMode == 0u) {
        rgb = comp_apply_linear_cloud_from_raw(rgbw.xyz, clamp(rgbw.w, 0.0, 1.0), C);
    }
    return rgb;
}

static inline float comp_linear_tile_depth(device const float4* inLinear,
                                           uint lx,
                                           uint ly,
                                           constant ComposeParams& C)
{
    uint lidx = ly * C.tileWidth + lx;
    return comp_external_depth_from_w(inLinear[lidx].w, C);
}

static inline float3 comp_sample_linear_tile_bilinear(device const float4* inLinear,
                                                      float2 pos,
                                                      constant ComposeParams& C)
{
    float fx = clamp(pos.x, 0.0, float(C.tileWidth - 1u));
    float fy = clamp(pos.y, 0.0, float(C.tileHeight - 1u));
    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, C.tileWidth - 1u);
    uint y1 = min(y0 + 1u, C.tileHeight - 1u);
    float tx = fx - float(x0);
    float ty = fy - float(y0);

    float3 c00 = comp_linear_tile_rgb(inLinear, x0, y0, C);
    float3 c10 = comp_linear_tile_rgb(inLinear, x1, y0, C);
    float3 c01 = comp_linear_tile_rgb(inLinear, x0, y1, C);
    float3 c11 = comp_linear_tile_rgb(inLinear, x1, y1, C);
    return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

static inline float comp_sample_linear_tile_depth_bilinear(device const float4* inLinear,
                                                           float2 pos,
                                                           constant ComposeParams& C)
{
    float fx = clamp(pos.x, 0.0, float(C.tileWidth - 1u));
    float fy = clamp(pos.y, 0.0, float(C.tileHeight - 1u));
    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, C.tileWidth - 1u);
    uint y1 = min(y0 + 1u, C.tileHeight - 1u);
    float tx = fx - float(x0);
    float ty = fy - float(y0);

    float d00 = comp_linear_tile_depth(inLinear, x0, y0, C);
    float d10 = comp_linear_tile_depth(inLinear, x1, y0, C);
    float d01 = comp_linear_tile_depth(inLinear, x0, y1, C);
    float d11 = comp_linear_tile_depth(inLinear, x1, y1, C);
    return mix(mix(d00, d10, tx), mix(d01, d11, tx), ty);
}

static inline float3 comp_sample_linear_dof_tile(device const float4* inLinear,
                                                 uint lx,
                                                 uint ly,
                                                 float3 center,
                                                 constant ComposeParams& C)
{
    float depth = comp_linear_tile_depth(inLinear, lx, ly, C);
    float coc = comp_camera_coc_px(depth, C);
    if (!(coc > 0.35)) return center;

    const uint n = 12u;
    float2 pos = float2(float(lx), float(ly));
    float3 sum = center * 0.35;
    float wSum = 0.35;
    for (uint i = 0u; i < n; ++i) {
        float2 off = comp_camera_aperture_offset(i, n, coc, C);
        float sampleDepth = comp_sample_linear_tile_depth_bilinear(inLinear, pos + off, C);
        float w = comp_camera_dof_depth_weight(depth, sampleDepth);
        sum += w * comp_sample_linear_tile_bilinear(inLinear, pos + off, C);
        wSum += w;
    }
    return max(sum / max(wSum, 1e-6), float3(0.0));
}

static inline float3 comp_add_cinematic_flare_tile(float3 base,
                                                   device const float4* inLinear,
                                                   float2 localPos,
                                                   constant ComposeParams& C)
{
    float s = clamp(C.cameraFlareStrength, 0.0, 1.0);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 2u) ? 2u : 0u);
    if (profile < 2u || !(s > 1e-6)) return base;
    float2 frame = float2(max(float(C.tileWidth - 1u), 1.0), max(float(C.tileHeight - 1u), 1.0));
    float2 center = 0.5 * frame;
    float2 v = localPos - center;
    float vLen = length(v);
    float2 axis = (vLen > 1e-6) ? (v / vLen) : float2(1.0, 0.0);
    float2 tangent = float2(-axis.y, axis.x);
    float rNorm = length(v / max(frame, float2(1.0)));

    const float2 dirX = float2(1.0, 0.0);
    const float2 dirY = float2(0.0, 1.0);
    float rNear = 1.4 + 0.5 * s;
    float3 local = float3(0.0);
    local += comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos + dirX * rNear, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos - dirX * rNear, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos + dirY * rNear, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos - dirY * rNear, C), C);
    local *= 0.25;
    float3 bloom = float3(0.0);
    for (uint j = 0u; j < 3u; ++j) {
        float r = (j == 0u) ? 3.0 : ((j == 1u) ? 7.0 : 13.0);
        float w = (j == 0u) ? 0.50 : ((j == 1u) ? 0.31 : 0.19);
        bloom += w * (1.18 * comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos + dirY * r, C), C)
                    + 1.18 * comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos - dirY * r, C), C)
                    + 0.36 * comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos + dirX * r, C), C)
                    + 0.36 * comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, localPos - dirX * r, C), C));
    }

    float3 ghosts = float3(0.0);
    for (uint i = 0u; i < 4u; ++i) {
        float k = (i == 0u) ? 0.42 : ((i == 1u) ? 0.68 : ((i == 2u) ? 1.05 : 1.55));
        float w = (i == 0u) ? 0.34 : ((i == 1u) ? 0.26 : ((i == 2u) ? 0.20 : 0.14));
        float3 tint = (i == 0u)
            ? float3(1.00, 0.93, 0.84)
            : ((i == 1u) ? float3(0.85, 0.95, 1.00)
                         : ((i == 2u) ? float3(1.00, 0.90, 0.95)
                                      : float3(0.80, 0.90, 1.00)));
        float dispPx = (0.45 + 0.32 * float(i)) * (0.6 + 0.8 * s);
        float2 samplePos = center - v / max(k, 1e-5);
        samplePos += tangent * ((float(i) - 1.5) * (0.35 + 0.2 * s));
        float3 cMid = comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, samplePos, C), C);
        float3 cRp = comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, samplePos + axis * dispPx, C), C);
        float3 cBm = comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, samplePos - axis * dispPx, C), C);
        float3 cDisp = float3(cRp.x, cMid.y, cBm.z);
        float2 edgeUv = abs((samplePos - center) / max(center, float2(1.0)));
        float edge = max(edgeUv.x, edgeUv.y);
        float vign = clamp(1.0 - edge, 0.0, 1.0);
        vign = vign * vign * (3.0 - 2.0 * vign);
        ghosts += cDisp * tint * (w * vign);
    }

    float2 starPos = center - 1.03 * v;
    float3 starSrc = comp_flare_bright_pass_scene(comp_sample_linear_tile_bilinear(inLinear, starPos, C), C);
    float theta = atan2(axis.y, axis.x);
    float apertureSpike = comp_camera_aperture_starburst(theta, C);
    float crossLeak = pow(abs(cos(2.0 * theta + 0.35)), 18.0);
    float starFalloff = exp(-rNorm * (5.5 + 4.0 * s));
    float3 star = starSrc * (0.82 * apertureSpike + 0.18 * crossLeak) * starFalloff * float3(1.0, 0.98, 0.94);

    float3 flare = 0.34 * local + 0.20 * bloom + ghosts + 0.45 * star;
    return base + (0.006 + 0.030 * s) * flare;
}

static inline float3 comp_sample_linear_psf_tile(device const float4* inLinear,
                                                 uint lx,
                                                 uint ly,
                                                 constant ComposeParams& C)
{
    float3 center = comp_linear_tile_rgb(inLinear, lx, ly, C);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 3u) ? 4u : ((C.cameraModel == 2u) ? 2u : ((C.cameraModel == 1u) ? 1u : 0u)));

    float sigma = max(C.cameraPsfSigmaPx, 1e-3);
    float inv2s2 = 0.5 / max(sigma * sigma, 1e-6);
    float w0 = 1.0;
    float w1 = exp(-1.0 * inv2s2);
    float w2 = exp(-2.0 * inv2s2);

    uint xL = (lx > 0u) ? (lx - 1u) : 0u;
    uint xR = min(lx + 1u, C.tileWidth - 1u);
    uint yD = (ly > 0u) ? (ly - 1u) : 0u;
    uint yU = min(ly + 1u, C.tileHeight - 1u);

    float3 cL = comp_linear_tile_rgb(inLinear, xL, ly, C);
    float3 cR = comp_linear_tile_rgb(inLinear, xR, ly, C);
    float3 cD = comp_linear_tile_rgb(inLinear, lx, yD, C);
    float3 cU = comp_linear_tile_rgb(inLinear, lx, yU, C);
    float3 cLD = comp_linear_tile_rgb(inLinear, xL, yD, C);
    float3 cLU = comp_linear_tile_rgb(inLinear, xL, yU, C);
    float3 cRD = comp_linear_tile_rgb(inLinear, xR, yD, C);
    float3 cRU = comp_linear_tile_rgb(inLinear, xR, yU, C);
    center = comp_eye_caustic_spike_filter(center, cL, cR, cD, cU, cLD, cLU, cRD, cRU, C);
    center = comp_sample_linear_dof_tile(inLinear, lx, ly, center, C);
    if (profile == 0u || !(C.cameraPsfSigmaPx > 1e-6)) return center;

    float3 sum = center * w0;
    float wSum = w0;

    sum += (cL + cR + cD + cU) * w1;
    wSum += 4.0 * w1;

    sum += (cLD + cLU + cRD + cRU) * w2;
    wSum += 4.0 * w2;

    float3 out = sum / max(wSum, 1e-8);
    float wing = comp_psf_wing_strength(profile, C);
    if (wing > 1e-6) {
        float rA = 1.8 + 2.2 * sigma;
        float rB = 4.0 + 4.8 * sigma;
        float sx = float(lx);
        float sy = float(ly);
        float3 hAXp = comp_sample_linear_tile_bilinear(inLinear, float2(sx + rA, sy), C);
        float3 hAXm = comp_sample_linear_tile_bilinear(inLinear, float2(sx - rA, sy), C);
        float3 hAYp = comp_sample_linear_tile_bilinear(inLinear, float2(sx, sy + rA), C);
        float3 hAYm = comp_sample_linear_tile_bilinear(inLinear, float2(sx, sy - rA), C);
        float d = 0.70710678 * rB;
        float3 hBDp = comp_sample_linear_tile_bilinear(inLinear, float2(sx + d, sy + d), C);
        float3 hBDm = comp_sample_linear_tile_bilinear(inLinear, float2(sx - d, sy + d), C);
        float3 hBCp = comp_sample_linear_tile_bilinear(inLinear, float2(sx + d, sy - d), C);
        float3 hBCm = comp_sample_linear_tile_bilinear(inLinear, float2(sx - d, sy - d), C);
        if (profile == 4u) {
            hAXp = comp_flare_bright_pass_scene(hAXp, C);
            hAXm = comp_flare_bright_pass_scene(hAXm, C);
            hAYp = comp_flare_bright_pass_scene(hAYp, C);
            hAYm = comp_flare_bright_pass_scene(hAYm, C);
            hBDp = comp_flare_bright_pass_scene(hBDp, C);
            hBDm = comp_flare_bright_pass_scene(hBDm, C);
            hBCp = comp_flare_bright_pass_scene(hBCp, C);
            hBCm = comp_flare_bright_pass_scene(hBCm, C);
        }
        float3 haloA = (hAXp + hAXm + hAYp + hAYm) * 0.25;
        float3 haloB = (hBDp + hBDm + hBCp + hBCm) * 0.25;
        float3 halo = 0.68 * haloA + 0.32 * haloB;
        out = (profile == 4u) ? (out + wing * halo) : mix(out, halo, wing);
    }
    out = comp_add_aperture_diffraction(out, inLinear, float2(float(lx), float(ly)), false, C);
    return comp_add_cinematic_flare_tile(out, inLinear, float2(float(lx), float(ly)), C);
}

static inline float3 comp_collision_tile_rgb(device const CollisionInfo* inInfo,
                                             uint lx,
                                             uint ly,
                                             constant Params& P,
                                             constant ComposeParams& C)
{
    uint lidx = ly * C.tileWidth + lx;
    CollisionInfo rec = inInfo[lidx];
    if (rec.hit == 0u) return comp_background_linear(rec.direct_world.xyz, C);
    return comp_linear_rgb(rec, P, C);
}

static inline float3 comp_sample_collision_tile_bilinear(device const CollisionInfo* inInfo,
                                                         float2 pos,
                                                         constant Params& P,
                                                         constant ComposeParams& C)
{
    float fx = clamp(pos.x, 0.0, float(C.tileWidth - 1u));
    float fy = clamp(pos.y, 0.0, float(C.tileHeight - 1u));
    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, C.tileWidth - 1u);
    uint y1 = min(y0 + 1u, C.tileHeight - 1u);
    float tx = fx - float(x0);
    float ty = fy - float(y0);

    float3 c00 = comp_collision_tile_rgb(inInfo, x0, y0, P, C);
    float3 c10 = comp_collision_tile_rgb(inInfo, x1, y0, P, C);
    float3 c01 = comp_collision_tile_rgb(inInfo, x0, y1, P, C);
    float3 c11 = comp_collision_tile_rgb(inInfo, x1, y1, P, C);
    return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

static inline float3 comp_add_cinematic_flare_collision(float3 base,
                                                        device const CollisionInfo* inInfo,
                                                        float2 localPos,
                                                        constant Params& P,
                                                        constant ComposeParams& C)
{
    float s = clamp(C.cameraFlareStrength, 0.0, 1.0);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 2u) ? 2u : 0u);
    if (profile < 2u || !(s > 1e-6)) return base;
    float2 frame = float2(max(float(C.tileWidth - 1u), 1.0), max(float(C.tileHeight - 1u), 1.0));
    float2 center = 0.5 * frame;
    float2 v = localPos - center;
    float vLen = length(v);
    float2 axis = (vLen > 1e-6) ? (v / vLen) : float2(1.0, 0.0);
    float2 tangent = float2(-axis.y, axis.x);
    float rNorm = length(v / max(frame, float2(1.0)));

    const float2 dirX = float2(1.0, 0.0);
    const float2 dirY = float2(0.0, 1.0);
    float rNear = 1.4 + 0.5 * s;
    float3 local = float3(0.0);
    local += comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos + dirX * rNear, P, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos - dirX * rNear, P, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos + dirY * rNear, P, C), C);
    local += comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos - dirY * rNear, P, C), C);
    local *= 0.25;
    float3 bloom = float3(0.0);
    for (uint j = 0u; j < 3u; ++j) {
        float r = (j == 0u) ? 3.0 : ((j == 1u) ? 7.0 : 13.0);
        float w = (j == 0u) ? 0.50 : ((j == 1u) ? 0.31 : 0.19);
        bloom += w * (1.18 * comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos + dirY * r, P, C), C)
                    + 1.18 * comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos - dirY * r, P, C), C)
                    + 0.36 * comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos + dirX * r, P, C), C)
                    + 0.36 * comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, localPos - dirX * r, P, C), C));
    }

    float3 ghosts = float3(0.0);
    for (uint i = 0u; i < 4u; ++i) {
        float k = (i == 0u) ? 0.42 : ((i == 1u) ? 0.68 : ((i == 2u) ? 1.05 : 1.55));
        float w = (i == 0u) ? 0.34 : ((i == 1u) ? 0.26 : ((i == 2u) ? 0.20 : 0.14));
        float3 tint = (i == 0u)
            ? float3(1.00, 0.93, 0.84)
            : ((i == 1u) ? float3(0.85, 0.95, 1.00)
                         : ((i == 2u) ? float3(1.00, 0.90, 0.95)
                                      : float3(0.80, 0.90, 1.00)));
        float dispPx = (0.45 + 0.32 * float(i)) * (0.6 + 0.8 * s);
        float2 samplePos = center - v / max(k, 1e-5);
        samplePos += tangent * ((float(i) - 1.5) * (0.35 + 0.2 * s));
        float3 cMid = comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, samplePos, P, C), C);
        float3 cRp = comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, samplePos + axis * dispPx, P, C), C);
        float3 cBm = comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, samplePos - axis * dispPx, P, C), C);
        float3 cDisp = float3(cRp.x, cMid.y, cBm.z);
        float2 edgeUv = abs((samplePos - center) / max(center, float2(1.0)));
        float edge = max(edgeUv.x, edgeUv.y);
        float vign = clamp(1.0 - edge, 0.0, 1.0);
        vign = vign * vign * (3.0 - 2.0 * vign);
        ghosts += cDisp * tint * (w * vign);
    }

    float2 starPos = center - 1.03 * v;
    float3 starSrc = comp_flare_bright_pass_scene(comp_sample_collision_tile_bilinear(inInfo, starPos, P, C), C);
    float theta = atan2(axis.y, axis.x);
    float apertureSpike = comp_camera_aperture_starburst(theta, C);
    float crossLeak = pow(abs(cos(2.0 * theta + 0.35)), 18.0);
    float starFalloff = exp(-rNorm * (5.5 + 4.0 * s));
    float3 star = starSrc * (0.82 * apertureSpike + 0.18 * crossLeak) * starFalloff * float3(1.0, 0.98, 0.94);

    float3 flare = 0.34 * local + 0.20 * bloom + ghosts + 0.45 * star;
    return base + (0.006 + 0.030 * s) * flare;
}

static inline float3 comp_sample_collision_psf_tile(device const CollisionInfo* inInfo,
                                                    uint lx,
                                                    uint ly,
                                                    constant Params& P,
                                                    constant ComposeParams& C)
{
    float3 center = comp_collision_tile_rgb(inInfo, lx, ly, P, C);
    uint profile = (C.cameraProfile != 0u) ? C.cameraProfile : ((C.cameraModel == 3u) ? 4u : ((C.cameraModel == 2u) ? 2u : ((C.cameraModel == 1u) ? 1u : 0u)));
    if (profile == 0u || !(C.cameraPsfSigmaPx > 1e-6)) return center;

    float sigma = max(C.cameraPsfSigmaPx, 1e-3);
    float inv2s2 = 0.5 / max(sigma * sigma, 1e-6);
    float w0 = 1.0;
    float w1 = exp(-1.0 * inv2s2);
    float w2 = exp(-2.0 * inv2s2);

    uint xL = (lx > 0u) ? (lx - 1u) : 0u;
    uint xR = min(lx + 1u, C.tileWidth - 1u);
    uint yD = (ly > 0u) ? (ly - 1u) : 0u;
    uint yU = min(ly + 1u, C.tileHeight - 1u);

    float3 cL = comp_collision_tile_rgb(inInfo, xL, ly, P, C);
    float3 cR = comp_collision_tile_rgb(inInfo, xR, ly, P, C);
    float3 cD = comp_collision_tile_rgb(inInfo, lx, yD, P, C);
    float3 cU = comp_collision_tile_rgb(inInfo, lx, yU, P, C);
    float3 cLD = comp_collision_tile_rgb(inInfo, xL, yD, P, C);
    float3 cLU = comp_collision_tile_rgb(inInfo, xL, yU, P, C);
    float3 cRD = comp_collision_tile_rgb(inInfo, xR, yD, P, C);
    float3 cRU = comp_collision_tile_rgb(inInfo, xR, yU, P, C);
    center = comp_eye_caustic_spike_filter(center, cL, cR, cD, cU, cLD, cLU, cRD, cRU, C);

    float3 sum = center * w0;
    float wSum = w0;

    sum += (cL + cR + cD + cU) * w1;
    wSum += 4.0 * w1;

    sum += (cLD + cLU + cRD + cRU) * w2;
    wSum += 4.0 * w2;

    float3 out = sum / max(wSum, 1e-8);
    float wing = comp_psf_wing_strength(profile, C);
    if (wing > 1e-6) {
        float rA = 1.8 + 2.2 * sigma;
        float rB = 4.0 + 4.8 * sigma;
        float sx = float(lx);
        float sy = float(ly);
        float3 hAXp = comp_sample_collision_tile_bilinear(inInfo, float2(sx + rA, sy), P, C);
        float3 hAXm = comp_sample_collision_tile_bilinear(inInfo, float2(sx - rA, sy), P, C);
        float3 hAYp = comp_sample_collision_tile_bilinear(inInfo, float2(sx, sy + rA), P, C);
        float3 hAYm = comp_sample_collision_tile_bilinear(inInfo, float2(sx, sy - rA), P, C);
        float d = 0.70710678 * rB;
        float3 hBDp = comp_sample_collision_tile_bilinear(inInfo, float2(sx + d, sy + d), P, C);
        float3 hBDm = comp_sample_collision_tile_bilinear(inInfo, float2(sx - d, sy + d), P, C);
        float3 hBCp = comp_sample_collision_tile_bilinear(inInfo, float2(sx + d, sy - d), P, C);
        float3 hBCm = comp_sample_collision_tile_bilinear(inInfo, float2(sx - d, sy - d), P, C);
        if (profile == 4u) {
            hAXp = comp_flare_bright_pass_scene(hAXp, C);
            hAXm = comp_flare_bright_pass_scene(hAXm, C);
            hAYp = comp_flare_bright_pass_scene(hAYp, C);
            hAYm = comp_flare_bright_pass_scene(hAYm, C);
            hBDp = comp_flare_bright_pass_scene(hBDp, C);
            hBDm = comp_flare_bright_pass_scene(hBDm, C);
            hBCp = comp_flare_bright_pass_scene(hBCp, C);
            hBCm = comp_flare_bright_pass_scene(hBCm, C);
        }
        float3 haloA = (hAXp + hAXm + hAYp + hAYm) * 0.25;
        float3 haloB = (hBDp + hBDm + hBCp + hBCm) * 0.25;
        float3 halo = 0.68 * haloA + 0.32 * haloB;
        out = (profile == 4u) ? (out + wing * halo) : mix(out, halo, wing);
    }
    return comp_add_cinematic_flare_collision(out, inInfo, float2(float(lx), float(ly)), P, C);
}

// Inverse of comp_xyz_to_rgb (linear sRGB / D65).
static inline float3 comp_rgb_to_xyz(float3 rgb) {
    float3 c = max(rgb, 0.0);
    return float3(
        0.4124 * c.x + 0.3576 * c.y + 0.1805 * c.z,
        0.2126 * c.x + 0.7152 * c.y + 0.0722 * c.z,
        0.0193 * c.x + 0.1192 * c.y + 0.9505 * c.z
    );
}

static inline bool comp_eye_physiological_enabled(constant ComposeParams& C) {
    return (C.eyeParams.x > 0.0) && (C.cameraModel == 3u) && (C.analysisMode == 0u);
}

// Physically anchored human-eye display operator.
//
// The input is linear scene radiance after the neutral-density safe-viewing
// filter (the ND attenuation is exactly a linear scale and is carried in
// C.exposure). Absolute luminance L = eyeParams.y * CIE-Y, with eyeParams.y =
// 683.002 * cameraLuminanceScale. The mapping is the established
// physiologically based chain (Ferwerda et al. 1996 visual adaptation;
// Durand & Dorsey 2000 night tone mapping; Larson et al. 1997 scotopic
// luminance from XYZ):
//
//   cones: Naka-Rushton R = L^n / (L^n + sigma^n), n = 0.74, with
//          semi-saturation at the adaptation luminance L_a and display white
//          anchored at eyeParams.z * L_a;
//   rods:  same response on the Larson scotopic luminance estimate
//          V' = Y * (1.33 * (1 + (Y + Z) / X) - 1.68), with rods ~25x more
//          sensitive and saturating above a few cd/m^2;
//   mesopic blend: rod weight 1 below 0.005 cd/m^2, 0 above ~3 cd/m^2
//          (rod-saturation), with the achromatic rod signal carrying the
//          Purkinje blue-gray appearance.
//
// This is the eye as a measurement device; expressive grading stays in the
// cinema path.
static inline float3 comp_eye_physiological_display(float3 rgbExp,
                                                    constant ComposeParams& C)
{
    float3 xyz = comp_rgb_to_xyz(rgbExp);
    float absPerY = max(C.eyeParams.y, 1e-12);
    float La = max(C.eyeParams.x, 1e-6);
    float whiteMul = max(C.eyeParams.z, 1.5);

    float L = absPerY * max(xyz.y, 0.0);
    float scotRatio = 1.33 * (1.0 + (xyz.y + xyz.z) / max(xyz.x, 1e-30)) - 1.68;
    float Vp = absPerY * max(xyz.y * scotRatio, 0.0);

    const float n = 0.74;
    float sigmaC = pow(La, n);
    float Ln = pow(max(L, 0.0), n);
    float Rc = Ln / max(Ln + sigmaC, 1e-20);
    float Lw = whiteMul * La;
    float Rw = pow(Lw, n) / max(pow(Lw, n) + sigmaC, 1e-20);
    float dispC = Rc / max(Rw, 1e-9);

    // Rods adapt with the same pool but are ~25x more sensitive.
    float sigmaR = pow(max(0.04 * La, 1e-6), n);
    float Vn = pow(max(Vp, 0.0), n);
    float Rr = Vn / max(Vn + sigmaR, 1e-20);
    float dispR = Rr / max(Rw, 1e-9);

    // Mesopic regime from absolute photopic luminance: fully scotopic below
    // 0.005 cd/m^2, rods saturated out above ~3 cd/m^2.
    float lgL = log10(max(L, 1e-7));
    float wRod = 1.0 - smoothstep(-2.301, 0.477, lgL);

    float lum = dot(max(rgbExp, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
    float3 chroma = (lum > 1e-30) ? (rgbExp / lum) : float3(1.0);
    // Purkinje blue-gray appearance of the achromatic rod signal,
    // normalized to unit Rec.709 luminance.
    const float3 rodTint = float3(0.7922, 0.9916, 1.6946);
    float3 outLin = mix(chroma * dispC, rodTint * dispR, wRod);
    return precise::pow(clamp(outLin, 0.0, 1.0), float3(1.0 / 2.2));
}

static inline float3 comp_shade(const CollisionInfo rec,
                                constant Params& P,
                                constant ComposeParams& C)
{
    if (rec.hit == 0u) return float3(0.0);
    float3 rgb = comp_linear_rgb(rec, P, C);
    if ((C.realismProfile == 5u || C.realismProfile == 6u) &&
        (C.analysisMode == 34u || C.analysisMode == 35u ||
         C.analysisMode == 36u || C.analysisMode == 38u)) {
        // Absolute canonical source radiance debug: output display-encoded
        // linear clamp. The fixed HDR preview scale is applied when forming the
        // branch debug radiance; avoid tone mapping, which inflates weak
        // isolated branches.
        float3 rgbExp = rgb * max(C.exposure, 1e-30);
        return precise::pow(clamp(rgbExp, 0.0, 1.0), float3(1.0 / 2.2));
    }
    if (C.realismProfile == 5u && (C.analysisMode == 37u || C.analysisMode == 42u)) {
        return clamp(rgb, 0.0, 1.0);
    }
    if (C.realismProfile == 6u &&
        (C.analysisMode == 31u || C.analysisMode == 32u ||
         C.analysisMode == 33u || C.analysisMode == 37u ||
         (C.analysisMode >= 39u && C.analysisMode <= 42u))) {
        return clamp(rgb, 0.0, 1.0);
    }
    bool physicalVolumeDebug = (FC_PHYSICS_MODE == 3u) ||
                               (FC_PHYSICS_MODE == 2u && P.diskVolumeMode != 0u);
    if (physicalVolumeDebug && C.analysisMode == 30u) {
        float lumRaw = dot(max(rgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        if (!(lumRaw > 1e-37)) return float3(0.0);
        return comp_debug_ramp(comp_grmhd_raw_log_debug_t(lumRaw));
    }
    if (physicalVolumeDebug &&
        (C.analysisMode == 65u || C.analysisMode == 66u ||
         C.analysisMode == 67u || C.analysisMode == 68u ||
         C.analysisMode == 69u || C.analysisMode == 70u ||
         C.analysisMode == 71u || C.analysisMode == 72u)) {
        return clamp(rgb, 0.0, 1.0);
    }
    float3 rgbExp = rgb * max(C.exposure, 1e-30);
    if (physicalVolumeDebug && C.analysisMode == 31u) {
        return precise::pow(clamp(rgbExp, 0.0, 1.0), float3(1.0 / 2.2));
    }
    rgbExp = comp_apply_camera_scene_response(rgbExp, C);
    if (comp_eye_physiological_enabled(C)) {
        return comp_eye_physiological_display(rgbExp, C);
    }
    float lum = dot(rgbExp, float3(0.2126, 0.7152, 0.0722));
    float lumTm = comp_tonemap_luma(lum, C.look);
    float scale = lumTm / max(lum, 1e-12);
    float3 rgbTm = rgbExp * scale;
    if (physicalVolumeDebug && C.analysisMode == 32u) {
        return precise::pow(clamp(rgbTm, 0.0, 1.0), float3(1.0 / 2.2));
    }
    rgbTm = comp_apply_highlight_desaturation(rgbTm, lumTm, C.look, C.preserveHighlightColor);
    rgbTm = comp_apply_look(rgbTm, C.look);
    rgbTm = comp_apply_camera_color_pipeline(rgbTm, C);
    float3 srgb = precise::pow(clamp(rgbTm, 0.0, 1.0), float3(1.0 / 2.2));
    return srgb;
}

static inline float3 comp_shade_linear(float3 rgb, constant ComposeParams& C)
{
    bool physicalVolumeDebug = (FC_PHYSICS_MODE == 3u) ||
                               (FC_PHYSICS_MODE == 2u && C.analysisMode != 0u);
    if ((C.realismProfile == 5u || C.realismProfile == 6u) &&
        (C.analysisMode == 34u || C.analysisMode == 35u ||
         C.analysisMode == 36u || C.analysisMode == 38u)) {
        // Absolute canonical source radiance debug: output display-encoded
        // linear clamp. The fixed HDR preview scale is applied when forming the
        // branch debug radiance; avoid tone mapping, which inflates weak
        // isolated branches.
        float3 rgbExp = rgb * max(C.exposure, 1e-30);
        return precise::pow(clamp(rgbExp, 0.0, 1.0), float3(1.0 / 2.2));
    }
    if (C.realismProfile == 5u && (C.analysisMode == 37u || C.analysisMode == 42u)) {
        // Canonical normalized diagnostic maps are already display-domain unit
        // values: RGB={body,skin,corona} ratios or grayscale activity. Do not run
        // exposure, tone mapping, or sRGB gamma here, otherwise PNG channel values
        // no longer match the physical branch diagnostics.
        return clamp(rgb, 0.0, 1.0);
    }
    if (C.realismProfile == 6u &&
        (C.analysisMode == 31u || C.analysisMode == 32u ||
         C.analysisMode == 33u || C.analysisMode == 37u ||
         (C.analysisMode >= 39u && C.analysisMode <= 42u))) {
        // Profile-6 normalized source diagnostics are produced at source level.
        // Keep them out of exposure/tone mapping so metrics correspond to
        // density/temperature/tau/activity fields rather than display response.
        return clamp(rgb, 0.0, 1.0);
    }
    if (physicalVolumeDebug && C.analysisMode == 30u) {
        float lumRaw = dot(max(rgb, float3(0.0)), float3(0.2126, 0.7152, 0.0722));
        if (!(lumRaw > 1e-37)) return float3(0.0);
        return comp_debug_ramp(comp_grmhd_raw_log_debug_t(lumRaw));
    }
    if (physicalVolumeDebug &&
        (C.analysisMode == 65u || C.analysisMode == 66u ||
         C.analysisMode == 67u || C.analysisMode == 68u ||
         C.analysisMode == 69u || C.analysisMode == 70u ||
         C.analysisMode == 71u || C.analysisMode == 72u)) {
        return clamp(rgb, 0.0, 1.0);
    }
    float3 rgbExp = rgb * max(C.exposure, 1e-30);
    if (FC_PHYSICS_MODE == 3u && C.analysisMode == 31u) {
        return precise::pow(clamp(rgbExp, 0.0, 1.0), float3(1.0 / 2.2));
    }
    rgbExp = comp_apply_camera_scene_response(rgbExp, C);
    if (comp_eye_physiological_enabled(C)) {
        return comp_eye_physiological_display(rgbExp, C);
    }
    float lum = dot(rgbExp, float3(0.2126, 0.7152, 0.0722));
    float lumTm = comp_tonemap_luma(lum, C.look);
    float scale = lumTm / max(lum, 1e-12);
    float3 rgbTm = rgbExp * scale;
    if (FC_PHYSICS_MODE == 3u && C.analysisMode == 32u) {
        return precise::pow(clamp(rgbTm, 0.0, 1.0), float3(1.0 / 2.2));
    }
    rgbTm = comp_apply_highlight_desaturation(rgbTm, lumTm, C.look, C.preserveHighlightColor);
    rgbTm = comp_apply_look(rgbTm, C.look);
    rgbTm = comp_apply_camera_color_pipeline(rgbTm, C);
    float3 srgb = precise::pow(clamp(rgbTm, 0.0, 1.0), float3(1.0 / 2.2));
    return srgb;
}

static inline bool comp_eye_local_adaptation_enabled(constant ComposeParams& C)
{
    // Presentation-only retinal/cortical local adaptation. Keep this out of
    // diagnostics and scientific master output; it operates after transport,
    // exposure, tone mapping, and eye color response.
    return (C.cameraModel == 3u) && (C.analysisMode == 0u);
}

static inline float3 comp_eye_local_adaptation_apply(float3 center,
                                                     float3 surround)
{
    const float3 lumaW = float3(0.2126, 0.7152, 0.0722);
    float centerY = dot(clamp(center, 0.0, 1.0), lumaW);
    float surroundY = dot(clamp(surround, 0.0, 1.0), lumaW);

    // A small log-domain gain restores visibility of physically present
    // contrast after global adaptation, without inventing new disk texture.
    float detail = log2(max(centerY, 1e-5)) - log2(max(surroundY, 1e-5));
    float midtoneGate = smoothstep(0.018, 0.28, centerY) * (1.0 - smoothstep(0.72, 0.98, centerY));
    float surroundGate = smoothstep(0.006, 0.20, surroundY);
    float gain = 0.115 * midtoneGate * surroundGate;
    float scale = clamp(exp2(gain * detail), 0.86, 1.16);
    return clamp(center * scale, 0.0, 1.0);
}

static inline float comp_eye_scene_surround_full(device const float4* inLinear,
                                                 uint srcX,
                                                 uint srcY,
                                                 constant ComposeParams& C)
{
    int ix = int(srcX);
    int iy = int(srcY);
    int maxX = int(max(C.fullInputWidth, 1u)) - 1;
    int maxY = int(max(C.fullInputHeight, 1u)) - 1;
    int rNear = max(2, int(max(C.downsample, 1u)) * 3);
    int rFar = max(rNear + 2, int(max(C.downsample, 1u)) * 9);
    const float3 lumaW = float3(0.2126, 0.7152, 0.0722);

    float y = 0.0;
    y += dot(max(comp_linear_full_rgb(inLinear, uint(clamp(ix - rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_full_rgb(inLinear, uint(clamp(ix + rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_full_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy - rNear, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_full_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy + rNear, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_full_rgb(inLinear, uint(clamp(ix - rFar, 0, maxX)), uint(clamp(iy - rFar, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_full_rgb(inLinear, uint(clamp(ix + rFar, 0, maxX)), uint(clamp(iy + rFar, 0, maxY)), C), 0.0), lumaW);
    return y / 6.0;
}

static inline float comp_eye_scene_surround_tile(device const float4* inLinear,
                                                 uint lx,
                                                 uint ly,
                                                 constant ComposeParams& C)
{
    int ix = int(lx);
    int iy = int(ly);
    int maxX = int(max(C.tileWidth, 1u)) - 1;
    int maxY = int(max(C.tileHeight, 1u)) - 1;
    int rNear = max(2, int(max(C.downsample, 1u)) * 3);
    int rFar = max(rNear + 2, int(max(C.downsample, 1u)) * 9);
    const float3 lumaW = float3(0.2126, 0.7152, 0.0722);

    float y = 0.0;
    y += dot(max(comp_linear_tile_rgb(inLinear, uint(clamp(ix - rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_tile_rgb(inLinear, uint(clamp(ix + rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_tile_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy - rNear, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_tile_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy + rNear, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_tile_rgb(inLinear, uint(clamp(ix - rFar, 0, maxX)), uint(clamp(iy - rFar, 0, maxY)), C), 0.0), lumaW);
    y += dot(max(comp_linear_tile_rgb(inLinear, uint(clamp(ix + rFar, 0, maxX)), uint(clamp(iy + rFar, 0, maxY)), C), 0.0), lumaW);
    return y / 6.0;
}

static inline float comp_eye_glare_source_y(float3 sceneRgb,
                                            constant ComposeParams& C)
{
    const float3 lumaW = float3(0.2126, 0.7152, 0.0722);
    return dot(max(comp_flare_bright_pass_scene(sceneRgb, C), 0.0), lumaW);
}

static inline float comp_eye_glare_full_at(device const float4* inLinear,
                                           int ix,
                                           int iy,
                                           int maxX,
                                           int maxY,
                                           constant ComposeParams& C)
{
    return comp_eye_glare_source_y(comp_linear_full_rgb(inLinear,
                                                        uint(clamp(ix, 0, maxX)),
                                                        uint(clamp(iy, 0, maxY)),
                                                        C),
                                   C);
}

static inline float comp_eye_glare_tile_at(device const float4* inLinear,
                                           int ix,
                                           int iy,
                                           int maxX,
                                           int maxY,
                                           constant ComposeParams& C)
{
    return comp_eye_glare_source_y(comp_linear_tile_rgb(inLinear,
                                                        uint(clamp(ix, 0, maxX)),
                                                        uint(clamp(iy, 0, maxY)),
                                                        C),
                                   C);
}

static inline float comp_eye_glare_weight(float radiusPx,
                                          float referenceRadiusPx,
                                          constant ComposeParams& C)
{
    float fallbackPixelDeg = 60.0 / max(float(max(C.fullInputWidth, 1u)), 1.0);
    float pixelDeg = (C.cameraGlareParams.x > 1e-6) ? C.cameraGlareParams.x : fallbackPixelDeg;
    float minTheta = max(C.cameraGlareParams.y, 0.03);
    float falloff = clamp((C.cameraGlareParams.z > 1e-6) ? C.cameraGlareParams.z : 2.0, 1.2, 2.4);
    float theta = max(radiusPx * pixelDeg, minTheta);
    float refTheta = max(referenceRadiusPx * pixelDeg, minTheta);
    return clamp(pow(refTheta / max(theta, 1e-6), falloff), 0.035, 1.0);
}

static inline float comp_eye_scene_glare_full(device const float4* inLinear,
                                              uint srcX,
                                              uint srcY,
                                              constant ComposeParams& C)
{
    int ix = int(srcX);
    int iy = int(srcY);
    int maxX = int(max(C.fullInputWidth, 1u)) - 1;
    int maxY = int(max(C.fullInputHeight, 1u)) - 1;
    int rNear = max(2, int(max(C.downsample, 1u)) * 3);
    int rFar = max(rNear + 2, int(max(C.downsample, 1u)) * 9);
    float nearW = 1.0;
    float nearDiagW = comp_eye_glare_weight(float(rNear) * 1.41421356, float(rNear), C);
    float farW = comp_eye_glare_weight(float(rFar), float(rNear), C);
    float farDiagW = comp_eye_glare_weight(float(rFar) * 1.41421356, float(rNear), C);
    float y = 0.0;
    float yMax = 0.0;

    float s = comp_eye_glare_full_at(inLinear, ix - rNear, iy, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_full_at(inLinear, ix + rNear, iy, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_full_at(inLinear, ix, iy - rNear, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_full_at(inLinear, ix, iy + rNear, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_full_at(inLinear, ix - rNear, iy - rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix + rNear, iy - rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix - rNear, iy + rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix + rNear, iy + rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix - rFar, iy, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_full_at(inLinear, ix + rFar, iy, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_full_at(inLinear, ix, iy - rFar, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_full_at(inLinear, ix, iy + rFar, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_full_at(inLinear, ix - rFar, iy - rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix + rFar, iy - rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix - rFar, iy + rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    s = comp_eye_glare_full_at(inLinear, ix + rFar, iy + rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    float yAvg = y / max(4.0 * nearW + 4.0 * nearDiagW + 4.0 * farW + 4.0 * farDiagW, 1e-6);
    float maxMix = clamp((C.cameraGlareParams.w > 1e-6) ? C.cameraGlareParams.w : 0.55, 0.0, 0.85);
    return max(yAvg, maxMix * yMax);
}

static inline float comp_eye_scene_glare_tile(device const float4* inLinear,
                                              uint lx,
                                              uint ly,
                                              constant ComposeParams& C)
{
    int ix = int(lx);
    int iy = int(ly);
    int maxX = int(max(C.tileWidth, 1u)) - 1;
    int maxY = int(max(C.tileHeight, 1u)) - 1;
    int rNear = max(2, int(max(C.downsample, 1u)) * 3);
    int rFar = max(rNear + 2, int(max(C.downsample, 1u)) * 9);
    float nearW = 1.0;
    float nearDiagW = comp_eye_glare_weight(float(rNear) * 1.41421356, float(rNear), C);
    float farW = comp_eye_glare_weight(float(rFar), float(rNear), C);
    float farDiagW = comp_eye_glare_weight(float(rFar) * 1.41421356, float(rNear), C);
    float y = 0.0;
    float yMax = 0.0;

    float s = comp_eye_glare_tile_at(inLinear, ix - rNear, iy, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_tile_at(inLinear, ix + rNear, iy, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_tile_at(inLinear, ix, iy - rNear, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_tile_at(inLinear, ix, iy + rNear, maxX, maxY, C); y += nearW * s; yMax = max(yMax, nearW * s);
    s = comp_eye_glare_tile_at(inLinear, ix - rNear, iy - rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix + rNear, iy - rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix - rNear, iy + rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix + rNear, iy + rNear, maxX, maxY, C); y += nearDiagW * s; yMax = max(yMax, nearDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix - rFar, iy, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_tile_at(inLinear, ix + rFar, iy, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_tile_at(inLinear, ix, iy - rFar, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_tile_at(inLinear, ix, iy + rFar, maxX, maxY, C); y += farW * s; yMax = max(yMax, farW * s);
    s = comp_eye_glare_tile_at(inLinear, ix - rFar, iy - rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix + rFar, iy - rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix - rFar, iy + rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    s = comp_eye_glare_tile_at(inLinear, ix + rFar, iy + rFar, maxX, maxY, C); y += farDiagW * s; yMax = max(yMax, farDiagW * s);
    float yAvg = y / max(4.0 * nearW + 4.0 * nearDiagW + 4.0 * farW + 4.0 * farDiagW, 1e-6);
    float maxMix = clamp((C.cameraGlareParams.w > 1e-6) ? C.cameraGlareParams.w : 0.55, 0.0, 0.85);
    return max(yAvg, maxMix * yMax);
}

static inline float3 comp_eye_scene_adapt_rgb(float3 rgb,
                                              float surroundY,
                                              float glareY,
                                              constant ComposeParams& C)
{
    // Keep pre-tonemap adaptation conservative. Disability glare is modeled
    // primarily as additive veiling luminance below, not as local darkening
    // around bright sources. Scientific radiance is left unchanged.
    float expY = max(surroundY, 0.0) * max(C.exposure, 1e-30);
    float dimGate = 1.0 - smoothstep(0.025, 0.20, expY);
    float dimGain = clamp(pow(0.11 / max(expY, 1e-5), 0.18), 1.0, 1.35);
    float gain = mix(1.0, dimGain, 0.35 * dimGate);

    // Bright-source glare in the eye is not just reduced gain. Intraocular
    // scatter adds an equivalent veiling luminance to nearby retinal regions,
    // reducing contrast without forming a dark halo. Drive the veil from
    // distance-weighted bright-pass samples so dark local average luminance does
    // not incorrectly remove glare from a nearby lamp.
    float glareExpY = max(glareY, 0.0) * max(C.exposure, 1e-30);
    float veilGate = smoothstep(0.018, 0.42, glareExpY);
    float psf = clamp(C.cameraPsfSigmaPx, 0.0, 1.25);
    float opticsGate = smoothstep(0.02, 0.24, psf);
    float veilExp = (0.012 + 0.045 * psf) * opticsGate * veilGate * clamp(glareExpY, 0.0, 1.65);
    float veilScene = veilExp / max(C.exposure, 1e-30);
    return max(rgb * gain + float3(veilScene), 0.0);
}

static inline float3 comp_eye_surround_full(device const float4* inLinear,
                                            uint srcX,
                                            uint srcY,
                                            constant ComposeParams& C)
{
    int ix = int(srcX);
    int iy = int(srcY);
    int maxX = int(max(C.fullInputWidth, 1u)) - 1;
    int maxY = int(max(C.fullInputHeight, 1u)) - 1;
    int rNear = max(2, int(max(C.downsample, 1u)) * 3);
    int rFar = max(rNear + 2, int(max(C.downsample, 1u)) * 9);

    float3 acc = float3(0.0);
    acc += comp_shade_linear(comp_linear_full_rgb(inLinear, uint(clamp(ix - rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_full_rgb(inLinear, uint(clamp(ix + rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_full_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy - rNear, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_full_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy + rNear, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_full_rgb(inLinear, uint(clamp(ix - rFar, 0, maxX)), uint(clamp(iy - rFar, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_full_rgb(inLinear, uint(clamp(ix + rFar, 0, maxX)), uint(clamp(iy + rFar, 0, maxY)), C), C);
    return acc / 6.0;
}

static inline float3 comp_eye_surround_tile(device const float4* inLinear,
                                            uint lx,
                                            uint ly,
                                            constant ComposeParams& C)
{
    int ix = int(lx);
    int iy = int(ly);
    int maxX = int(max(C.tileWidth, 1u)) - 1;
    int maxY = int(max(C.tileHeight, 1u)) - 1;
    int rNear = max(2, int(max(C.downsample, 1u)) * 3);
    int rFar = max(rNear + 2, int(max(C.downsample, 1u)) * 9);

    float3 acc = float3(0.0);
    acc += comp_shade_linear(comp_linear_tile_rgb(inLinear, uint(clamp(ix - rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_tile_rgb(inLinear, uint(clamp(ix + rNear, 0, maxX)), uint(clamp(iy, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_tile_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy - rNear, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_tile_rgb(inLinear, uint(clamp(ix, 0, maxX)), uint(clamp(iy + rNear, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_tile_rgb(inLinear, uint(clamp(ix - rFar, 0, maxX)), uint(clamp(iy - rFar, 0, maxY)), C), C);
    acc += comp_shade_linear(comp_linear_tile_rgb(inLinear, uint(clamp(ix + rFar, 0, maxX)), uint(clamp(iy + rFar, 0, maxY)), C), C);
    return acc / 6.0;
}
