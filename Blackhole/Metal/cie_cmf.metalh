static inline float3 bh_cie1931_xyz_bar(float lamNm) {
    float t = (lamNm - 380.0) * 0.2; // table index in 5 nm units
    if (!(t > 0.0)) return (t == 0.0) ? BH_CIE1931_CMF_5NM[0] : float3(0.0);
    if (t >= 80.0) return (t == 80.0) ? BH_CIE1931_CMF_5NM[80] : float3(0.0);
    uint i0 = uint(t);
    float f = t - float(i0);
    return mix(BH_CIE1931_CMF_5NM[i0], BH_CIE1931_CMF_5NM[i0 + 1u], f);
}

#endif // BH_CIE_CMF_METALH
